[{"paperId": "26fe2e195d26c7e93865eb637c04f65f2b710b15", "externalIds": {"DOI": "10.4161/cc.26971", "CorpusId": 25670986, "PubMed": "24200969"}, "title": "Activities of multiple cancer-related pathways are associated with BRAF mutation and predict the resistance to BRAF/MEK inhibitors in melanoma cells", "citationCount": 35, "influentialCitationCount": 0, "openAccessPdf": {"url": "https://www.tandfonline.com/doi/pdf/10.4161/cc.26971?needAccess=true&role=button", "status": "BRONZE", "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.4161/cc.26971?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.4161/cc.26971, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "authors": [{"authorId": "4378473", "name": "Ding-Xie Liu"}, {"authorId": "2119149024", "name": "Xuan Liu"}, {"authorId": "1859233", "name": "M. Xing"}], "abstract": null}, {"paperId": "8e3ad50f0e29c4552ae02dedce7112166ff67efa", "externalIds": {"MAG": "2133154786", "PubMedCentral": "4110245", "DOI": "10.1158/2159-8290.CD-13-0440", "CorpusId": 386571, "PubMed": "24469106"}, "title": "Response of BRAF mutant melanoma to BRAF inhibition is mediated by a network of transcriptional regulators of glycolysis", "citationCount": 276, "influentialCitationCount": 11, "openAccessPdf": {"url": "https://www.ncbi.nlm.nih.gov/pmc/articles/4110245", "status": "GREEN", "license": null, "disclaimer": "Notice: Paper or abstract available at https://pmc.ncbi.nlm.nih.gov/articles/PMC4110245, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "authors": [{"authorId": "48800460", "name": "T. Parmenter"}, {"authorId": "46468679", "name": "Margarete Kleinschmidt"}, {"authorId": "7463220", "name": "K. Kinross"}, {"authorId": "39993946", "name": "S. Bond"}, {"authorId": "40004744", "name": "Jason Li"}, {"authorId": "2364170162", "name": "Mohan R. Kaadige"}, {"authorId": "143771153", "name": "A. Rao"}, {"authorId": "2595127", "name": "K. Sheppard"}, {"authorId": "145652460", "name": "W. Hugo"}, {"authorId": "6070672", "name": "Gulietta M. Pupo"}, {"authorId": "144621791", "name": "R. Pearson"}, {"authorId": "2766330", "name": "S. McGee"}, {"authorId": "2616680", "name": "G. Long"}, {"authorId": "4367152", "name": "R. Scolyer"}, {"authorId": "4345349", "name": "H. Rizos"}, {"authorId": "2011679", "name": "Roger S. Lo"}, {"authorId": "2784684", "name": "C. Cullinane"}, {"authorId": "4082499", "name": "D. Ayer"}, {"authorId": "145332493", "name": "A. Ribas"}, {"authorId": "3583027", "name": "R. Johnstone"}, {"authorId": "145823700", "name": "R. Hicks"}, {"authorId": "144371825", "name": "G. McArthur"}], "abstract": "Deregulated glucose metabolism fulfils the energetic and biosynthetic requirements for tumour growth driven by oncogenes. Because inhibition of oncogenic BRAF causes profound reductions in glucose uptake and a strong clinical benefit in BRAF mutant melanoma, we examined the role of energy metabolism in responses to BRAF inhibition. We observed pronounced and consistent decreases in glycolytic activity in BRAF mutant melanoma cells. Moreover, we identified a network of BRAF-regulated transcription factors that control glycolysis in melanoma cells. Remarkably, this network of transcription factors, including HIF1\u03b1, c-Myc and MondoA, drives glycolysis downstream of BRAFV600, is critical for responses to BRAF inhibition and is modulated by BRAF inhibition in clinical melanoma specimens. Furthermore, we show that concurrent inhibition of BRAF and glycolysis induces cell death in BRAF inhibitor-resistant melanoma cells. Thus, we provide a proof of principle for treatment of melanoma with combinations of BRAF inhibitors and glycolysis inhibitors."}, {"paperId": "a0b51f69880197d0ead00856e313c91468e392a6", "externalIds": {"CorpusId": 289674806, "PubMed": "42370653"}, "title": "The Impact of BRAF Mutational Status on Survival in Melanoma Patients: Single Centre Experience.", "citationCount": 0, "influentialCitationCount": 0, "openAccessPdf": {"url": "", "status": null, "license": null}, "authors": [{"authorId": "84023286", "name": "L. Kova\u010d"}, {"authorId": "4295699", "name": "G. \u017dauhar"}, {"authorId": "47857165", "name": "D. Vu\u010dini\u0107"}, {"authorId": "4692673", "name": "I. Had\u017eisejdi\u0107"}, {"authorId": null, "name": "Dora Fu\u010dkar \u010cupi\u0107"}, {"authorId": "2279659", "name": "N. Jonji\u0107"}], "abstract": null}, {"paperId": "3604bffbc01edb61b5a4b45ec1bc62cf4b662a26", "externalIds": {"PubMedCentral": "11103020", "DOI": "10.1016/j.jaccao.2023.12.003", "CorpusId": 267541488, "PubMed": "38774020"}, "title": "The United Kingdom\u2019s First Cardio-Oncology Service", "citationCount": 7, "influentialCitationCount": 0, "openAccessPdf": {"url": "https://doi.org/10.1016/j.jaccao.2023.12.003", "status": "GOLD", "license": "CCBYNCND", "disclaimer": "Notice: Paper or abstract available at https://pmc.ncbi.nlm.nih.gov/articles/PMC11103020, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "authors": [{"authorId": "1665142964", "name": "M. Andres"}, {"authorId": "2279001632", "name": "Theodore Murphy"}, {"authorId": "2254499442", "name": "Nana Poku"}, {"authorId": "16316660", "name": "M. Nazir"}, {"authorId": "152486383", "name": "S. Ramalingam"}, {"authorId": "2283240327", "name": "J. Baksi"}, {"authorId": "2268738618", "name": "Julian W. E. Jarman"}, {"authorId": "4614996", "name": "R. Khattar"}, {"authorId": "2250234898", "name": "Rakesh Sharma"}, {"authorId": "2254321594", "name": "S. Rosen"}, {"authorId": "2249892348", "name": "A. R. Lyon"}], "abstract": null}, {"paperId": "6d478b5f21a2ec88a974605bd5dc5168a19677a1", "externalIds": {"PubMedCentral": "10327874", "DOI": "10.1093/eurheartj/ehac769", "CorpusId": 257034714, "PubMed": "36806928"}, "title": "Histiocytes set on the heart: cardiac complications of Erdheim\u2013Chester disease", "citationCount": 7, "influentialCitationCount": 0, "openAccessPdf": {"url": "https://academic.oup.com/eurheartj/advance-article-pdf/doi/10.1093/eurheartj/ehac769/49254635/ehac769.pdf", "status": "HYBRID", "license": "CCBY", "disclaimer": "Notice: Paper or abstract available at https://pmc.ncbi.nlm.nih.gov/articles/PMC10327874, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "authors": [{"authorId": "2822532", "name": "M. Collin"}], "abstract": "Graphical Abstract Graphical Abstract Sites of cardiac involvement by Erdheim\u2013Chester disease."}, {"paperId": "344c4aa497eaf9a8da4898ceedf9b0dc1637e3b9", "externalIds": {"PubMedCentral": "11795123", "DOI": "10.2340/actadv.v105.41071", "CorpusId": 275930020, "PubMed": "39873164"}, "title": "A 4-year-old Boy with a Red Nodule on His Hand: A Quiz", "citationCount": 0, "influentialCitationCount": 0, "openAccessPdf": {"url": "", "status": null, "license": "CCBYNC", "disclaimer": "Notice: Paper or abstract available at https://pmc.ncbi.nlm.nih.gov/articles/PMC11795123, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "authors": [{"authorId": "115067093", "name": "Rikuto Ishii"}, {"authorId": "2323045431", "name": "Noriyuki Otsuka"}, {"authorId": "2342487377", "name": "T. Anan"}, {"authorId": "2259909676", "name": "Y. Yamamoto"}, {"authorId": "33987913", "name": "Taku Maeda"}], "abstract": null}, null, {"paperId": "abdf06b936bd9d7e12e88ee1b9847ef48a0d78da", "externalIds": {"DOI": "10.21037/tcr-2026-1745", "CorpusId": 292509016, "PubMed": "42870784"}, "title": "Multi-cohort validation of BRAF-PTPRT co-mutation as a predictor of favorable immunotherapy response in melanoma.", "citationCount": 0, "influentialCitationCount": 0, "openAccessPdf": {"url": "https://doi.org/10.21037/tcr-2026-1745", "status": "GOLD", "license": "CCBYNCND", "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.21037/tcr-2026-1745?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.21037/tcr-2026-1745, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "authors": [{"authorId": "2285236599", "name": "Dong-Mei Han"}, {"authorId": "2284529823", "name": "Cai-Hong Wu"}, {"authorId": "2470994665", "name": "Dan Wang"}, {"authorId": "2369310851", "name": "Hao Jin"}, {"authorId": "2506237373", "name": "Wei-Shuai Liu"}], "abstract": "Background\nImmune checkpoint blockade (ICB) has transformed melanoma therapy, but predictive biomarkers remain suboptimal. BRAF is the most common driver mutation, yet its single-gene association with ICB response remains inconsistent. PTPRT loss activates STAT3-driven immunity. We hypothesized that concurrent BRAF and PTPRT mutations (co-mutation) synergistically enhance immunogenicity and predict ICB benefit.\n\n\nMethods\nWe analyzed three independent cohorts: Memorial Sloan Kettering Cancer Center (MSK) (n=320, ICB-treated), The Cancer Genome Atlas (TCGA) (n=448, mixed treatments), and a combined ICB cohort (CS, n=436). Patients were categorized into four groups: co-mutation, BRAF+/PTPRT-, BRAF-/PTPRT+, double wild-type (WT). Overall survival (OS), tumor mutational burden (TMB), neo-antigen load, clinical benefit, immune infiltration, and transcriptomic pathways were evaluated. A simplified risk score (0-2) was constructed by assigning 1 point for co-mutation and 1 point for high TMB (above median) to predict clinical benefit.\n\n\nResults\nIn ICB-treated cohorts (MSK and CS), only co-mutation consistently predicted superior OS, while single mutations showed no consistent benefit. Co-mutated tumors exhibited significantly higher TMB and neo-antigen loads, an immune-inflamed microenvironment with elevated M1 macrophages, reduced Tregs, and upregulation of programmed death-ligand 1 (PD-L1), CTLA-4, TIM-3, as well as enrichment of IFN-\u03b3 and IL6-JAK-STAT3 pathways. The combined risk score (co-mutation\u202f+\u202fTMB) predicted clinical benefit with an area under the curve (AUC) of 0.659. Patients with high-risk score (2 points) demonstrated significantly higher clinical benefit rates compared to low-risk score (0 points).\n\n\nConclusions\nBRAF-PTPRT co-mutation is a robust, cross-cohort predictive biomarker for ICB response in melanoma. A simple risk score integrating co-mutation and TMB further improves patient stratification. Routine testing of both genes may guide immunotherapy decisions."}, {"paperId": "03f72b5c7650177c35d92866979e07af77d43eb0", "externalIds": {"DOI": "10.1111/1346-8138.70534", "CorpusId": 292898913, "PubMed": "42869554"}, "title": "Acral Melanoma Developing at the Site of a Regressed Nevus-Like Lesion.", "citationCount": 0, "influentialCitationCount": 0, "openAccessPdf": {"url": "", "status": "CLOSED", "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://api.unpaywall.org/v2/10.1111/1346-8138.70534?email=<INSERT_YOUR_EMAIL> or https://doi.org/10.1111/1346-8138.70534, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."}, "authors": [{"authorId": "2422671895", "name": "Tatsuro Ogiso"}, {"authorId": "5866830", "name": "Y. Kiniwa"}, {"authorId": "12350024", "name": "A. Mikoshiba"}, {"authorId": "50541390", "name": "Shiho Shirota"}, {"authorId": "2389214774", "name": "Ryuhei Okuyama"}], "abstract": null}]
