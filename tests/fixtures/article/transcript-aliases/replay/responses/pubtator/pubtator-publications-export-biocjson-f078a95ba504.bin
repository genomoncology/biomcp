cies_ids": [9606], "species_id": 9606, "rsids": [], "normalized": ["#672#c.4065_4065del", "#672#"], "normalized_id": "#672#c.4065_4065del", "biotype": "variant", "name": "c.4065_4065del", "accession": "@VARIANT_c.4065_4065del_BRCA1_human"}, "text": "c.4065_4065del", "locations": [{"offset": 12565, "length": 14}]}, {"id": "5253", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "tumor", "locations": [{"offset": 13196, "length": 5}]}, {"id": "5254", "infons": {"identifier": "tmVar:c|SUB|C|367|T;HGVS:c.367C>T;VariantGroup:0;CorrespondingGene:672;RS#:80357325(Expired);CorrespondingSpecies:9606;CA#:3229", "type": "Variant", "valid": true, "subtype": "DNAMutation", "database": "litvar", "hgvs": "c.367C>T", "gene_ids": [672], "gene_id": 672, "rsids": ["rs80357325"], "expired": true, "species_ids": [9606], "species_id": 9606, "clingen_id": "CA3229", "rsid": "rs80357325", "normalized": ["rs80357325##", "#672#", "CA3229#rs80357325##"], "normalized_id": "rs80357325##", "biotype": "variant", "name": "c.367C>T", "accession": "@VARIANT_c.367C>A_BRCA1_human"}, "text": "c.367C > T", "locations": [{"offset": 12892, "length": 10}]}, {"id": "5255", "infons": {"identifier": "tmVar:c|SUB|C|10150|T;HGVS:c.10150C>T;VariantGroup:16;RS#:397507568(Expired);CA#:10347", "type": "Variant", "valid": true, "subtype": "DNAMutation", "database": "litvar", "hgvs": "c.10150C>T", "rsids": ["rs397507568"], "expired": true, "clingen_id": "CA10347", "rsid": "rs397507568", "normalized": ["rs397507568##", "CA10347#rs397507568##"], "normalized_id": "rs397507568##", "biotype": "variant", "name": "c.10150C>T", "gene_id": 675, "accession": "@VARIANT_p.R3384X_BRCA2_human"}, "text": "c.10150C > T", "locations": [{"offset": 12280, "length": 12}]}], "relations": []}, {"infons": {"section_type": "RESULTS", "type": "paragraph"}, "offset": 13474, "text": "Somatic BRCA PSVs were present in 15 out of 88 subjects who had available test results (17.0, 95% CI, 9.9 to 26.6%). The individual prevalence of BRCA1 and BRCA2 somatic PSVs among those with test results was 11.2% (95% CI, 4.7 to 17.8%) and 9.1% (95% CI, 3.1 to 15.1%), respectively (Fig. 1). Among all 15 patients with the somatic PSVs, five patients were tested for germline PSVs. Among this group, 3 (60%) had positive germline PSVs. The list of PSVs position as per Gene Report is shown in Table 2.", "sentences": [], "annotations": [{"id": "5256", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA", "locations": [{"offset": 13482, "length": 4}]}, {"id": "5257", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 13620, "length": 5}]}, {"id": "5258", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 13630, "length": 5}]}, {"id": "5259", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 13781, "length": 8}]}, {"id": "5260", "infons": {"identifier": "-", "type": "Chemical", "valid": false, "normalized_id": null, "biotype": "chemical"}, "text": "PSVs", "locations": [{"offset": 13852, "length": 4}]}, {"id": "5261", "infons": {"identifier": "-", "type": "Chemical", "valid": false, "normalized_id": null, "biotype": "chemical"}, "text": "PSVs", "locations": [{"offset": 13906, "length": 4}]}, {"id": "5262", "infons": {"identifier": "-", "type": "Chemical", "valid": false, "normalized_id": null, "biotype": "chemical"}, "text": "PSVs", "locations": [{"offset": 13487, "length": 4}]}, {"id": "5263", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 13818, "length": 8}]}, {"id": "5264", "infons": {"identifier": "-", "type": "Chemical", "valid": false, "normalized_id": null, "biotype": "chemical"}, "text": "PSVs", "locations": [{"offset": 13807, "length": 4}]}, {"id": "5265", "infons": {"identifier": "-", "type": "Chemical", "valid": false, "normalized_id": null, "biotype": "chemical"}, "text": "PSVs", "locations": [{"offset": 13644, "length": 4}]}, {"id": "5266", "infons": {"identifier": "-", "type": "Chemical", "valid": false, "normalized_id": null, "biotype": "chemical"}, "text": "PSVs", "locations": [{"offset": 13924, "length": 4}]}], "relations": []}, {"infons": {"section_type": "TABLE", "file": "Tab3.xml", "id": "Tab3", "type": "table_caption"}, "offset": 13980, "text": "Clinical and Histological Characteristics for those with and without somatic BRCA1 or BRCA2 PSVs", "sentences": [], "annotations": [{"id": "5267", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 14057, "length": 5}]}, {"id": "5268", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"