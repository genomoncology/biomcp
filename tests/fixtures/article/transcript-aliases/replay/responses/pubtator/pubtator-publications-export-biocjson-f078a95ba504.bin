{"PubTator3": [{"_id": "34930165|PMC8690897", "id": "8690897", "infons": {}, "passages": [{"infons": {"name_3": "surname:Ashour;given-names:Mohamed", "name_2": "surname:Dawoud;given-names:Emad", "name_1": "surname:Abdou;given-names:Ehab", "name_0": "surname:Azribi;given-names:Fathi", "year": "2021", "article-id_publisher-id": "9094", "article-id_doi": "10.1186/s12885-021-09094-8", "title": "Keywords", "type": "front", "elocation-id": "1350", "volume": "21", "license": "Open AccessThis article is licensed under a Creative Commons Attribution 4.0 International License, which permits use, sharing, adaptation, distribution and reproduction in any medium or format, as long as you give appropriate credit to the original author(s) and the source, provide a link to the Creative Commons licence, and indicate if changes were made. The images or other third party material in this article are included in the article's Creative Commons licence, unless indicated otherwise in a credit line to the material. If material is not included in the article's Creative Commons licence and your intended use is not permitted by statutory regulation or exceeds the permitted use, you will need to obtain permission directly from the copyright holder. To view a copy of this licence, visit http://creativecommons.org/licenses/by/4.0/. The Creative Commons Public Domain Dedication waiver (http://creativecommons.org/publicdomain/zero/1.0/) applies to the data made available in this article, unless otherwise stated in a credit line to the data.", "section_type": "TITLE", "kwd": "Gynaecological oncology Cancer genetics Epidemiology", "name_6": "surname:Burney;given-names:Ikram", "name_5": "surname:Al Sayed;given-names:Mohamed", "name_4": "surname:Kamal;given-names:Amgad", "article-id_pmc": "8690897", "article-id_pmid": "34930165"}, "offset": 0, "text": "Prevalence of BRCA1 and BRCA2 pathogenic sequence variants in ovarian cancer patients in the Gulf region: the PREDICT study", "sentences": [], "annotations": [{"id": "5030", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 14, "length": 5}]}, {"id": "5031", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 24, "length": 5}]}, {"id": "5032", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 77, "length": 8}]}, {"id": "5033", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "ovarian cancer", "locations": [{"offset": 62, "length": 14}]}], "relations": []}, {"infons": {"section_type": "ABSTRACT", "type": "abstract_title_1"}, "offset": 124, "text": "Background", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "ABSTRACT", "type": "abstract"}, "offset": 135, "text": "Patients with pathogenic sequence variants (PSVs) in BRCA1/BRCA2 are at high risk of developing ovarian cancer (OC). However, genetic testing for BRCA1/BRCA2 PSVs is still not a routine practice in the Middle East. With the lack of epidemiological studies in the region, we aim to describe the prevalence of BRCA1/BRCA2 PSVs in patients with OC across different countries in the Gulf region.", "sentences": [], "annotations": [{"id": "5034", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 188, "length": 5}]}, {"id": "5035", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 194, "length": 5}]}, {"id": "5036", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 281, "length": 5}]}, {"id": "5037", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 287, "length": 5}]}, {"id": "5038", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 443, "length": 5}]}, {"id": "5039", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 449, "length": 5}]}, {"id": "5040", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "ovarian cancer", "locations": [{"offset": 231, "length": 14}]}, {"id": "5041", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "OC", "locations": [{"offset": 477, "length": 2}]}, {"id": "5042", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "OC", "locations": [{"offset": 247, "length": 2}]}, {"id": "5043", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "Patients", "locations": [{"offset": 135, "length": 8}]}, {"id": "5044", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 463, "length": 8}]}], "relations": []}, {"infons": {"section_type": "ABSTRACT", "type": "abstract_title_1"}, "offset": 527, "text": "Methods", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "ABSTRACT", "type": "abstract"}, "offset": 535, "text": "The PREDICT study was an observational, prospective, epidemiological study, which consecutively recruited women with ovarian, primary peritoneal, and fallopian tube cancers from the following Gulf countries over the period from July 2017 to July 2019; United Arab Emirates (UAE), Kuwait, and Oman. The study was approved by the local ethics committee of participating centers. The BRCA1/BRCA2 PSVs were assessed by tissue genetic testing using next-generation sequencing (NGS).", "sentences": [], "annotations": [{"id": "5045", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 916, "length": 5}]}, {"id": "5046", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 922, "length": 5}]}, {"id": "5047", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "women", "locations": [{"offset": 641, "length": 5}]}, {"id": "5048", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "ovarian, primary peritoneal, and fallopian tube cancers", "locations": [{"offset": 652, "length": 55}]}], "relations": []}, {"infons": {"section_type": "ABSTRACT", "type": "abstract_title_1"}, "offset": 1013, "text": "Results", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "ABSTRACT", "type": "abstract"}, "offset": 1021, "text": "A total of 105 women were included with a median age at diagnosis of 52 years (IQR 44.5 - 61.0). Nearly 11.4% of patients reported a family history of ovarian or breast cancer, while 4.7% of patients reported a family history of other cancers. Most of the patients (70.3%) had advanced disease (FIGO stage III/IV) at presentation. Eighty-eight patients (84%) were successfully tested for somatic BRCA1/BRCA2 PSVs. Fifteen patients (17%) were found to have PSVs in either BRCA1, BRCA2, or both genes; of them, 10 patients (11.2%) had BRCA1 somatic PSVs alone, eight patients (9.1%) had BRCA2 somatic PSVs, while three patients (2.9%) had both PSVs. Five patients with BRCA1/BRCA2 somatic PSVs had germline PSVs tests, and three of them tested positive. Concerning treatment, 87.6% of patients received perioperative chemotherapy and 6.6% as first-line palliative chemotherapy. Eighty-seven (82.9%) patients underwent debulking surgery, with no residual disease in 42.5% of patients.", "sentences": [], "annotations": [{"id": "5049", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 1417, "length": 5}]}, {"id": "5050", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 1423, "length": 5}]}, {"id": "5051", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 1492, "length": 5}]}, {"id": "5052", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 1499, "length": 5}]}, {"id": "5053", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 1554, "length": 5}]}, {"id": "5054", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 1606, "length": 5}]}, {"id": "5055", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 1688, "length": 5}]}, {"id": "5056", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 1694, "length": 5}]}, {"id": "5057", "infons": {"identifier": "MESH:C537189", "type": "Disease", "valid": true, "normalized": ["C537189"], "database": "ncbi_mesh", "normalized_id": "C537189", "biotype": "disease", "name": "Rufous oculocutaneous albinism", "accession": "@DISEASE_Rufous_oculocutaneous_albinism"}, "text": "III", "locations": [{"offset": 1327, "length": 3}]}, {"id": "5058", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 1804, "length": 8}]}, {"id": "5059", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 1134, "length": 8}]}, {"id": "5060", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 1918, "length": 8}]}, {"id": "5061", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 1586, "length": 8}]}, {"id": "5062", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 1533, "length": 8}]}, {"id": "5063", "infons": {"identifier": "MESH:D061325", "type": "Disease", "valid": true, "normalized": ["D061325"], "database": "ncbi_mesh", "normalized_id": "D061325", "biotype": "disease", "name": "Hereditary Breast and Ovarian Cancer Syndrome", "accession": "@DISEASE_Hereditary_Breast_and_Ovarian_Cancer_Syndrome"}, "text": "ovarian or breast cancer", "locations": [{"offset": 1172, "length": 24}]}, {"id": "5064", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 1993, "length": 8}]}, {"id": "5065", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 1212, "length": 8}]}, {"id": "5066", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 1638, "length": 8}]}, {"id": "5067", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 1365, "length": 8}]}, {"id": "5068", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 1277, "length": 8}]}, {"id": "5069", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 1674, "length": 8}]}, {"id": "5070", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "cancers", "locations": [{"offset": 1256, "length": 7}]}, {"id": "5071", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "women", "locations": [{"offset": 1036, "length": 5}]}, {"id": "5072", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 1443, "length": 8}]}, {"id": "5073", "infons": {"type": "Disease", "valid": false, "normalized_id": null, "biotype": "disease"}, "text": "FIGO", "locations": [{"offset": 1316, "length": 4}]}], "relations": []}, {"infons": {"section_type": "ABSTRACT", "type": "abstract_title_1"}, "offset": 2007, "text": "Conclusion", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "ABSTRACT", "type": "abstract"}, "offset": 2018, "text": "Our study showed that the prevalence of BRCA1/BRCA2 somatic PSVs in patients with OC is higher than the reported global figures (2-8%). However, more studies are warranted to further elucidate the prevalence of BRCA1/BRCA2 somatic and germline PSVs, as well as other relevant genetic alterations, to better understand their impact on OC patient outcomes in Gulf countries.", "sentences": [], "annotations": [{"id": "5074", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 2058, "length": 5}]}, {"id": "5075", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 2064, "length": 5}]}, {"id": "5076", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 2229, "length": 5}]}, {"id": "5077", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 2235, "length": 5}]}, {"id": "5078", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "OC", "locations": [{"offset": 2100, "length": 2}]}, {"id": "5079", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "OC", "locations": [{"offset": 2352, "length": 2}]}, {"id": "5080", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patient", "locations": [{"offset": 2355, "length": 7}]}, {"id": "5081", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 2086, "length": 8}]}], "relations": []}, {"infons": {"section_type": "ABSTRACT", "type": "abstract_title_1"}, "offset": 2391, "text": "Trial registration", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "ABSTRACT", "type": "abstract"}, "offset": 2410, "text": "NCT03082976.", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "ABSTRACT", "type": "abstract_title_1"}, "offset": 2423, "text": "Supplementary Information", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "ABSTRACT", "type": "abstract"}, "offset": 2449, "text": "The online version contains supplementary material available at 10.1186/s12885-021-09094-8.", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "INTRO", "type": "title_1"}, "offset": 2541, "text": "Introduction", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "INTRO", "type": "paragraph"}, "offset": 2554, "text": "Ovarian cancer is considered to be the eighth most common cancer among females and the eighth cause of death from cancer in women, with a high mortality rate (62.5%) and one of the worst prognoses among gynecologic cancers. Approximately 75% of women at diagnosis presented with advanced disease status, which account for the poor prognosis of the disease. In the Middle East, women with gynecological cancers tend to seek medical advice very late in the course of their disease due to several factors, including stigma and the lack of awareness about reproductive health. Several risk factors are incorporated in the development of ovarian cancer, such as family history, indicating the involvement of a genetic component in the development of this disease. Accordingly, knowledge of the genetic susceptibility to ovarian cancer can be useful in prevention efforts.", "sentences": [], "annotations": [{"id": "5082", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "gynecological cancers", "locations": [{"offset": 2942, "length": 21}]}, {"id": "5083", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "gynecologic cancers", "locations": [{"offset": 2757, "length": 19}]}, {"id": "5084", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "women", "locations": [{"offset": 2931, "length": 5}]}, {"id": "5085", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "ovarian cancer", "locations": [{"offset": 3369, "length": 14}]}, {"id": "5086", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "women", "locations": [{"offset": 2799, "length": 5}]}, {"id": "5087", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "ovarian cancer", "locations": [{"offset": 3187, "length": 14}]}, {"id": "5088", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "Ovarian cancer", "locations": [{"offset": 2554, "length": 14}]}, {"id": "5089", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "women", "locations": [{"offset": 2678, "length": 5}]}, {"id": "5090", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "cancer", "locations": [{"offset": 2612, "length": 6}]}, {"id": "5091", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "cancer", "locations": [{"offset": 2668, "length": 6}]}], "relations": []}, {"infons": {"section_type": "INTRO", "type": "paragraph"}, "offset": 3421, "text": "An important factor that contributes to ovarian cancer susceptibility is mainly represented in BRCA1 and BRCA2 genes that are associated with different risks of developing breast and ovarian cancers. Carriers of inherited pathogenic sequence variants (PSVs) in BRCA1 and BRCA2 are at an increased lifetime risk of developing ovarian cancer; recent reports highlighted that the cumulative risk of ovarian cancer to age 80 years was 44% for BRCA1 carriers and 17% (95% CI, 11-25%) for BRCA2 carriers. The prevalence of BRCA1 and BRCA2 PSVs vary worldwide depending on several factors, including the type of cancer and ethnic groups. Germline BRCA1 and BRCA2 PSVs may be prevalent in up to 20% of epithelial ovarian cancer. Somatic PSVs occur less frequently in BRCA1 and BRCA2 PSVs, with an estimated prevalence of 2 and 8%, respectively. .There is a scarcity of data in the Middle East about the proportion of ovarian cancer patients carrying these PSVs, and genetic testing is often not part of routine practice, despite its potential for personalized medical treatment.", "sentences": [], "annotations": [{"id": "5092", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 3516, "length": 5}]}, {"id": "5093", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 3526, "length": 5}]}, {"id": "5094", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 3682, "length": 5}]}, {"id": "5095", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 3692, "length": 5}]}, {"id": "5096", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 3860, "length": 5}]}, {"id": "5097", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 3904, "length": 5}]}, {"id": "5098", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 3938, "length": 5}]}, {"id": "5099", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 3948, "length": 5}]}, {"id": "5100", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 4061, "length": 5}]}, {"id": "5101", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 4071, "length": 5}]}, {"id": "5102", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 4180, "length": 5}]}, {"id": "5103", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 4190, "length": 5}]}, {"id": "5104", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "ovarian cancer", "locations": [{"offset": 3746, "length": 14}]}, {"id": "5105", "infons": {"identifier": "MESH:D000077216", "type": "Disease", "valid": true, "normalized": ["D000077216"], "database": "ncbi_mesh", "normalized_id": "D000077216", "biotype": "disease", "name": "Carcinoma Ovarian Epithelial", "accession": "@DISEASE_Carcinoma_Ovarian_Epithelial"}, "text": "epithelial ovarian cancer", "locations": [{"offset": 4115, "length": 25}]}, {"id": "5106", "infons": {"identifier": "MESH:D061325", "type": "Disease", "valid": true, "normalized": ["D061325"], "database": "ncbi_mesh", "normalized_id": "D061325", "biotype": "disease", "name": "Hereditary Breast and Ovarian Cancer Syndrome", "accession": "@DISEASE_Hereditary_Breast_and_Ovarian_Cancer_Syndrome"}, "text": "breast and ovarian cancers", "locations": [{"offset": 3593, "length": 26}]}, {"id": "5107", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "ovarian cancer", "locations": [{"offset": 3817, "length": 14}]}, {"id": "5108", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 4345, "length": 8}]}, {"id": "5109", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "ovarian cancer", "locations": [{"offset": 3461, "length": 14}]}, {"id": "5110", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "cancer", "locations": [{"offset": 4026, "length": 6}]}, {"id": "5111", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "ovarian cancer", "locations": [{"offset": 4330, "length": 14}]}], "relations": []}, {"infons": {"section_type": "INTRO", "type": "paragraph"}, "offset": 4494, "text": "This study estimated the prevalence of BRCA1 and BRCA2 PSVs among female patients >=18 years of age that are diagnosed with ovarian cancer, peritoneal cancer, and fallopian tube cancer in the Gulf region, with the aim of informing clinical practice and improving clinical treatments in the future. It also describes the demographics and clinical characteristics of patients with ovarian cancer.", "sentences": [], "annotations": [{"id": "5112", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 4533, "length": 5}]}, {"id": "5113", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 4543, "length": 5}]}, {"id": "5114", "infons": {"identifier": "MESH:D005185", "type": "Disease", "valid": true, "normalized": ["D005185"], "database": "ncbi_mesh", "normalized_id": "D005185", "biotype": "disease", "name": "Fallopian Tube Neoplasms", "accession": "@DISEASE_Fallopian_Tube_Neoplasms"}, "text": "fallopian tube cancer", "locations": [{"offset": 4657, "length": 21}]}, {"id": "5115", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 4567, "length": 8}]}, {"id": "5116", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 4859, "length": 8}]}, {"id": "5117", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "ovarian cancer", "locations": [{"offset": 4618, "length": 14}]}, {"id": "5118", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "ovarian cancer", "locations": [{"offset": 4873, "length": 14}]}, {"id": "5119", "infons": {"identifier": "MESH:D010534", "type": "Disease", "valid": true, "normalized": ["D010534"], "database": "ncbi_mesh", "normalized_id": "D010534", "biotype": "disease", "name": "Peritoneal Neoplasms", "accession": "@DISEASE_Peritoneal_Neoplasms"}, "text": "peritoneal cancer", "locations": [{"offset": 4634, "length": 17}]}], "relations": []}, {"infons": {"section_type": "METHODS", "type": "title_1"}, "offset": 4892, "text": "Methods", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "METHODS", "type": "paragraph"}, "offset": 4900, "text": "We followed STROBE guidelines for cross-sectional study during the preparation of the present manuscript. The study was approved by the local ethics committee of participating centers.", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "METHODS", "type": "title_2"}, "offset": 5085, "text": "Study design", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "METHODS", "type": "paragraph"}, "offset": 5098, "text": "This study is a multicenter, prospective, observational epidemiologic study conducted across the Gulf region in UAE, Oman, and Kuwait. Patients were recruited consecutively from Kuwait Cancer Control Center (KCCC) in Kuwait, SQUH in Oman, and Tawam Hospital in UAE over the period from July 2017 to July 2019. Female patients aged 18 years or older with histologically confirmed epithelial ovarian, primary peritoneal, or fallopian tube cancers were eligible for the study. An availability of paraffin-embedded archived tumor tissue block or a minimum of twenty 10-mum sections (if a block is not available) was also required. Patients with previous tumors metastasizing to the ovary, patients with secondary malignancies associated with ovarian cancer, patients diagnosed with other severe acute or chronic medical or psychiatric conditions were excluded from this study. Patients enrolled in this study signed an informed consent form (ICF) when meeting all inclusion criteria. Demographic and clinical characteristics data were collected from patient medical records of the hosting institutions. Archived tumor samples were also obtained for the analysis of somatic BRCA PSVs. Blood samples for genetic testing of germline BRCA PSVs were sent to a central lab.", "sentences": [], "annotations": [{"id": "5120", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA", "locations": [{"offset": 6267, "length": 4}]}, {"id": "5121", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA", "locations": [{"offset": 6324, "length": 4}]}, {"id": "5122", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "Cancer", "locations": [{"offset": 5283, "length": 6}]}, {"id": "5123", "infons": {"identifier": "MESH:D001523", "type": "Disease", "valid": true, "normalized": ["D001523"], "database": "ncbi_mesh", "normalized_id": "D001523", "biotype": "disease", "name": "Mental Disorders", "accession": "@DISEASE_Mental_Disorders"}, "text": "psychiatric conditions", "locations": [{"offset": 5917, "length": 22}]}, {"id": "5124", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "ovarian, primary peritoneal, or fallopian tube cancers", "locations": [{"offset": 5488, "length": 54}]}, {"id": "5125", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "tumor", "locations": [{"offset": 5618, "length": 5}]}, {"id": "5126", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "malignancies", "locations": [{"offset": 5807, "length": 12}]}, {"id": "5127", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patient", "locations": [{"offset": 6144, "length": 7}]}, {"id": "5128", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "tumor", "locations": [{"offset": 6206, "length": 5}]}, {"id": "5129", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "tumors", "locations": [{"offset": 5748, "length": 6}]}, {"id": "5130", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "Patients", "locations": [{"offset": 5233, "length": 8}]}, {"id": "5131", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 5415, "length": 8}]}, {"id": "5132", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "Patients", "locations": [{"offset": 5725, "length": 8}]}, {"id": "5133", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 5783, "length": 8}]}, {"id": "5134", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 5852, "length": 8}]}, {"id": "5135", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "ovarian cancer", "locations": [{"offset": 5836, "length": 14}]}, {"id": "5136", "infons": {"identifier": "MESH:D010232", "type": "Chemical", "valid": true, "normalized": ["D010232"], "database": "ncbi_mesh", "normalized_id": "D010232", "biotype": "chemical", "name": "Paraffin", "accession": "@CHEMICAL_Paraffin"}, "text": "paraffin", "locations": [{"offset": 5591, "length": 8}]}, {"id": "5137", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "Patients", "locations": [{"offset": 5971, "length": 8}]}], "relations": []}, {"infons": {"section_type": "METHODS", "type": "paragraph"}, "offset": 6364, "text": "The analysis was performed on genomic DNA isolated from formalin-fixed paraffin-embedded (FFPE) tissue from blocks or slides of the ovarian, fallopian tube, or peritoneal serous carcinoma using the Tumor BRCA Analysis test. As a quality check, the portion of the tumor should have measured at least 5 x 5 mm and contain at least 20% tumor cellularity. In cases where blocks were not available, one 4-5 mum H&E slide and four consecutive 10 mum unstained slides were acceptable. Patient DNA was extracted and purified from the tumor specimen, assigned a unique bar-code for robotic-assisted continuous sample tracking, and submitted for molecular testing.", "sentences": [], "annotations": [{"id": "5138", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA", "locations": [{"offset": 6568, "length": 4}]}, {"id": "5139", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "Patient", "locations": [{"offset": 6842, "length": 7}]}, {"id": "5140", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "Tumor", "locations": [{"offset": 6562, "length": 5}]}, {"id": "5141", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "tumor", "locations": [{"offset": 6627, "length": 5}]}, {"id": "5142", "infons": {"identifier": "MESH:D006371", "type": "Chemical", "valid": true, "normalized": ["D006371"], "database": "ncbi_mesh", "normalized_id": "D006371", "biotype": "chemical", "name": "Helium", "accession": "@CHEMICAL_Helium"}, "text": "H&E", "locations": [{"offset": 6770, "length": 3}]}, {"id": "5143", "infons": {"identifier": "MESH:D005557", "type": "Chemical", "valid": true, "normalized": ["D005557"], "database": "ncbi_mesh", "normalized_id": "D005557", "biotype": "chemical", "name": "Formaldehyde", "accession": "@CHEMICAL_Formaldehyde"}, "text": "formalin", "locations": [{"offset": 6420, "length": 8}]}, {"id": "5144", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "tumor", "locations": [{"offset": 6697, "length": 5}]}, {"id": "5145", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "tumor", "locations": [{"offset": 6890, "length": 5}]}, {"id": "5146", "infons": {"identifier": "MESH:D010232", "type": "Chemical", "valid": true, "normalized": ["D010232"], "database": "ncbi_mesh", "normalized_id": "D010232", "biotype": "chemical", "name": "Paraffin", "accession": "@CHEMICAL_Paraffin"}, "text": "paraffin", "locations": [{"offset": 6435, "length": 8}]}, {"id": "5147", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "ovarian, fallopian tube, or peritoneal serous carcinoma", "locations": [{"offset": 6496, "length": 55}]}], "relations": []}, {"infons": {"section_type": "METHODS", "type": "paragraph"}, "offset": 7028, "text": "The test consists of sequencing and large rearrangement analyses of the BRCA1 and BRCA2 genes using next-generation sequencing (NGS). For BRCA1, full sequence determination of approximately 5.400 base-pairs comprising 22 coding exons and approximately 750 introns were performed, excluding exons 1 and 4, which are non-coding. For BRCA2, full sequence determination of approximately 10.200 base-pairs comprising 26 coding exons and approximately 900 introns were performed, excluding exon 1, which is non-coding. Genomic DNA derived from the tumor was also analyzed for large rearrangement analyses by NGS to determine copy number abnormalities indicative of deletion or duplication PSVs. Somatic BRCA PSV was analyzed using BRCAnalysis  (Myriad Genetics, Inc., Salt Lake City, UT) kits on available tissue blocks from the subjects enrolled. Germline BRCA PSV using blood sample was used to detect if hereditary reason exists in those who were mutated.", "sentences": [], "annotations": [{"id": "5148", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 7100, "length": 5}]}, {"id": "5149", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 7110, "length": 5}]}, {"id": "5150", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 7166, "length": 5}]}, {"id": "5151", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 7359, "length": 5}]}, {"id": "5152", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA", "locations": [{"offset": 7725, "length": 4}]}, {"id": "5153", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA", "locations": [{"offset": 7879, "length": 4}]}, {"id": "5154", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "tumor", "locations": [{"offset": 7570, "length": 5}]}, {"id": "5155", "infons": {"identifier": "MESH:D010855", "type": "Disease", "valid": true, "normalized": ["D010855"], "database": "ncbi_mesh", "normalized_id": "D010855", "biotype": "disease", "name": "Pierre Robin Syndrome", "accession": "@DISEASE_Pierre_Robin_Syndrome"}, "text": "PSVs", "locations": [{"offset": 7711, "length": 4}]}], "relations": []}, {"infons": {"section_type": "METHODS", "type": "paragraph"}, "offset": 7982, "text": "Study Subjects were classified according to treatment status at the time of enrolment into treatment-experienced and treatment naive subgroups.", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "METHODS", "type": "title_2"}, "offset": 8127, "text": "Statistical methods and data quality", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "METHODS", "type": "paragraph"}, "offset": 8164, "text": "Prevalence of BRCA PSVs and associated 95% confidence intervals were estimated from the results of genetic tests. Appropriate descriptive statistics were used to summarize the demographics and clinical characteristics of the patients as well as disease management patterns. Statistical analysis was performed using IBM SPSS. It was determined that the sample size of 120 would be sufficient to achieve a width of 15%, provided the prevalence of somatic BRCA PSVs is within the expected range of 15-20%. PASS software was used to calculate the sample size required for our study. The potential impact of non-random assignment was reduced by attempting to recruit participants consecutively and by using consistent inclusion/exclusion criteria across all study sites.", "sentences": [], "annotations": [{"id": "5156", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA", "locations": [{"offset": 8178, "length": 4}]}, {"id": "5157", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA", "locations": [{"offset": 8617, "length": 4}]}, {"id": "5158", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 8389, "length": 8}]}], "relations": []}, {"infons": {"section_type": "RESULTS", "type": "title_1"}, "offset": 8930, "text": "Results", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "RESULTS", "type": "title_2"}, "offset": 8938, "text": "Demographic, clinical, and histological characteristics", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "TABLE", "file": "Tab1.xml", "id": "Tab1", "type": "table_caption"}, "offset": 8994, "text": "Patients Demographics", "sentences": [], "annotations": [{"id": "5159", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "Patients", "locations": [{"offset": 8994, "length": 8}]}], "relations": []}, {"infons": {"section_type": "TABLE", "file": "Tab1.xml", "xml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?> <table frame=\"hsides\" rules=\"groups\"><thead><tr><th>Patients' Demographics</th><th>N</th><th>%</th></tr></thead><tbody><tr><td><bold>Age</bold> (Mean, SD in years)</td><td>55.2 (12.0)</td><td/></tr><tr><td><bold>BMI</bold> (Mean, SD in kg/m2)</td><td>28.9 (5.7)</td><td/></tr><tr><td colspan=\"3\"><bold>Smoking</bold></td></tr><tr><td> Current or past smoker</td><td>3</td><td>2.9</td></tr><tr><td> Never smoker</td><td>102</td><td>97.1</td></tr><tr><td colspan=\"3\"><bold>Race</bold></td></tr><tr><td> Arabic</td><td>72</td><td>68.6</td></tr><tr><td> South Asian</td><td>22</td><td>21.0</td></tr><tr><td> East Asian</td><td>7</td><td>6.7</td></tr><tr><td> Caucasian</td><td>1</td><td>1.0</td></tr><tr><td> African</td><td>3</td><td>2.9</td></tr><tr><td colspan=\"3\"><bold>Nationality</bold></td></tr><tr><td> Egyptian</td><td>18</td><td>17.1</td></tr><tr><td> Kuwaiti</td><td>18</td><td>17.1</td></tr><tr><td> Omani</td><td>13</td><td>12.4</td></tr><tr><td> Emiratis</td><td>12</td><td>11.4</td></tr><tr><td> Pakistani</td><td>11</td><td>10.5</td></tr><tr><td> Filipinos</td><td>8</td><td>7.6</td></tr><tr><td> Indian</td><td>6</td><td>5.7</td></tr><tr><td> Others<sup>a</sup></td><td>19</td><td>9.5</td></tr><tr><td colspan=\"3\"><bold>FIGO classification</bold></td></tr><tr><td> IA</td><td>4</td><td>3.8</td></tr><tr><td> IB</td><td>0</td><td>0</td></tr><tr><td> IC</td><td>14</td><td>13.3</td></tr><tr><td> IIA</td><td>6</td><td>5.7</td></tr><tr><td> IIB</td><td>4</td><td>3.8</td></tr><tr><td> IIC</td><td>1</td><td>1.0</td></tr><tr><td> IIIA</td><td>4</td><td>3.8</td></tr><tr><td> IIIB</td><td>5</td><td>4.8</td></tr><tr><td> IIIC</td><td>37</td><td>35.2</td></tr><tr><td> IV</td><td>11</td><td>10.5</td></tr><tr><td> Unknown/missing</td><td>10/9</td><td>18.1</td></tr><tr><td colspan=\"3\"><bold>Histological Type</bold></td></tr><tr><td> High grade serous carcinoma</td><td>49</td><td>46.7%</td></tr><tr><td> Low grade serous carcinoma</td><td>3</td><td>2.9%</td></tr><tr><td> Serous carcinoma (Not classified)</td><td>25</td><td>23.8%</td></tr><tr><td> Endometrioid carcinoma</td><td>8</td><td>7.6%</td></tr><tr><td> Adenosarcoma</td><td>8</td><td>7.6%</td></tr><tr><td> Mixed carcinoma</td><td>4</td><td>3.8%</td></tr><tr><td> Clear cell carcinoma</td><td>2</td><td>1.9%</td></tr><tr><td> Carcinosarcoma</td><td>1</td><td>1.0%</td></tr><tr><td> Mucinous carcinoma</td><td>1</td><td>1.0%</td></tr><tr><td> Mullerian mixed tumor</td><td>1</td><td>1.0%</td></tr><tr><td> Serous borderline tumor, micropapillary variant</td><td>1</td><td>1.0%</td></tr><tr><td> Missing</td><td>2</td><td>1.9%</td></tr></tbody></table> ", "id": "Tab1", "type": "table"}, "offset": 9016, "text": "Patients' Demographics N %   Age (Mean, SD in years) 55.2 (12.0)    BMI (Mean, SD in kg/m2) 28.9 (5.7)    Smoking    Current or past smoker 3 2.9    Never smoker 102 97.1   Race    Arabic 72 68.6    South Asian 22 21.0    East Asian 7 6.7    Caucasian 1 1.0    African 3 2.9   Nationality    Egyptian 18 17.1    Kuwaiti 18 17.1    Omani 13 12.4    Emiratis 12 11.4    Pakistani 11 10.5    Filipinos 8 7.6    Indian 6 5.7    Othersa 19 9.5   FIGO classification    IA 4 3.8    IB 0 0    IC 14 13.3    IIA 6 5.7    IIB 4 3.8    IIC 1 1.0    IIIA 4 3.8    IIIB 5 4.8    IIIC 37 35.2    IV 11 10.5    Unknown/missing 10/9 18.1   Histological Type    High grade serous carcinoma 49 46.7%    Low grade serous carcinoma 3 2.9%    Serous carcinoma (Not classified) 25 23.8%    Endometrioid carcinoma 8 7.6%    Adenosarcoma 8 7.6%    Mixed carcinoma 4 3.8%    Clear cell carcinoma 2 1.9%    Carcinosarcoma 1 1.0%    Mucinous carcinoma 1 1.0%    Mullerian mixed tumor 1 1.0%    Serous borderline tumor, micropapillary variant 1 1.0%    Missing 2 1.9%   ", "sentences": [], "annotations": [{"id": "5160", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "Patients", "locations": [{"offset": 9016, "length": 8}]}, {"id": "5161", "infons": {"identifier": "MESH:D018297", "type": "Disease", "valid": true, "normalized": ["D018297"], "database": "ncbi_mesh", "normalized_id": "D018297", "biotype": "disease", "name": "Neoplasms Cystic Mucinous and Serous", "accession": "@DISEASE_Neoplasms_Cystic_Mucinous_and_Serous"}, "text": "serous carcinoma", "locations": [{"offset": 9673, "length": 16}]}, {"id": "5162", "infons": {"identifier": "MESH:D018198", "type": "Disease", "valid": true, "normalized": ["D018198"], "database": "ncbi_mesh", "normalized_id": "D018198", "biotype": "disease", "name": "Mixed Tumor Malignant", "accession": "@DISEASE_Mixed_Tumor_Malignant"}, "text": "Mixed carcinoma", "locations": [{"offset": 9841, "length": 15}]}, {"id": "5163", "infons": {"identifier": "MESH:D018297", "type": "Disease", "valid": true, "normalized": ["D018297"], "database": "ncbi_mesh", "normalized_id": "D018297", "biotype": "disease", "name": "Neoplasms Cystic Mucinous and Serous", "accession": "@DISEASE_Neoplasms_Cystic_Mucinous_and_Serous"}, "text": "serous carcinoma", "locations": [{"offset": 9712, "length": 16}]}, {"id": "5164", "infons": {"identifier": "MESH:D018195", "type": "Disease", "valid": true, "normalized": ["D018195"], "database": "ncbi_mesh", "normalized_id": "D018195", "biotype": "disease", "name": "Adenosarcoma", "accession": "@DISEASE_Adenosarcoma"}, "text": "Adenosarcoma", "locations": [{"offset": 9818, "length": 12}]}, {"id": "5165", "infons": {"identifier": "MESH:D018269", "type": "Disease", "valid": true, "normalized": ["D018269"], "database": "ncbi_mesh", "normalized_id": "D018269", "biotype": "disease", "name": "Carcinoma Endometrioid", "accession": "@DISEASE_Carcinoma_Endometrioid"}, "text": "Endometrioid carcinoma", "locations": [{"offset": 9785, "length": 22}]}, {"id": "5166", "infons": {"identifier": "MESH:D018297", "type": "Disease", "valid": true, "normalized": ["D018297"], "database": "ncbi_mesh", "normalized_id": "D018297", "biotype": "disease", "name": "Neoplasms Cystic Mucinous and Serous", "accession": "@DISEASE_Neoplasms_Cystic_Mucinous_and_Serous"}, "text": "Serous carcinoma", "locations": [{"offset": 9739, "length": 16}]}], "relations": []}, {"infons": {"section_type": "TABLE", "file": "Tab1.xml", "id": "Tab1", "type": "table_foot"}, "offset": 10139, "text": "aOthers were 3 from Syria, 2 from each of Bangladesh, Lebanon, Sudan, and Yemen, and 1 from each of United Kingdom, Afghanistan, Comoro islands, Iran, Jordan, Palestine, Romania, and unknown origin", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "RESULTS", "type": "paragraph"}, "offset": 10337, "text": "In total, 105 consenting and eligible patients were enrolled over 18 months. The median age at diagnosis was 52 years (IQR 44.5 - 61.0). Approximately 68% of patients were of Arab origin. High-grade serous carcinoma was the most reported histological type of tumors (46.7%), followed by unclassified serous carcinoma (23.8%) and low-grade serous carcinoma (2.9%). More than half of the patients (54.3%) had advanced disease (FIGO stage III/IV) at presentation. Besides, 87 (82.9%) patients underwent debulking surgery, with no residual disease in 42.5%, optimal cytoreduction in 29.9%, and suboptimal cytoreduction in 25.3% of patients. The demographic, clinical, and histological characteristics of the patients are listed in Table 1.", "sentences": [], "annotations": [{"id": "5167", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "tumors", "locations": [{"offset": 10596, "length": 6}]}, {"id": "5168", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 10964, "length": 8}]}, {"id": "5169", "infons": {"identifier": "MESH:D004194", "type": "Disease", "valid": true, "normalized": ["D004194"], "database": "ncbi_mesh", "normalized_id": "D004194", "biotype": "disease", "name": "Disease", "accession": "@DISEASE_Disease"}, "text": "disease", "locations": [{"offset": 10753, "length": 7}]}, {"id": "5170", "infons": {"identifier": "MESH:D018297", "type": "Disease", "valid": true, "normalized": ["D018297"], "database": "ncbi_mesh", "normalized_id": "D018297", "biotype": "disease", "name": "Neoplasms Cystic Mucinous and Serous", "accession": "@DISEASE_Neoplasms_Cystic_Mucinous_and_Serous"}, "text": "serous carcinoma", "locations": [{"offset": 10637, "length": 16}]}, {"id": "5171", "infons": {"identifier": "MESH:D062706", "type": "Disease", "valid": true, "normalized": ["D062706"], "database": "ncbi_mesh", "normalized_id": "D062706", "biotype": "disease", "name": "Prodromal Symptoms", "accession": "@DISEASE_Prodromal_Symptoms"}, "text": "FIGO stage III", "locations": [{"offset": 10762, "length": 14}]}, {"id": "5172", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 10375, "length": 8}]}, {"id": "5173", "infons": {"identifier": "MESH:D004194", "type": "Disease", "valid": true, "normalized": ["D004194"], "database": "ncbi_mesh", "normalized_id": "D004194", "biotype": "disease", "name": "Disease", "accession": "@DISEASE_Disease"}, "text": "disease", "locations": [{"offset": 10873, "length": 7}]}, {"id": "5174", "infons": {"identifier": "MESH:D018297", "type": "Disease", "valid": true, "normalized": ["D018297"], "database": "ncbi_mesh", "normalized_id": "D018297", "biotype": "disease", "name": "Neoplasms Cystic Mucinous and Serous", "accession": "@DISEASE_Neoplasms_Cystic_Mucinous_and_Serous"}, "text": "serous carcinoma", "locations": [{"offset": 10676, "length": 16}]}, {"id": "5175", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 11041, "length": 8}]}, {"id": "5176", "infons": {"identifier": "MESH:D018297", "type": "Disease", "valid": true, "normalized": ["D018297"], "database": "ncbi_mesh", "normalized_id": "D018297", "biotype": "disease", "name": "Neoplasms Cystic Mucinous and Serous", "accession": "@DISEASE_Neoplasms_Cystic_Mucinous_and_Serous"}, "text": "serous carcinoma", "locations": [{"offset": 10536, "length": 16}]}, {"id": "5177", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 10723, "length": 8}]}, {"id": "5178", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 10495, "length": 8}]}, {"id": "5179", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 10818, "length": 8}]}], "relations": []}, {"infons": {"section_type": "RESULTS", "type": "title_2"}, "offset": 11080, "text": "Family history", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "RESULTS", "type": "paragraph"}, "offset": 11095, "text": "A total of 10 (9.5%) patients reported having a total of 12 family members with a history of ovarian or breast cancer. Another three (2.9%) patients reported having a total of five members with other types of cancer. Those patients with family history of ovarian or breast cancer were younger than those who did not report any family history of ovarian or breast cancer (48.9 versus 55.8 years old respectively). As compared with patients who didn't report any family history of ovarian or breast cancer, those who did were diagnosed at a younger age (46.3 vs 53.3 years). The distribution of the family history of cancers is present in Additional Table 1.", "sentences": [], "annotations": [{"id": "5180", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 11318, "length": 8}]}, {"id": "5181", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "cancers", "locations": [