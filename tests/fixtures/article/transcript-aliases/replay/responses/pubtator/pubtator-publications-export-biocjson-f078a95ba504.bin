"accession": "@DISEASE_Neoplasms"}, "text": "Cancer", "locations": [{"offset": 22847, "length": 6}]}], "relations": []}, {"infons": {"section_type": "ABBR", "type": "paragraph"}, "offset": 22869, "text": "kg", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "ABBR", "type": "paragraph"}, "offset": 22872, "text": "Kilogram", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "ABBR", "type": "paragraph"}, "offset": 22881, "text": "NGS", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "ABBR", "type": "paragraph"}, "offset": 22885, "text": "Next-generation sequencing", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "ABBR", "type": "paragraph"}, "offset": 22912, "text": "m", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "ABBR", "type": "paragraph"}, "offset": 22914, "text": "Meter", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "ABBR", "type": "paragraph"}, "offset": 22920, "text": "OC", "sentences": [], "annotations": [{"id": "5360", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "OC", "locations": [{"offset": 22920, "length": 2}]}], "relations": []}, {"infons": {"section_type": "ABBR", "type": "paragraph"}, "offset": 22923, "text": "Ovarian cancer", "sentences": [], "annotations": [{"id": "5361", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "Ovarian cancer", "locations": [{"offset": 22923, "length": 14}]}], "relations": []}, {"infons": {"section_type": "ABBR", "type": "paragraph"}, "offset": 22938, "text": "PREDICT", "sentences": [], "annotations": [{"id": "5362", "infons": {"type": "Disease", "valid": false, "normalized_id": null, "biotype": "disease"}, "text": "PREDICT", "locations": [{"offset": 22938, "length": 7}]}], "relations": []}, {"infons": {"section_type": "ABBR", "type": "paragraph"}, "offset": 22946, "text": "Prevalence of BRCA1 and BRCA2 Pathogenic Sequence Variants in Ovarian Cancer Patients in The Gulf Region", "sentences": [], "annotations": [{"id": "5363", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 22960, "length": 5}]}, {"id": "5364", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 22970, "length": 5}]}, {"id": "5365", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "Patients", "locations": [{"offset": 23023, "length": 8}]}, {"id": "5366", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "Ovarian Cancer", "locations": [{"offset": 23008, "length": 14}]}], "relations": []}, {"infons": {"section_type": "ABBR", "type": "paragraph"}, "offset": 23051, "text": "PSVs", "sentences": [], "annotations": [{"id": "5367", "infons": {"identifier": "-", "type": "Chemical", "valid": false, "normalized_id": null, "biotype": "chemical"}, "text": "PSVs", "locations": [{"offset": 23051, "length": 4}]}], "relations": []}, {"infons": {"section_type": "ABBR", "type": "paragraph"}, "offset": 23056, "text": "Pathogenic sequence variants", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "ABBR", "type": "paragraph"}, "offset": 23085, "text": "SD", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "ABBR", "type": "paragraph"}, "offset": 23088, "text": "Standard deviation", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "ABBR", "type": "paragraph"}, "offset": 23107, "text": "TCGA", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "ABBR", "type": "paragraph"}, "offset": 23112, "text": "The Cancer Genome Atlas", "sentences": [], "annotations": [{"id": "5368", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "Cancer", "locations": [{"offset": 23116, "length": 6}]}], "relations": []}, {"infons": {"section_type": "ABBR", "type": "footnote"}, "offset": 23136, "text": "Publisher's Note", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "ABBR", "type": "footnote"}, "offset": 23155, "text": "Springer Nature remains neutral with regard to jurisdictional claims in published maps and institutional affiliations.", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "AUTH_CONT", "type": "title"}, "offset": 23274, "text": "Authors' contributions", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "AUTH_CONT", "type": "paragraph"}, "offset": 23299, "text": "FA contributed to concept and design, literature search, clinical studies, statistical analysis, manuscript preparation, manuscript editing, and manuscript review. EA, ED, MA, and IB contributed to literature search, clinical studies, statistical analysis, manuscript preparation, manuscript editing, and manuscript review. AK and MA contributed to concept and design, definition of intellectual content, literature search, clinical studies, data acquisition, data analysis, statistical analysis, manuscript preparation, manuscript editing, and manuscript review. All authors reviewed the manuscript. The author(s) read and approved the final manuscript.", "sentences": [], "annotations": [{"id": "5369", "infons": {"type": "Disease", "valid": false, "normalized_id": null, "biotype": "disease"}, "text": "ED", "locations": [{"offset": 23467, "length": 2}]}], "relations": []}, {"infons": {"section_type": "ACK_FUND", "type": "title"}, "offset": 23954, "text": "Funding", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "ACK_FUND", "type": "paragraph"}, "offset": 23962, "text": "This study was sponsored by AstraZeneca, United Arab Emirates. We appreciate all the efforts made by Clinart MENA in performing the biostatistics and manuscript writing.", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "METHODS", "type": "title"}, "offset": 24132, "text": "Availability of data and materials", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "METHODS", "type": "paragraph"}, "offset": 24167, "text": "The datasets used and/or analysed during the current study available from the corresponding author on reasonable request.", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "METHODS", "type": "title"}, "offset": 24289, "text": "Declarations", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "METHODS", "type": "title"}, "offset": 24302, "text": "Ethics approval and consent to participate", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "METHODS", "type": "paragraph"}, "offset": 24345, "text": "The study was approved by the local ethics committee of Ministry of Health, Kuwait (Ref No. 1990), Sultan Qaboos University (SQUH), Oman (Ref No. MREC # 1441), and Tawam Hospital, UAE (Ref No. SA/SS/600). Patients enrolled in this study signed an informed consent form (ICF) when meeting all inclusion criteria.", "sentences": [], "annotations": [{"id": "5370", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "Patients", "locations": [{"offset": 24550, "length": 8}]}], "relations": []}, {"infons": {"section_type": "METHODS", "type": "title"}, "offset": 24657, "text": "Consent for publication", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "METHODS", "type": "paragraph"}, "offset": 24681, "text": "Not applicable.", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "COMP_INT", "type": "title"}, "offset": 24697, "text": "Competing interests", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "COMP_INT", "type": "paragraph"}, "offset": 24717, "text": "Amgad Kamal and Mohamed Alsayed work for AstraZeneca; however, there is no conflict of interest. Dr. Fathi Azribi has received honoraria for Advisory board, as a speaker and travel, from AstraZeneca, Pfizer, Novartis, BMS, Amgen, and MSD. The rest of the authors declare that they have no conflict of interest.", "sentences": [], "annotations": [{"id": "5371", "infons": {"type": "Disease", "valid": false, "normalized_id": null, "biotype": "disease"}, "text": "conflict of", "locations": [{"offset": 25006, "length": 11}]}, {"id": "5372", "infons": {"type": "Disease", "valid": false, "normalized_id": null, "biotype": "disease"}, "text": "conflict of", "locations": [{"offset": 24792, "length": 11}]}], "relations": []}, {"