2], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 14086, "length": 5}]}, {"id": "5270", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "tumor", "locations": [{"offset": 15944, "length": 5}]}, {"id": "5271", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "Tumor", "locations": [{"offset": 15517, "length": 5}]}, {"id": "5272", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "Tumor", "locations": [{"offset": 14649, "length": 5}]}, {"id": "5273", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "tumor", "locations": [{"offset": 15903, "length": 5}]}], "relations": []}, {"infons": {"section_type": "RESULTS", "type": "paragraph"}, "offset": 16158, "text": "The clinical and histological features for those with somatic BRCA1/BRCA2 compared with those who do not are presented in Table 3. Patients with somatic PSVs had slightly higher prevalence of family history of cancer (13.3% versus 9.7%) and high-grade serous carcinoma (66.7% versus 38.7%).", "sentences": [], "annotations": [{"id": "5274", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 16220, "length": 5}]}, {"id": "5275", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 16226, "length": 5}]}, {"id": "5276", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "Patients", "locations": [{"offset": 16289, "length": 8}]}, {"id": "5277", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "cancer", "locations": [{"offset": 16368, "length": 6}]}, {"id": "5278", "infons": {"identifier": "MESH:D018297", "type": "Disease", "valid": true, "normalized": ["D018297"], "database": "ncbi_mesh", "normalized_id": "D018297", "biotype": "disease", "name": "Neoplasms Cystic Mucinous and Serous", "accession": "@DISEASE_Neoplasms_Cystic_Mucinous_and_Serous"}, "text": "serous carcinoma", "locations": [{"offset": 16410, "length": 16}]}], "relations": []}, {"infons": {"section_type": "DISCUSS", "type": "title_1"}, "offset": 16450, "text": "Discussion", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "DISCUSS", "type": "paragraph"}, "offset": 16461, "text": "The overall prevalence of somatic BRCA1/BRCA2 PSVs in our study was 17% (95% CI, 9.9 to 26.6%). According to previously published literature, the prevalence of BRCA1/BRCA2 PSVs ranges from 16 to 40%, which reflects that the prevalence of BRCA1/BRCA2 PSVs in the Gulf region falls within the lower end in the global prevalence range. Several studies reported variation in the worldwide prevalence of BRCA1 and BRCA2 PSVs. This could be due to the ethnic differences in the studied populations, barriers to access, different tissue histology, and other latent variables. The Integrated genomic analyses of ovarian carcinoma study conducted through the Cancer Genome Atlas (TCGA) Research Network reported a prevalence of 20% BRCA PSVs in high-grade serous ovarian cancer samples. Somatic BRCA PSVs were found in only 3% of patients. Other studies reported an even higher overall prevalence of BRCA PSVs in ovarian cancer patients; In a study of 100 samples of ovarian carcinoma, the PSVs were identified in 28% of samples. However, other studies found a lower prevalence of BRCA1/BRCA2 PSVs, ranging from 8 to 14.1%. Moreover, Koczkowska et al. reported the overall prevalence of somatic BRCA1/BRCA2 PSVs was 4.1%, respectively.", "sentences": [], "annotations": [{"id": "5279", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 16495, "length": 5}]}, {"id": "5280", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 16501, "length": 5}]}, {"id": "5281", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 16621, "length": 5}]}, {"id": "5282", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 16627, "length": 5}]}, {"id": "5283", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 16699, "length": 5}]}, {"id": "5284", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 16705, "length": 5}]}, {"id": "5285", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 16860, "length": 5}]}, {"id": "5286", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 16870, "length": 5}]}, {"id": "5287", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA", "locations": [{"offset": 17184, "length": 4}]}, {"id": "5288", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA", "locations": [{"offset": 17247, "length": 4}]}, {"id": "5289", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA", "locations": [{"offset": 17352, "length": 4}]}, {"id": "5290", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 17533, "length": 5}]}, {"id": "5291", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 17539, "length": 5}]}, {"id": "5292", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 17647, "length": 5}]}, {"id": "5293", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 17653, "length": 5}]}, {"id": "5294", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "serous ovarian cancer", "locations": [{"offset": 17208, "length": 21}]}, {"id": "5295", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "ovarian cancer", "locations": [{"offset": 17365, "length": 14}]}, {"id": "5296", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 17380, "length": 8}]}, {"id": "5297", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "ovarian carcinoma", "locations": [{"offset": 17419, "length": 17}]}, {"id": "5298", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "Cancer", "locations": [{"offset": 17111, "length": 6}]}, {"id": "5299", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 17282, "length": 8}]}, {"id": "5300", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "ovarian carcinoma", "locations": [{"offset": 17065, "length": 17}]}], "relations": []}, {"infons": {"section_type": "DISCUSS", "type": "paragraph"}, "offset": 17688, "text": "Looking closely at individual BRCA PSVs, our study reported that BRCA1 and BRCA2 PSVs were detected in 11.2 and 9.1% of the patients, respectively. Variability in the prevalence of individual BRCA1 and BRCA2 PSVs (similar to the overall prevalence of BRCA1/BRCA2 PSVs) was also observed in similar studies. Previous reports showed that the prevalence of somatic BRCA1 and BRCA2 PSVs occurred in 2 and 8% of the patients, respectively.", "sentences": [], "annotations": [{"id": "5301", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA", "locations": [{"offset": 17718, "length": 4}]}, {"id": "5302", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 17753, "length": 5}]}, {"id": "5303", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 17763, "length": 5}]}, {"id": "5304", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 17880, "length": 5}]}, {"id": "5305", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 17890, "length": 5}]}, {"id": "5306", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 17939, "length": 5}]}, {"id": "5307", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 17945, "length": 5}]}, {"id": "5308", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 18050, "length": 5}]}, {"id": "5309", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 18060, "length": 5}]}, {"id": "5310", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 17812, "length": 8}]}, {"id": "5311", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 18099, "length": 8}]}], "relations": []}, {"infons": {"section_type": "DISCUSS", "type": "paragraph"}, "offset": 18123, "text": "Most patients in our study were with advanced stages at diagnosis. This is consistent with the study by Heintz et al., which reported that 75% of patients with ovarian cancer were typically diagnosed at late stages (56.3% stage III or higher; 44.6% stage III and 11.7% stage IV). Another German study conducted on 1038 patients with ovarian cancer showed similar results (79% presenting with FIGO III disease). The late presentation of ovarian cancer in the Gulf region and the Middle East is due to the stealthy nature of ovarian cancer, the stigma of reporting gynecological symptoms, and lack of health awareness, especially among older women.", "sentences": [], "annotations": [{"id": "5312", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "ovarian cancer", "locations": [{"offset": 18559, "length": 14}]}, {"id": "5313", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 18442, "length": 8}]}, {"id": "5314", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "ovarian cancer", "locations": [{"offset": 18456, "length": 14}]}, {"id": "5315", "infons": {"identifier": "MESH:D015840", "type": "Disease", "valid": true, "normalized": ["D015840"], "database": "ncbi_mesh", "normalized_id": "D015840", "biotype": "disease", "name": "Oculomotor Nerve Diseases", "accession": "@DISEASE_Oculomotor_Nerve_Diseases"}, "text": "FIGO III disease", "locations": [{"offset": 18515, "length": 16}]}, {"id": "5316", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "ovarian cancer", "locations": [{"offset": 18283, "length": 14}]}, {"id": "5317", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "women", "locations": [{"offset": 18763, "length": 5}]}, {"id": "5318", "infons": {"identifier": "MESH:D005831", "type": "Disease", "valid": true, "normalized": ["D005831"], "database": "ncbi_mesh", "normalized_id": "D005831", "biotype": "disease", "name": "Genital Diseases Female", "accession": "@DISEASE_Genital_Diseases_Female"}, "text": "gynecological symptoms", "locations": [{"offset": 18686, "length": 22}]}, {"id": "5319", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 18128, "length": 8}]}, {"id": "5320", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "ovarian cancer", "locations": [{"offset": 18646, "length": 14}]}, {"id": "5321", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 18269, "length": 8}]}], "relations": []}, {"infons": {"section_type": "DISCUSS", "type": "paragraph"}, "offset": 18770, "text": "According to Stratton et al., and compared to women without familial history of ovarian cancer, women with a family history are reported to have a higher risk of developing this disease. This has been interpreted as a hereditary susceptibility genetically transmitted across generations. A study by Negri et al. confirms that a family history of ovarian cancer in first-degree relatives increases the risk of ovarian cancer. A family history of a few other cancer sites, including breast, intestine, stomach, and lymphomas, was also directly associated with ovarian cancer risk, and the OR was increased for family history of any cancer. A study in Saudi Arabia reported that 20.3% of cases had a positive family history of either breast or ovarian cancer in either first- or second-degree relatives. 32.5% of cases were early-onset (age at diagnosis < 40 years).", "sentences": [], "annotations": [{"id": "5322", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "women", "locations": [{"offset": 18866, "length": 5}]}, {"id": "5323", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "women", "locations": [{"offset": 18816, "length": 5}]}, {"id": "5324", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "ovarian cancer", "locations": [{"offset": 19116, "length": 14}]}, {"id": "5325", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "ovarian cancer", "locations": [{"offset": 19179, "length": 14}]}, {"id": "5326", "infons": {"identifier": "MESH:D008223", "type": "Disease", "valid": true, "normalized": ["D008223"], "database": "ncbi_mesh", "normalized_id": "D008223", "biotype": "disease", "name": "Lymphoma", "accession": "@DISEASE_Lymphoma"}, "text": "lymphomas", "locations": [{"offset": 19283, "length": 9}]}, {"id": "5327", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "ovarian cancer", "locations": [{"offset": 18850, "length": 14}]}, {"id": "5328", "infons": {"identifier": "MESH:D061325", "type": "Disease", "valid": true, "normalized": ["D061325"], "database": "ncbi_mesh", "normalized_id": "D061325", "biotype": "disease", "name": "Hereditary Breast and Ovarian Cancer Syndrome", "accession": "@DISEASE_Hereditary_Breast_and_Ovarian_Cancer_Syndrome"}, "text": "breast or ovarian cancer", "locations": [{"offset": 19501, "length": 24}]}, {"id": "5329", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "cancer", "locations": [{"offset": 19227, "length": 6}]}, {"id": "5330", "infons": {"identifier": "MESH:D013272", "type": "Disease", "valid": true, "normalized": ["D013272"], "database": "ncbi_mesh", "normalized_id": "D013272", "biotype": "disease", "name": "Stomach Diseases", "accession": "@DISEASE_Stomach_Diseases"}, "text": "stomach", "locations": [{"offset": 19270, "length": 7}]}, {"id": "5331", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "ovarian cancer", "locations": [{"offset": 19328, "length": 14}]}, {"id": "5332", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "cancer", "locations": [{"offset": 19400, "length": 6}]}], "relations": []}, {"infons": {"section_type": "DISCUSS", "type": "paragraph"}, "offset": 19638, "text": "A recent study by Siraj et al. in 2019, conducted in the Middle East, reported that BRCA1 PSVs were significantly associated with positive family history and emphasized on the importance of genetic counseling, guidelines for risk assessment, early detection, and putting cost-effective screening programs in action.", "sentences": [], "annotations": [{"id": "5333", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 19722, "length": 5}]}], "relations": []}, {"infons": {"section_type": "DISCUSS", "type": "paragraph"}, "offset": 19954, "text": "This study has several strengths, and it opens the way for future studies investigating clinical endpoints among ovarian cancer patients in the Arabian Gulf region; one point of strength is the recruitment from multiple study sites across multiple countries in the Gulf region. This study also highlighted the importance of tissue archiving in a bio-bank / bio-repository and represents an encouraging example for oncology centers to start bio-banking. One potential limitation of our study is that, in absolute terms, the sample is relatively small, although this study recruited a substantial and sufficient sample size to conduct all planned analyses. Another limitation was that only 84% (88 out of 105) of patients had genetic testing done; this was attributed to insufficient sample, low sample quality, lack of tissue availability, or failed testing. Also, the germline testing was limited to those with somatic PSVs, so the prevalence of germline PSVs could not be computed. More patients will need to be recruited for future studies investigating longitudinal endpoints, such as survival. In addition to that, and although all efforts possible were made in order to ensure that accurate and complete data is collected for each patient, the extent to which it is practical to do so (for example, the completeness of electronic patient medical records) is not known a priori. Another possible limitation in our study is that the collected information regarding family history was obtained through a personal interview and was not confirmed by the medical records of family members in question or a formal cancer registry database. It is also worth mentioning that the Gulf region is characterized by a mixed ethnic population with Arabic predominance. Data regarding parity were not collected as well. Secondary malignancies were excluded, as the primary objective of the study was to reflect the frequency of BRCA1/BRCA2 PSVs in primary ovarian cancer patients. However, excluding breast cancer cases might have introduced bias to our findings. Finally, there is always a possibility among observational studies such as this one that unaccounted variables may result in residual bias in the planned analyses, though caution was taken when interpreting the final results.", "sentences": [], "annotations": [{"id": "5334", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 21871, "length": 5}]}, {"id": "5335", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 21877, "length": 5}]}, {"id": "5336", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "malignancies", "locations": [{"offset": 21773, "length": 12}]}, {"id": "5337", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "ovarian cancer", "locations": [{"offset": 20067, "length": 14}]}, {"id": "5338", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patient", "locations": [{"offset": 21289, "length": 7}]}, {"id": "5339", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patient", "locations": [{"offset": 21190, "length": 7}]}, {"id": "5340", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 21914, "length": 8}]}, {"id": "5341", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 20082, "length": 8}]}, {"id": "5342", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 20942, "length": 8}]}, {"id": "5343", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "ovarian cancer", "locations": [{"offset": 21899, "length": 14}]}, {"id": "5344", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "breast cancer", "locations": [{"offset": 21943, "length": 13}]}, {"id": "5345", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 20665, "length": 8}]}, {"id": "5346", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "cancer", "locations": [{"offset": 21566, "length": 6}]}], "relations": []}, {"infons": {"section_type": "CONCL", "type": "title_1"}, "offset": 22233, "text": "Conclusion", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "CONCL", "type": "paragraph"}, "offset": 22244, "text": "Our study showed that somatic BRCA1/BRCA2 PSVs prevalence in Gulf Countries is notably higher than the reported global figures (2-8%). These results warrant more detailed future studies with a larger number of patients and further evaluation of germline and somatic BRCA1/BRCA2 PSVs to better understand their impact on ovarian cancer patient outcomes in Gulf countries.", "sentences": [], "annotations": [{"id": "5347", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 22274, "length": 5}]}, {"id": "5348", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 22280, "length": 5}]}, {"id": "5349", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 22510, "length": 5}]}, {"id": "5350", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 22516, "length": 5}]}, {"id": "5351", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "ovarian cancer", "locations": [{"offset": 22564, "length": 14}]}, {"id": "5352", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patient", "locations": [{"offset": 22579, "length": 7}]}, {"id": "5353", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species",