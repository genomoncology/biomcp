2}]}, {"id": "38070", "infons": {"identifier": "tmVar:p|SUB|P|616|R;HGVS:p.P616R;VariantGroup:11;CorrespondingGene:4436;RS#:587779965;CorrespondingSpecies:9606;CA#:19432", "type": "Variant", "valid": true, "subtype": "ProteinMutation", "database": "litvar", "hgvs": "p.P616R", "gene_ids": [4436], "gene_id": 4436, "rsids": ["rs587779965"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA19432", "rsid": "rs587779965", "normalized": ["rs587779965##", "#4436#", "CA19432#rs587779965##"], "normalized_id": "rs587779965##", "biotype": "variant", "name": "p.P616R", "accession": "@VARIANT_p.P616R_MSH2_human"}, "text": "p.(Pro616Arg)", "locations": [{"offset": 15439, "length": 13}]}, {"id": "38071", "infons": {"identifier": "tmVar:c|SUB|C|934|T;HGVS:c.934C>T;VariantGroup:7;CorrespondingGene:5889;RS#:730881932;CorrespondingSpecies:9606;CA#:299887", "type": "Variant", "valid": true, "subtype": "DNAMutation", "database": "litvar", "hgvs": "c.934C>T", "gene_ids": [5889], "gene_id": 5889, "rsids": ["rs730881932"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA299887", "rsid": "rs730881932", "normalized": ["rs730881932##", "#5889#", "CA299887#rs730881932##"], "normalized_id": "rs730881932##", "biotype": "variant", "name": "c.934C>T", "accession": "@VARIANT_p.R312W_RAD51C_human"}, "text": "c.934C>T", "locations": [{"offset": 15323, "length": 8}]}, {"id": "38072", "infons": {"identifier": "tmVar:p|SUB|R|312|W;HGVS:p.R312W;VariantGroup:7;CorrespondingGene:5889;RS#:730881932;CorrespondingSpecies:9606;CA#:299887", "type": "Variant", "valid": true, "subtype": "ProteinMutation", "database": "litvar", "hgvs": "p.R312W", "gene_ids": [5889], "gene_id": 5889, "rsids": ["rs730881932"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA299887", "rsid": "rs730881932", "normalized": ["rs730881932##", "#5889#", "CA299887#rs730881932##"], "normalized_id": "rs730881932##", "biotype": "variant", "name": "p.R312W", "accession": "@VARIANT_p.R312W_RAD51C_human"}, "text": "p.(Arg312Trp)", "locations": [{"offset": 15974, "length": 13}]}, {"id": "38073", "infons": {"type": "Disease", "valid": false, "normalized_id": null, "biotype": "disease"}, "text": "CC", "locations": [{"offset": 15824, "length": 2}]}, {"id": "38074", "infons": {"identifier": "tmVar:c|SUB|C|934|T;HGVS:c.934C>T;VariantGroup:7;CorrespondingGene:5889;RS#:730881932;CorrespondingSpecies:9606;CA#:299887", "type": "Variant", "valid": true, "subtype": "DNAMutation", "database": "litvar", "hgvs": "c.934C>T", "gene_ids": [5889], "gene_id": 5889, "rsids": ["rs730881932"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA299887", "rsid": "rs730881932", "normalized": ["rs730881932##", "#5889#", "CA299887#rs730881932##"], "normalized_id": "rs730881932##", "biotype": "variant", "name": "c.934C>T", "accession": "@VARIANT_p.R312W_RAD51C_human"}, "text": "c.934C>T", "locations": [{"offset": 15964, "length": 8}]}], "relations": []}, {"infons": {"section_type": "RESULTS", "type": "paragraph"}, "offset": 16332, "text": "The c.1026+5_1026+7del deletion was detected in a high serious grade (HSG) OC case (P110) with onset at 51 years. She referred a marked maternal familiarity for cancer, including OC, PrC, esophageal, and gastric cancers in first and second-degree relatives and leukemia and an early-onset brain tumor in cousins (Figure 2c). This rare variant (f = 1.19 x 10-6, gnomAD data) has been reported in individuals with breast, ovarian, and uterine cancer. Functional studies have demonstrated that c.1026+5_1026+7del affects a consensus splice site in intron 8 of the RAD51C, leading to the exon 8 skipping and resulting in a frameshift mutation that causes a premature termination codon, p.(Arg322Serfs*22).", "sentences": [], "annotations": [{"id": "38075", "infons": {"identifier": "5889", "type": "Gene", "ncbi_homologene": "14238", "valid": true, "normalized": [5889], "database": "ncbi_gene", "normalized_id": 5889, "biotype": "gene", "name": "RAD51C", "accession": "@GENE_RAD51C"}, "text": "RAD51C", "locations": [{"offset": 16893, "length": 6}]}, {"id": "38076", "infons": {"identifier": "tmVar:c|DEL|1026+5_1026+7|;HGVS:c.1026+5_1026+7del;VariantGroup:79;CorrespondingGene:5889;CorrespondingSpecies:9606", "type": "Variant", "valid": true, "subtype": "DNAMutation", "database": "litvar", "hgvs": "c.1026+5_1026+7del", "gene_ids": [5889], "gene_id": 5889, "species_ids": [9606], "species_id": 9606, "rsids": [], "normalized": ["#5889#c.1026+5_1026+7del", "#5889#"], "normalized_id": "#5889#c.1026+5_1026+7del", "biotype": "variant", "name": "c.1026+5_1026+7del", "accession": "@VARIANT_c.1026+5_1026+7del_RAD51C_human"}, "text": "c.1026+5_1026+7del", "locations": [{"offset": 16336, "length": 18}]}, {"id": "38077", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "cancer", "locations": [{"offset": 16493, "length": 6}]}, {"id": "38078", "infons": {"identifier": "MESH:D013274", "type": "Disease", "valid": true, "normalized": ["D013274"], "database": "ncbi_mesh", "normalized_id": "D013274", "biotype": "disease", "name": "Stomach Neoplasms", "accession": "@DISEASE_Stomach_Neoplasms"}, "text": "esophageal, and gastric cancers", "locations": [{"offset": 16520, "length": 31}]}, {"id": "38079", "infons": {"identifier": "MESH:D061325", "type": "Disease", "valid": true, "normalized": ["D061325"], "database": "ncbi_mesh", "normalized_id": "D061325", "biotype": "disease", "name": "Hereditary Breast and Ovarian Cancer Syndrome", "accession": "@DISEASE_Hereditary_Breast_and_Ovarian_Cancer_Syndrome"}, "text": "breast, ovarian, and uterine cancer", "locations": [{"offset": 16744, "length": 35}]}, {"id": "38080", "infons": {"identifier": "tmVar:c|DEL|1026+5_1026+7|;HGVS:c.1026+5_1026+7del;VariantGroup:79;CorrespondingGene:5889;CorrespondingSpecies:9606", "type": "Variant", "valid": true, "subtype": "DNAMutation", "database": "litvar", "hgvs": "c.1026+5_1026+7del", "gene_ids": [5889], "gene_id": 5889, "species_ids": [9606], "species_id": 9606, "rsids": [], "normalized": ["#5889#c.1026+5_1026+7del", "#5889#"], "normalized_id": "#5889#c.1026+5_1026+7del", "biotype": "variant", "name": "c.1026+5_1026+7del", "accession": "@VARIANT_c.1026+5_1026+7del_RAD51C_human"}, "text": "c.1026+5_1026+7del", "locations": [{"offset": 16823, "length": 18}]}, {"id": "38081", "infons": {"identifier": "MESH:D007938", "type": "Disease", "valid": true, "normalized": ["D007938"], "database": "ncbi_mesh", "normalized_id": "D007938", "biotype": "disease", "name": "Leukemia", "accession": "@DISEASE_Leukemia"}, "text": "leukemia", "locations": [{"offset": 16593, "length": 8}]}, {"id": "38082", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "OC", "locations": [{"offset": 16407, "length": 2}]}, {"id": "38083", "infons": {"identifier": "MESH:D001932", "type": "Disease", "valid": true, "normalized": ["D001932"], "database": "ncbi_mesh", "normalized_id": "D001932", "biotype": "disease", "name": "Brain Neoplasms", "accession": "@DISEASE_Brain_Neoplasms"}, "text": "brain tumor", "locations": [{"offset": 16621, "length": 11}]}, {"id": "38084", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "OC", "locations": [{"offset": 16511, "length": 2}]}, {"id": "38085", "infons": {"identifier": "MESH:D011471", "type": "Disease", "valid": true, "normalized": ["D011471"], "database": "ncbi_mesh", "normalized_id": "D011471", "biotype": "disease", "name": "Prostatic Neoplasms", "accession": "@DISEASE_Prostatic_Neoplasms"}, "text": "PrC", "locations": [{"offset": 16515, "length": 3}]}], "relations": []}, {"infons": {"section_type": "RESULTS", "type": "title_2"}, "offset": 17038, "text": "3.3. MMR Genes Variants and Related Phenotypes", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "RESULTS", "type": "paragraph"}, "offset": 17085, "text": "Variants in MMR genes were identified in two cases with BC. Both women had a high-grade hormone-responsive invasive DC, with onset at 39 and 56 years, respectively, and positive family history for malignancies among their relatives.", "sentences": [], "annotations": [{"id": "38086", "infons": {"identifier": "MESH:D044584", "type": "Disease", "valid": true, "normalized": ["D044584"], "database": "ncbi_mesh", "normalized_id": "D044584", "biotype": "disease", "name": "Carcinoma Ductal", "accession": "@DISEASE_Carcinoma_Ductal"}, "text": "DC", "locations": [{"offset": 17201, "length": 2}]}, {"id": "38087", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "women", "locations": [{"offset": 17150, "length": 5}]}, {"id": "38088", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "malignancies", "locations": [{"offset": 17282, "length": 12}]}, {"id": "38089", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "BC", "locations": [{"offset": 17141, "length": 2}]}], "relations": []}, {"infons": {"section_type": "RESULTS", "type": "title_3"}, "offset": 17318, "text": "3.3.1. MLH1", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "RESULTS", "type": "paragraph"}, "offset": 17330, "text": "P67 patient carrying c.1696T>C in the MLH1 gene reported BC in her mother and PrC in the two maternal uncles (Figure S1e). This rare variant (f = 3.98 x 10-6, gnomAD data), replacing a tyrosine with histidine at codon 566 in the region interacting with EXO1 of the MLH1 protein p.(Tyr566His), is classified as LP by ACMG criteria, reported as VUS in ClinVar, and is still not present in the Insight database .", "sentences": [], "annotations": [{"id": "38090", "infons": {"identifier": "4292", "type": "Gene", "ncbi_homologene": "208", "valid": true, "normalized": [4292], "database": "ncbi_gene", "normalized_id": 4292, "biotype": "gene", "name": "MLH1", "accession": "@GENE_MLH1"}, "text": "MLH1", "locations": [{"offset": 17368, "length": 4}]}, {"id": "38091", "infons": {"identifier": "9156", "type": "Gene", "ncbi_homologene": "31352", "valid": true, "normalized": [9156], "database": "ncbi_gene", "normalized_id": 9156, "biotype": "gene", "name": "EXO1", "accession": "@GENE_EXO1"}, "text": "EXO1", "locations": [{"offset": 17583, "length": 4}]}, {"id": "38092", "infons": {"identifier": "4292", "type": "Gene", "ncbi_homologene": "208", "valid": true, "normalized": [4292], "database": "ncbi_gene", "normalized_id": 4292, "biotype": "gene", "name": "MLH1", "accession": "@GENE_MLH1"}, "text": "MLH1", "locations": [{"offset": 17595, "length": 4}]}, {"id": "38093", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patient", "locations": [{"offset": 17334, "length": 7}]}, {"id": "38094", "infons": {"identifier": "tmVar:c|SUB|T|1696|C;HGVS:c.1696T>C;VariantGroup:9;CorrespondingGene:4292;RS#:730881743;CorrespondingSpecies:9606;CA#:6436", "type": "Variant", "valid": true, "subtype": "DNAMutation", "database": "litvar", "hgvs": "c.1696T>C", "gene_ids": [4292], "gene_id": 4292, "rsids": ["rs730881743"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA6436", "rsid": "rs730881743", "normalized": ["rs730881743##", "#4292#", "CA6436#rs730881743##"], "normalized_id": "rs730881743##", "biotype": "variant", "name": "c.1696T>C", "accession": "@VARIANT_c.1696T>C_MLH1_human"}, "text": "c.1696T>C", "locations": [{"offset": 17351, "length": 9}]}, {"id": "38095", "infons": {"identifier": "MESH:C537419", "type": "Disease", "valid": true, "normalized": ["C537419"], "database": "ncbi_mesh", "normalized_id": "C537419", "biotype": "disease", "name": "Bohring syndrome", "accession": "@DISEASE_Bohring_syndrome"}, "text": "LP", "locations": [{"offset": 17640, "length": 2}]}, {"id": "38096", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "BC", "locations": [{"offset": 17387, "length": 2}]}, {"id": "38097", "infons": {"identifier": "MESH:D011471", "type": "Disease", "valid": true, "normalized": ["D011471"], "database": "ncbi_mesh", "normalized_id": "D011471", "biotype": "disease", "name": "Prostatic Neoplasms", "accession": "@DISEASE_Prostatic_Neoplasms"}, "text": "PrC", "locations": [{"offset": 17408, "length": 3}]}, {"id": "38098", "infons": {"identifier": "tmVar:p|SUB|Y|566|H;HGVS:p.Y566H;VariantGroup:9;CorrespondingGene:4292;RS#:730881743;CorrespondingSpecies:9606;CA#:6436", "type": "Variant", "valid": true, "subtype": "ProteinMutation", "database": "litvar", "hgvs": "p.Y566H", "gene_ids": [4292], "gene_id": 4292, "rsids": ["rs730881743"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA6436", "rsid": "rs730881743", "normalized": ["rs730881743##", "#4292#", "CA6436#rs730881743##"], "normalized_id": "rs730881743##", "biotype": "variant", "name": "p.Y566H", "accession": "@VARIANT_c.1696T>C_MLH1_human"}, "text": "p.(Tyr566His)", "locations": [{"offset": 17608, "length": 13}]}, {"id": "38099", "infons": {"identifier": "tmVar:p|SUB|Y|566|H;HGVS:p.Y566H;VariantGroup:9;CorrespondingGene:4292;RS#:730881743;CorrespondingSpecies:9606;CA#:6436", "type": "Variant", "valid": true, "subtype": "ProteinMutation", "database": "litvar", "hgvs": "p.Y566H", "gene_ids": [4292], "gene_id": 4292, "rsids": ["rs730881743"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA6436", "rsid": "rs730881743", "normalized": ["rs730881743##", "#4292#", "CA6436#rs730881743##"], "normalized_id": "rs730881743##", "biotype": "variant", "name": "p.Y566H", "accession": "@VARIANT_c.1696T>C_MLH1_human"}, "text": "tyrosine with histidine at codon 566", "locations": [{"offset": 17515, "length": 36}]}, {"id": "38100", "infons": {"identifier": "MESH:D065309", "type": "Disease", "valid": true, "normalized": ["D065309"], "database": "ncbi_mesh", "normalized_id": "D065309", "biotype": "disease", "name": "Atypical Squamous Cells of the Cervix", "accession": "@DISEASE_Atypical_Squamous_Cells_of_the_Cervix"}, "text": "VUS", "locations": [{"offset": 17673, "length": 3}]}], "relations": []}, {"infons": {"section_type": "RESULTS", "type": "title_3"}, "offset": 17746, "text": "3.3.2. MSH2", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "RESULTS", "type": "paragraph"}, "offset": 17758, "text": "Proband P53 with the c.182A>C, p.(Gln61Pro) variant in MSH2 gene reported cancer familiarity in both parental branches: PrC in the father and in the two paternal uncles, a not specified neoplastic disease in the third paternal aunt and in her daughter; BC in her mother, uterine cancer in the maternal grandmother, and PrC in the maternal uncle (Figure S1d). This variant, although reported with conflicting interpretation in Insight (VUS vs. P), is classified as LP according to ACMG criteria and has been found in a Lynch Syndrome case with OC and CC.", "sentences": [], "annotations": [{"id": "38101", "infons": {"identifier": "7157", "type": "Gene", "ncbi_homologene": "460", "valid": true, "normalized": [7157], "database": "ncbi_gene", "normalized_id": 7157, "biotype": "gene", "name": "TP53", "accession": "@GENE_TP53"}, "text": "P53", "locations": [{"offset": 17766, "length": 3}]}, {"id": "38102", "infons": {"identifier": "4436", "type": "Gene", "ncbi_homologene": "210", "valid": true, "normalized": [4436], "database": "ncbi_gene", "normalized_id": 4436, "biotype": "gene", "name": "MSH2", "accession": "@GENE_MSH2"}, "text": "MSH2", "locations": [{"offset": 17813, "length": 4}]}, {"id": "38103", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "BC", "locations": [{"offset": 18011, "length": 2}]}, {"id": "38104", "infons": {"identifier": "tmVar:c|SUB|A|182|C;HGVS:c.182A>C;VariantGroup:0;CorrespondingGene:4436;RS#:587779113;CorrespondingSpecies:9606;CA#:19414", "type": "Variant", "valid": true, "subtype": "DNAMutation", "database": "litvar", "hgvs": "c.182A>C", "gene_ids": [4436], "gene_id": 4436, "rsids": ["rs587779113"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA19414", "rsid": "rs587779113", "normalized": ["rs587779113##", "#4436#", "CA19414#rs587779113##"], "normalized_id": "rs587779113##", "biotype": "variant", "name": "c.182A>C", "accession": "@VARIANT_c.182A>C_MSH2_human"}, "text": "c.182A>C", "locations": [{"offset": 17779, "length": 8}]}, {"id": "38105", "infons": {"type": "Disease", "valid": false, "normalized_id": null, "biotype": "disease"}, "text": "CC", "locations": [{"offset": 18308, "length": 2}]}, {"id": "38106", "infons": {"identifier": "MESH:D011471", "type": "Disease", "valid": true, "normalized": ["D011471"], "database": "ncbi_mesh", "normalized_id": "D011471", "biotype": "disease", "name": "Prostatic Neoplasms", "accession": "@DISEASE_Prostatic_Neoplasms"}, "text": "PrC", "locations": [{"offset": 18077, "length": 3}]}, {"id": "38107", "infons": {"identifier": "MESH:D011471", "type": "Disease", "valid": true, "normalized": ["D011471"], "database": "ncbi_mesh", "normalized_id": "D011471", "biotype": "disease", "name": "Prostatic Neoplasms", "accession": "@DISEASE_Prostatic_Neoplasms"}, "text": "PrC", "locations": [{"offset": 17878, "length": 3}]}, {"id": "38108", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "cancer", "locations": [{"offset": 17832, "length": 6}]}, {"id": "38109", "infons": {"identifier": "MESH:D003123", "type": "Disease", "valid": true, "normalized": ["D003123"], "database": "ncbi_mesh", "normalized_id": "D003123", "biotype": "disease", "name": "Colorectal Neoplasms Hereditary Nonpolyposis", "accession": "@DISEASE_Colorectal_Neoplasms_Hereditary_Nonpolyposis"}, "text": "Lynch Syndrome", "locations": [{"offset": 18276, "length": 14}]}, {"id": "38110", "infons": {"identifier": "MESH:D014594", "type": "Disease", "valid": true, "normalized": ["D014594"], "database": "ncbi_mesh", "normalized_id": "D014594", "biotype": "disease", "name": "Uterine Neoplasms", "accession": "@DISEASE_Uterine_Neoplasms"}, "text": "uterine cancer", "locations": [{"offset": 18029, "length": 14}]}, {"id": "38111", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "OC", "locations": [{"offset": 18301, "length": 2}]}, {"id": "38112", "infons": {"identifier": "tmVar:p|SUB|Q|61|P;HGVS:p.Q61P;VariantGroup:0;CorrespondingGene:4436;RS#:587779113;CorrespondingSpecies:9606;CA#:19414", "type": "Variant", "valid": true, "subtype": "ProteinMutation", "database": "litvar", "hgvs": "p.Q61P", "gene_ids": [4436], "gene_id": 4436, "rsids": ["rs587779113"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA19414", "rsid": "rs587779113", "normalized": ["rs587779113##", "#4436#", "CA19414#rs587779113##"], "normalized_id": "rs587779113##", "biotype": "variant", "name": "p.Q61P", "accession": "@VARIANT_c.182A>C_MSH2_human"}, "text": "p.(Gln61Pro)", "locations": [{"offset": 17789, "length": 12}]}, {"id": "38113", "infons": {"identifier": "MESH:D065309", "type": "Disease", "valid": true, "normalized": ["D065309"], "database": "ncbi_mesh", "normalized_id": "D065309", "biotype": "disease", "name": "Atypical Squamous Cells of the Cervix", "accession": "@DISEASE_Atypical_Squamous_Cells_of_the_Cervix"}, "text": "VUS", "locations": [{"offset": 18193, "length": 3}]}, {"id": "38114", "infons": {"identifier": "MESH:D004194", "type": "Disease", "valid": true, "normalized": ["D004194"], "database": "ncbi_mesh", "normalized_id": "D004194", "biotype": "disease", "name": "Disease", "accession": "@DISEASE_Disease"}, "text": "neoplastic disease", "locations": [{"offset": 17944, "length": 18}]}, {"id": "38115", "infons": {"identifier": "MESH:C537419", "type": "Disease", "valid": true, "normalized": ["C537419"], "database": "ncbi_mesh", "normalized_id": "C537419", "biotype": "disease", "name": "Bohring syndrome", "accession": "@DISEASE_Bohring_syndrome"}, "text": "LP", "locations": [{"offset": 18222, "length": 2}]}], "relations": []}, {"infons": {"section_type": "RESULTS", "type": "title_2"}, "offset": 18312, "text": "3.4. Cell Cycle Control Gene Variants and Related Phenotypes", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "RESULTS", "type": "title_3"}, "offset": 18373, "text": "CHEK2 ", "sentences": [], "annotations": [{"id": "38116", "infons": {"identifier": "11200", "type": "Gene", "ncbi_homologene": "38289", "valid": true, "normalized": [11200], "database": "ncbi_gene", "normalized_id": 11200, "biotype": "gene", "name": "CHEK2", "accession": "@GENE_CHEK2"}, "text": "CHEK2", "locations": [{"offset": 18373, "length": 5}]}], "relations": []}, {"infons": {"section_type": "RESULTS", "type": "paragraph"}, "offset": 18381, "text": "The c.470T>C variant was identified in two unrelated patients with unilateral hormone-responsive DC:invasive and moderately differentiated in the one case (P18) and in situ and well-differentiated in the remaining (P46) (Figure S2b). P18 patient also presented other primitive malignancies, including CC at 45 years, OC after 2 years, and GC at the age of 48. In addition, herather had multiple cancers: after a rectal carcinoma, a PrC occurred more recently. Similarly, P46 had a familiarity with rectal carcinoma (maternal uncle) but referred also OC in her younger sister and uterine adenocarcinoma in her mother (Figure 2a). In the same patient, the c.145G>A, p.(Ala49Thr) VUS in the PMS2 gene was found. The CHEK2 c.470T>C, p.(Ile157Thr) variant, located in the Forkhead-associated (FHA) domain of the encoded protein, is known to impair the CHEK2 binding to checkpoint proteins, including CDC25A, in response to DNA damage. It also compromises the dimerization of the protein in a dominant-negative manner and alters the auto-phosphorylation, but does not affect the kinase activity of the protein. In several studies, this variant has been associated with an increased risk of breast cancer, particularly lobular carcinoma, and additional tumors, including renal, prostatic, thyroid, and gastric cancer. Based on co-segregation studies, the penetrance was complete in some families and incomplete in others.", "sentences": [], "annotations": [{"id": "38117", "infons": {"identifier": "5395", "type": "Gene", "ncbi_homologene": "133560", "valid": true, "normalized": [5395], "database": "ncbi_gene", "normalized_id": 5395, "biotype": "gene", "name": "PMS2", "accession": "@GENE_PMS2"}, "text": "PMS2", "locations": [{"offset": 19069, "length": 4}]}, {"id": "38118", "infons": {"identifier": "11200", "type": "Gene", "ncbi_homologene": "38289", "valid": true, "normalized": [11200], "database": "ncbi_gene", "normalized_id": 11200, "biotype": "gene", "name": "CHEK2", "accession": "@GENE_CHEK2"}, "text": "CHEK2", "locations": [{"offset": 19094, "length": 5}]}, {"id": "38119", "infons": {"identifier": "11200", "type": "Gene", "ncbi_homologene": "38289", "valid": true, "normalized": [11200], "database": "ncbi_gene", "normalized_id": 11200, "biotype": "gene", "name": "CHEK2", "accession": "@GENE_CHEK2"}, "text": "CHEK2", "locations": [{"offset": 19228, "length": 5}]}, {"id": "38120", "infons": {"identifier": "993", "type": "Gene", "ncbi_homologene": "1355", "valid": true, "normalized": [993], "database": "ncbi_gene", "normalized_id": 993, "biotype": "gene", "name": "CDC25A", "accession": "@GENE_CDC25A"}, "text": "CDC25A", "locations": [{"offset": 19276, "length": 6}]}, {"id": "38121", "infons": {"identifier": "MESH:D013274", "type": "Disease", "valid": true, "normalized": ["D013274"], "database": "ncbi_mesh", "normalized_id": "D013274", "biotype": "disease", "name": "Stomach Neoplasms", "accession": "@DISEASE_Stomach_Neoplasms"}, "text": "renal, prostatic, thyroid, and gastric cancer", "locations": [{"offset": 19645, "length": 45}]}, {"id": "38122", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "malignancies", "locations": [{"offset": 18658, "length": 12}]}, {"id": "38123", "infons": {"identifier": "MESH:D044584", "type": "Disease", "valid": true, "normalized": ["D044584"], "database": "ncbi_mesh", "normalized_id": "D044584", "biotype": "disease", "name": "Carcinoma Ductal", "accession": "@DISEASE_Carcinoma_Ductal"}, "text": "hormone-responsive DC", "locations": [{"offset": 18459, "length": 21}]}, {"id": "38124", "infons": {"type": "Disease", "valid": false, "normalized_id": null, "biotype": "disease"}, "text": "CC", "locations": [{"offset": 18682, "length": 2}]}, {"id": "38125", "infons": {"identifier": "MESH:D000230", "type": "Disease", "valid": true, "normalized": ["D000230"], "database": "ncbi_mesh", "normalized_id": "D000230", "biotype": "disease", "name": "Adenocarcinoma", "accession": "@DISEASE_Adenocarcinoma"}, "text": "uterine adenocarcinoma", "locations": [{"offset": 18960, "length": 22}]}, {"id": "38126", "infons": {"identifier": "tmVar:c|SUB|T|470|C;HGVS:c.470T>C;VariantGroup:24;CorrespondingGene:11200;RS#:17879961;CorrespondingSpecies:9606;CA#:117630", "type": "Variant", "valid": true, "subtype": "DNAMutation", "database": "litvar", "hgvs": "c.470T>C", "gene_ids": [11200], "gene_id": 11200, "rsids": ["rs17879961"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA117630", "rsid": "rs17879961", "normalized": ["rs17879961##", "#11200#", "CA117630#rs17879961##"], "normalized_id": "rs17879961##", "biotype": "variant", "name": "c.470T>C", "accession": "@VARIANT_p.I157T_CHEK2_human"}, "text": "c.470T>C", "locations": [{"offset": 18385, "length": 8}]}, {"id": "38127", "infons": {"identifier": "MESH:D018275", "type": "Disease", "valid": true, "normalized": ["D018275"], "database": "ncbi_mesh", "normalized_id": "D018275", "biotype": "disease", "name": "Carcinoma Lobular", "accession": "@DISEASE_Carcinoma_Lobular"}, "text": "lobular carcinoma", "locations": [{"offset": 19593, "length": 17}]}, {"id": "38128", "infons": {"identifier": "tmVar:p|SUB|I|157|T;HGVS:p.I157T;VariantGroup:24;CorrespondingGene:11200;RS#:17879961;CorrespondingSpecies:9606;CA#:117630", "type": "Variant", "valid": true, "subtype": "ProteinMutation", "database": "litvar", "hgvs": "p.I157T", "gene_ids": [11200], "gene_id": 11200, "rsids": ["rs17879961"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA117630", "rsid": "rs17879961", "normalized": ["rs17879961##", "#11200#", "CA117630#rs17879961##"], "normalized_id": "rs17879961##", "biotype": "variant", "name": "p.I157T", "accession": "@VARIANT_p.I157T_CHEK2_human"}, "text": "p.(Ile157Thr)", "locations": [{"offset": 19110, "length": 13}]}, {"id": "38129", "infons": {"identifier": "MESH:D011471", "type": "Disease", "valid": true, "normalized": ["D011471"], "database": "ncbi_mesh", "normalized_id": "D011471", "biotype": "disease", "name": "Prostatic Neoplasms", "accession": "@DISEASE_Prostatic_Neoplasms"}, "text": "PrC", "locations": [{"offset": 18813, "length": 3}]}, {"id": "38130", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "OC", "locations": [{"offset": 18931, "length": 2}]}, {"id": "38131", "infons": {"identifier": "tmVar:c|SUB|G|145|A;HGVS:c.145G>A;VariantGroup:1;CorrespondingGene:2956;RS#:745642001;CorrespondingSpecies:9606;CA#:67694", "type": "Variant", "valid": true, "subtype": "DNAMutation", "database": "litvar", "hgvs": "c.145G>A", "gene_ids": [2956], "gene_id": 2956, "rsids": ["rs745642001"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA67694", "rsid": "rs745642001", "normalized": ["rs745642001##", "#2956#", "CA67694#rs745642001##"], "normalized_id": "rs745642001##", "biotype": "variant", "name": "c.145G>A", "accession": "@VARIANT_c.145G>A_MSH6_human"}, "text": "c.145G>A", "locations": [{"offset": 19035, "length": 8}]}, {"id": "38132", "infons": {"type": "Disease", "valid": false, "normalized_id": null, "biotype": "disease"}, "text": "GC", "locations": [{"offset": 18720, "length": 2}]}, {"id": "38133", "infons": {"identifier": "MESH:D012004", "type": "Disease", "valid": true, "normalized": ["D012004"], "database": "ncbi_mesh", "normalized_id": "D012004", "biotype": "disease", "name": "Rectal Neoplasms", "accession": "@DISEASE_Rectal_Neoplasms"}, "text": "rectal carcinoma", "locations": [{"offset": 18793, "length": 16}]}, {"id": "38134", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "tumors", "locations": [{"offset": 19627, "length": 6}]}, {"id": "38135", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "breast cancer", "locations": [{"offset": 19565, "length": 13}]}, {"id": "38136", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "OC", "locations": [{"offset": 18698, "length": 2}]}, {"id": "38137", "infons": {"identifier": "MESH:D012004", "type": "Disease", "valid": true, "normalized": ["D012004"], "database": "ncbi_mesh", "normalized_id": "D012004", "biotype": "disease", "name": "Rectal Neoplasms", "accession": "@DISEASE_Rectal_Neoplasms"}, "text": "rectal carcinoma", "locations": [{"offset": 18879, "length": 16}]}, {"id": "38138", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patient", "locations": [{"offset": 19022, "length": 7}]}, {"id": "38139", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patient", "locations": [{"offset": 18619, "length": 7}]}, {"id": "38140", "infons": {"identifier": "MESH:D065309", "type": "Disease", "valid": true, "normalized": ["D065309"], "database": "ncbi_mesh", "normalized_id": "D065309", "biotype": "disease", "name": "Atypical Squamous Cells of the Cervix", "accession": "@DISEASE_Atypical_Squamous_Cells_of_the_Cervix"}, "text": "VUS", "locations": [{"offset": 19058, "length": 3}]}, {"id": "38141", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 18434, "length": 8}]}, {"id": "38142", "infons": {"identifier": "tmVar:p|SUB|A|49|T;HGVS:p.A49T;VariantGroup:109;CorrespondingGene:4595;RS#:1064793421;CorrespondingSpecies:9606", "type": "Variant", "valid": true, "subtype": "ProteinMutation", "database": "litvar", "hgvs": "p.A49T", "gene_ids": [4595], "gene_id": 4595, "rsids": ["rs1064793421"], "species_ids": [9606], "species_id": 9606, "rsid": "rs1064793421", "normalized": ["rs1064793421##", "#4595#"], "normalized_id": "rs1064793421##", "biotype": "variant", "name": "p.A49T", "accession": "@VARIANT_c.145G>A_MUTYH_human"}, "text": "p.(Ala49Thr)", "locations": [{"offset": 19045, "length": 12}]}, {"id": "38143", "infons": {"identifier": "tmVar:c|SUB|T|470|C;HGVS:c.470T>C;VariantGroup:24;CorrespondingGene:11200;RS#:17879961;CorrespondingSpecies:9606;CA#:117630", "type": "Variant", "valid": true, "subtype": "DNAMutation", "database": "litvar", "hgvs": "c.470T>C", "gene_ids": [11200], "gene_id": 11200, "rsids": ["rs17879961"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA117630", "rsid": "rs17879961", "normalized": ["rs17879961##", "#11200#", "CA117630#rs17879961##"], "normalized_id": "rs17879961##", "biotype": "variant", "name": "c.470T>C", "accession": "@VARIANT_p.I157T_CHEK2_human"}, "text": "c.470T>C", "locations": [{"offset": 19100, "length": 8}]}, {"id": "38144", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "cancers", "locations": [{"offset": 18776, "length": 7}]}], "relations": []}, {"infons": {"section_type": "RESULTS", "type": "paragraph"}, "offset": 19798, "text": "The c.793-1G>A splicing variant was detected in a 46-year-old woman (P68) with papillary thyroid cancer at the age of 27 and first-degree familiarity for BC. She referred osteosarcoma in the son of her unaffected brother, a metachronous bilateral BC in her deceased mother, a PrC and a GC in the maternal uncle and grandfather, respectively. PrC was also present in three paternal uncles, while a fourth paternal uncle deceased with lung cancer. Segregation studies were performed in the brother but not in his young son, who denied his consent, despite his previous diagnosis of osteosarcoma and the detection of the CHEK2 LP variant in his father (Figure S2g). The c.793-1G >A variant occurs in the splicing acceptor site of intron 6, causing an alternative splicing site downstream and a frameshift mutation, which leads to a premature termination codon and a consequent truncated protein p.(Asp265Thrfs*10). This variant has been found in individuals with BC, PrC, and in patients who underwent genetic testing for the high risk of hereditary cancer.", "sentences": [], "annotations": [{"id": "38145", "infons": {"identifier": "11200", "type": "Gene", "ncbi_homologene": "38289", "valid": true, "normalized": [11200], "database": "ncbi_gene", "normalized_id": 11200, "biotype": "gene", "name": "CHEK2", "accession": "@GENE_CHEK2"}, "text": "CHEK2", "locations": [{"offset": 20416, "length": 5}]}, {"id": "38146", "infons": {"identifier": "tmVar:c|SUB|G|793-1|A;HGVS:c.793-1G>A;VariantGroup:15;CorrespondingGene:11200;RS#:730881687;CorrespondingSpecies:9606;CA#:299073", "type": "Variant", "valid": true, "subtype": "DNAMutation", "database": "litvar", "hgvs": "c.793-1G>A", "gene_ids": [11200], "gene_id": 11200, "rsids": ["rs730881687"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA299073", "rsid": "rs730881687", "normalized": ["rs730881687##", "#11200#", "CA299073#rs730881687##"], "normalized_id": "rs730881687##", "biotype": "variant", "name": "c.793-1G>A", "accession": "@VARIANT_c.793_1G>A_CHEK2_human"}, "text": "c.793-1G >A", "locations": [{"offset": 20465, "length": 11}]}, {"id": "38147", "infons": {"identifier": "MESH:D011471", "type": "Disease", "valid": true, "normalized": ["D011471"], "database": "ncbi_mesh", "normalized_id": "D011471", "biotype": "disease", "name": "Prostatic Neoplasms", "accession": "@DISEASE_Prostatic_Neoplasms"}, "text": "PrC", "locations": [{"offset": 20762, "length": 3}]}, {"id": "38148", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "BC", "locations": [{"offset": 19952, "length": 2}]}, {"id": "38149", "infons": {"type": "Disease", "valid": false, "normalized_id": null, "biotype": "disease"}, "text": "GC", "locations": [{"offset": 20084, "length": 2}]}, {"id": "38150", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 20774, "length": 8}]}, {"id": "38151", "infons": {"identifier": "tmVar:c|SUB|G|793-1|A;HGVS:c.793-1G>A;VariantGroup:15;CorrespondingGene:11200;RS#:730881687;CorrespondingSpecies:9606;CA#:299073", "type": "Variant", "valid": true, "subtype": "DNAMutation", "database": "litvar", "hgvs": "c.793-1G>A", "gene_ids": [11200], "gene_id": 11200, "rsids": ["rs730881687"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA299073", "rsid": "rs730881687", "normalized": ["rs730881687##", "#11200#", "CA299073#rs730881687##"], "normalized_id": "rs730881687##", "biotype": "variant", "name": "c.793-1G>A", "accession": "@VARIANT_c.793_1G>A_CHEK2_human"}, "text": "c.793-1G>A", "locations": [{"offset": 19802, "length": 10}]}, {"id": "38152", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "BC", "locations": [{"offset": 20758, "length": 2}]}, {"id": "38153", "infons": {"identifier": "MESH:D011471", "type": "Disease", "valid": true, "normalized": ["D011471"], "database": "ncbi_mesh", "normalized_id": "D011471", "biotype": "disease", "name": "Prostatic Neoplasms", "accession": "@DISEASE_Prostatic_Neoplasms"}, "text": "PrC", "locations": [{"offset": 20074, "length": 3}]}, {"id": "38154", "infons": {"identifier": "MESH:D012516", "type": "Disease", "valid": true, "normalized": ["D012516"], "database": "ncbi_mesh", "normalized_id": "D012516", "biotype": "disease", "name": "Osteosarcoma", "accession": "@DISEASE_Osteosarcoma"}, "text": "osteosarcoma", "locations": [{"offset": 20378, "length": 12}]}, {"id": "38155", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "woman", "locations": [{"offset": 19860, "length": 5}]}, {"id": "38156", "infons": {"identifier": "MESH:D009386", "type": "Disease", "valid": true, "normalized": ["D009386"], "database": "ncbi_mesh", "normalized_id": "D009386", "biotype": "disease", "name": "Neoplastic Syndromes Hereditary", "accession": "@DISEASE_Neoplastic_Syndromes_Hereditary"}, "text": "hereditary cancer", "locations": [{"offset": 20834, "length": 17}]}, {"id": "38157", "infons": {"identifier": "MESH:D012516", "type": "Disease", "valid": true, "normalized": ["D012516"], "database": "ncbi_mesh", "normalized_id": "D012516", "biotype": "disease", "name": "Osteosarcoma", "accession": "@DISEASE_Osteosarcoma"}, "text": "osteosarcoma", "locations": [{"offset": 19969, "length": 12}]}, {"id": "38158", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "BC", "locations": [{"offset": 20045, "length": 2}]}, {"id": "38159", "infons": {"identifier": "MESH:D000077273", "type": "Disease", "valid": true, "normalized": ["D000077273"], "database": "ncbi_mesh", "normalized_id": "D000077273", "biotype": "disease", "name": "Thyroid Cancer Papillary", "accession": "@DISEASE_Thyroid_Cancer_Papillary"}, "text": "papillary thyroid cancer", "locations": [{"offset": 19877, "length": 24}]}, {"id": "38160", "infons": {"identifier": "MESH:D008175", "type": "Disease", "valid": true, "normalized": ["D008175"], "database": "ncbi_mesh", "normalized_id": "D008175", "biotype": "disease", "name": "Lung Neoplasms", "accession": "@DISEASE_Lung_Neoplasms"}, "text": "lung cancer", "locations": [{"offset": 20231, "length": 11}]}], "relations": []}, {"infons": {"section_type": "RESULTS", "type": "paragraph"}, "offset": 20853, "text": "The c.1100del variant was detected in two women (P111 and P112) with bilateral metachronous hormone-responsive DC. Both cases had a post-menopausal onset and positive family history for BC in first and/or second-degree maternal relatives. One of them had also a diffuse mesenteric leiomiomatosis (Figure S2c,e). The c.1100del variant causes a frameshift and premature termination codon, p.(Thr367Metfs*15), responsible for the loss of the response to DNA damage and for the impairment of the CHEK2 kinase activity. This variant has been reported in Li-Fraumeni Syndrome and also in several cancer types as breast, ovarian, prostatic, colon, thyroid malignancies.", "sentences": [], "annotations": [{"id": "38161", "infons": {"identifier": "11200", "type": "Gene", "ncbi_homologene": "38289", "valid": true, "normalized": [11200], "database": "ncbi_gene", "normalized_id": 11200, "biotype": "gene", "name": "CHEK2", "accession": "@GENE_CHEK2"}, "text": "CHEK2", "locations": [{"offset": 21345, "length": 5}]}, {"id": "38162", "infons": {"identifier": "tmVar:c|DEL|1100|;HGVS:c.1100del;VariantGroup:8;CorrespondingGene:11200;RS#:555607708;CorrespondingSpecies:9606;CA#:288251", "type": "Variant", "valid": true, "subtype": "DNAMutation", "database": "litvar", "hgvs": "c.1100del", "gene_ids": [11200], "gene_id": 11200, "rsids": ["rs555607708"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA288251", "rsid": "rs555607708", "normalized": ["rs555607708##", "#11200#", "CA288251#rs555607708##"], "normalized_id": "rs555607708##", "biotype": "variant", "name": "c.1100del", "accession": "@VARIANT_c.1100delC_CHEK2_human"}, "text": "c.1100del", "locations": [{"offset": 20857, "length": 9}]}, {"id": "38163", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "BC", "locations": [{"offset": 21039, "length": 2}]}, {"id": "38164", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "women", "locations": [{"offset": 20895, "length": 5}]}, {"id": "38165", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "breast, ovarian, prostatic, colon, thyroid malignancies", "locations": [{"offset": 21459, "length": 55}]}, {"id": "38166", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "cancer", "locations": [{"offset": 21443, "length": 6}]}, {"id": "38167", "infons": {"identifier": "tmVar:c|DEL|1100|;HGVS:c.1100del;VariantGroup:8;CorrespondingGene:11200;RS#:555607708;CorrespondingSpecies:9606;CA#:288251", "type": "Variant", "valid": true, "subtype": "DNAMutation", "database": "litvar", "hgvs": "c.1100del", "gene_ids": [11200], "gene_id": 11200, "rsids": ["rs555607708"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA288251", "rsid": "rs555607708", "normalized": ["rs555607708##", "#11200#", "CA288251#rs555607708##"], "normalized_id": "rs555607708##", "biotype": "variant", "name": "c.1100del", "accession": "@VARIANT_c.1100delC_CHEK2_human"}, "text": "c.1100del", "locations": [{"offset": 21169, "length": 9}]}, {"id": "38168", "infons": {"identifier": "MESH:D044584", "type": "Disease", "valid": true, "normalized": ["D044584"], "database": "ncbi_mesh", "normalized_id": "D044584", "biotype": "disease", "name": "Carcinoma Ductal", "accession": "@DISEASE_Carcinoma_Ductal"}, "text": "hormone-responsive DC", "locations": [{"offset": 20945, "length": 21}]}, {"id": "38169", "infons": {"identifier": "MESH:D016864", "type": "Disease", "valid": true, "normalized": ["D016864"], "database": "ncbi_mesh", "normalized_id": "D016864", "biotype": "disease", "name": "Li-Fraumeni Syndrome", "accession": "@DISEASE_Li_Fraumeni_Syndrome"}, "text": "Li-Fraumeni Syndrome", "locations": [{"offset": 21402, "length": 20}]}, {"id": "38170", "infons": {"type": "Disease", "valid": false, "normalized_id": null, "biotype": "disease"}, "text": "leiomiomatosis", "locations": [{"offset": 21134, "length": 14}]}], "relations": []}, {"infons": {"section_type": "RESULTS", "type": "paragraph"}, "offset": 21516, "text": "The patient (P12) carrying the c.1136C>G, p.(Ser379Cys), variant had a foot melanoma at 49 years. Her mother had a GC at 45 years, her maternal uncle deceased at 60 years for a PC occurred two years earlier, and her maternal aunt, as well as her grandmother, had a BC. Moreover, her father had head-neck and lung cancer, one of his three sisters a BC, and his brother a lung cancer (Figure S2d). Molecular analysis of this proband identified also a VUS in RAD50 (c.1452+7T>G). The c.1136C>G change replaces a highly conserved serine with cysteine at codon 379 of the CHEK2 protein, p.(Ser379Cys). It is located in exon 11 of the CHEK2 gene, a hot-spot region of 61 base pairs length, where all identified variants are classified as pathogenic (Varsome source). Prediction tools (Mutation Taster, SIFT, Provean) consider this variant as damaging, and, based on ACMG criteria, it can be classified as LP.", "sentences": [], "annotations": [{"id": "38171", "infons": {"identifier": "10111", "type": "Gene", "ncbi_homologene": "38092", "valid": true, "normalized": [10111], "database": "ncbi_gene", "normalized_id": 10111, "biotype": "gene", "name": "RAD50", "accession": "@GENE_RAD50"}, "text": "RAD50", "locations": [{"offset": 21972, "length": 5}]}, {"id": "38172", "infons": {"identifier": "11200", "type": "Gene", "ncbi_homologene": "38289", "valid": true, "normalized": [11200], "database": "ncbi_gene", "normalized_id": 11200, "biotype": "gene", "name": "CHEK2", "accession": "@GENE_CHEK2"}, "text": "CHEK2", "locations": [{"offset": 22083, "length": 5}]}, {"id": "38173", "infons": {"identifier": "11200", "type": "Gene", "ncbi_homologene": "38289", "valid": true, "normalized": [11200], "database": "ncbi_gene", "normalized_id": 11200, "biotype": "gene", "name": "CHEK2", "accession": "@GENE_CHEK2"}, "text": "CHEK2", "locations": [{"offset": 22145, "length": 5}]}, {"id": "38174", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "BC", "locations": [{"offset": 21864, "length": 2}]}, {"id": "38175", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "BC", "locations": [{"offset": 21781, "length": 2}]}, {"id": "38176", "infons": {"identifier": "tmVar:p|SUB|S|379|C;HGVS:p.S379C;VariantGroup:2;CorrespondingGene:11200;RS#:267606211;CorrespondingSpecies:9606;CA#:299080", "type": "Variant", "valid": true, "subtype": "ProteinMutation", "database": "litvar", "hgvs": "p.S379C", "gene_ids": [11200], "gene_id": 11200, "rsids": ["rs267606211"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA299080", "rsid": "rs267606211", "normalized": ["rs267606211##", "#11200#", "CA299080#rs267606211##"], "normalized_id": "rs267606211##", "biotype": "variant", "name": "p.S379C", "accession": "@VARIANT_p.C403S_CHEK2_human"}, "text": "p.(Ser379Cys)", "locations": [{"offset": 22098, "length": 13}]}, {"id": "38177", "infons": {"identifier": "tmVar:p|SUB|S|379|C;HGVS:p.S379C;VariantGroup:2;CorrespondingGene:11200;RS#:267606211;CorrespondingSpecies:9606;CA#:299080", "type": "Variant", "valid": true, "subtype": "ProteinMutation", "database": "litvar", "hgvs": "p.S379C", "gene_ids": [11200], "gene_id": 11200, "rsids": ["rs267606211"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA299080", "rsid": "rs267606211", "normalized": ["rs267606211##", "#11200#", "CA299080#rs267606211##"], "normalized_id": "rs267606211##", "biotype": "variant", "name": "p.S379C", "accession": "@VARIA