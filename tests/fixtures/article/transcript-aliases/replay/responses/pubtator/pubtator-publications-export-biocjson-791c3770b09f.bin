name": "Prostatitis", "accession": "@DISEASE_Prostatitis"}, "text": "prostatic, gastrointestinal, and", "locations": [{"offset": 31694, "length": 32}]}, {"id": "38438", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "breast, gastrointestinal, and brain cancers", "locations": [{"offset": 32458, "length": 43}]}, {"id": "38439", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "BC", "locations": [{"offset": 31928, "length": 2}]}, {"id": "38440", "infons": {"identifier": "MESH:D000077273", "type": "Disease", "valid": true, "normalized": ["D000077273"], "database": "ncbi_mesh", "normalized_id": "D000077273", "biotype": "disease", "name": "Thyroid Cancer Papillary", "accession": "@DISEASE_Thyroid_Cancer_Papillary"}, "text": "papillary thyroid cancer", "locations": [{"offset": 32176, "length": 24}]}, {"id": "38441", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "cancers", "locations": [{"offset": 31675, "length": 7}]}, {"id": "38442", "infons": {"identifier": "MESH:D012516", "type": "Disease", "valid": true, "normalized": ["D012516"], "database": "ncbi_mesh", "normalized_id": "D012516", "biotype": "disease", "name": "Osteosarcoma", "accession": "@DISEASE_Osteosarcoma"}, "text": "osteosarcoma", "locations": [{"offset": 32070, "length": 12}]}, {"id": "38443", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "woman", "locations": [{"offset": 32039, "length": 5}]}, {"id": "38444", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "BC", "locations": [{"offset": 31847, "length": 2}]}, {"id": "38445", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "OC", "locations": [{"offset": 31752, "length": 2}]}, {"id": "38446", "infons": {"identifier": "tmVar:c|SUB|G|793-1|A;HGVS:c.793-1G>A;VariantGroup:15;CorrespondingGene:11200;RS#:730881687;CorrespondingSpecies:9606;CA#:299073", "type": "Variant", "valid": true, "subtype": "DNAMutation", "database": "litvar", "hgvs": "c.793-1G>A", "gene_ids": [11200], "gene_id": 11200, "rsids": ["rs730881687"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA299073", "rsid": "rs730881687", "normalized": ["rs730881687##", "#11200#", "CA299073#rs730881687##"], "normalized_id": "rs730881687##", "biotype": "variant", "name": "c.793-1G>A", "accession": "@VARIANT_c.793_1G>A_CHEK2_human"}, "text": "c.793-1G>A", "locations": [{"offset": 32000, "length": 10}]}, {"id": "38447", "infons": {"identifier": "MESH:C567189", "type": "Disease", "valid": true, "normalized": ["C567189"], "database": "ncbi_mesh", "normalized_id": "C567189", "biotype": "disease", "name": "Li-Fraumeni-Like Syndrome", "accession": "@DISEASE_Li_Fraumeni_Like_Syndrome"}, "text": "Li-Fraumeni like syndrome", "locations": [{"offset": 31634, "length": 25}]}], "relations": []}, {"infons": {"section_type": "DISCUSS", "type": "paragraph"}, "offset": 32576, "text": "CHEK2 LP variants, c.1136C>G, p.(Ser379Cys) and c.1169A>C, p.(Tyr390Ser), were detected in a woman with melanoma (P12) and in a Mullerian sarcoma case (P04), respectively, both referring BC and gastrointestinal cancers in relatives. Previous studies have demonstrated that CHEK2 c.1100del heterozygotes have a two-fold risk of malignant melanoma compared to non-carriers, while no clear associations have emerged between Mullerian sarcomas or, more generally, isolated uterine tumors and CHEK2. Nevertheless, the recurrence of BC and GC and CC in many relatives of these two families was in line with the typical phenotype related to this gene.", "sentences": [], "annotations": [{"id": "38448", "infons": {"identifier": "11200", "type": "Gene", "ncbi_homologene": "38289", "valid": true, "normalized": [11200], "database": "ncbi_gene", "normalized_id": 11200, "biotype": "gene", "name": "CHEK2", "accession": "@GENE_CHEK2"}, "text": "CHEK2", "locations": [{"offset": 32576, "length": 5}]}, {"id": "38449", "infons": {"identifier": "11200", "type": "Gene", "ncbi_homologene": "38289", "valid": true, "normalized": [11200], "database": "ncbi_gene", "normalized_id": 11200, "biotype": "gene", "name": "CHEK2", "accession": "@GENE_CHEK2"}, "text": "CHEK2", "locations": [{"offset": 32849, "length": 5}]}, {"id": "38450", "infons": {"identifier": "11200", "type": "Gene", "ncbi_homologene": "38289", "valid": true, "normalized": [11200], "database": "ncbi_gene", "normalized_id": 11200, "biotype": "gene", "name": "CHEK2", "accession": "@GENE_CHEK2"}, "text": "CHEK2", "locations": [{"offset": 33064, "length": 5}]}, {"id": "38451", "infons": {"type": "Disease", "valid": false, "normalized_id": null, "biotype": "disease"}, "text": "GC", "locations": [{"offset": 33110, "length": 2}]}, {"id": "38452", "infons": {"identifier": "tmVar:c|SUB|A|1169|C;HGVS:c.1169A>C;VariantGroup:25;CorrespondingGene:11200;RS#:200928781;CorrespondingSpecies:9606;CA#:166521", "type": "Variant", "valid": true, "subtype": "DNAMutation", "database": "litvar", "hgvs": "c.1169A>C", "gene_ids": [11200], "gene_id": 11200, "rsids": ["rs200928781"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA166521", "rsid": "rs200928781", "normalized": ["rs200928781##", "#11200#", "CA166521#rs200928781##"], "normalized_id": "rs200928781##", "biotype": "variant", "name": "c.1169A>C", "accession": "@VARIANT_p.Y390C_CHEK2_human"}, "text": "c.1169A>C", "locations": [{"offset": 32624, "length": 9}]}, {"id": "38453", "infons": {"identifier": "MESH:C537371", "type": "Disease", "valid": true, "normalized": ["C537371"], "database": "ncbi_mesh", "normalized_id": "C537371", "biotype": "disease", "name": "Mullerian aplasia", "accession": "@DISEASE_Mullerian_aplasia"}, "text": "Mullerian sarcomas", "locations": [{"offset": 32997, "length": 18}]}, {"id": "38454", "infons": {"identifier": "MESH:D008545", "type": "Disease", "valid": true, "normalized": ["D008545"], "database": "ncbi_mesh", "normalized_id": "D008545", "biotype": "disease", "name": "Melanoma", "accession": "@DISEASE_Melanoma"}, "text": "melanoma", "locations": [{"offset": 32680, "length": 8}]}, {"id": "38455", "infons": {"identifier": "tmVar:c|SUB|C|1136|G;HGVS:c.1136C>G;VariantGroup:2;CorrespondingGene:11200;RS#:267606211;CorrespondingSpecies:9606;CA#:299080", "type": "Variant", "valid": true, "subtype": "DNAMutation", "database": "litvar", "hgvs": "c.1136C>G", "gene_ids": [11200], "gene_id": 11200, "rsids": ["rs267606211"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA299080", "rsid": "rs267606211", "normalized": ["rs267606211##", "#11200#", "CA299080#rs267606211##"], "normalized_id": "rs267606211##", "biotype": "variant", "name": "c.1136C>G", "accession": "@VARIANT_p.C403S_CHEK2_human"}, "text": "c.1136C>G", "locations": [{"offset": 32595, "length": 9}]}, {"id": "38456", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "