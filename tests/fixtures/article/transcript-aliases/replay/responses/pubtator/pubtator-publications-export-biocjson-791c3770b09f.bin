5"], "database": "ncbi_mesh", "normalized_id": "D008545", "biotype": "disease", "name": "Melanoma", "accession": "@DISEASE_Melanoma"}, "text": "malignant melanoma", "locations": [{"offset": 32903, "length": 18}]}, {"id": "38461", "infons": {"identifier": "tmVar:p|SUB|Y|390|S;HGVS:p.Y390S;VariantGroup:25;CorrespondingGene:11200;RS#:200928781;CorrespondingSpecies:9606;CA#:166521", "type": "Variant", "valid": true, "subtype": "ProteinMutation", "database": "litvar", "hgvs": "p.Y390S", "gene_ids": [11200], "gene_id": 11200, "rsids": ["rs200928781"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA166521", "rsid": "rs200928781", "normalized": ["rs200928781##", "#11200#", "CA166521#rs200928781##"], "normalized_id": "rs200928781##", "biotype": "variant", "name": "p.Y390S", "accession": "@VARIANT_p.Y390C_CHEK2_human"}, "text": "p.(Tyr390Ser)", "locations": [{"offset": 32635, "length": 13}]}, {"id": "38462", "infons": {"identifier": "MESH:D014594", "type": "Disease", "valid": true, "normalized": ["D014594"], "database": "ncbi_mesh", "normalized_id": "D014594", "biotype": "disease", "name": "Uterine Neoplasms", "accession": "@DISEASE_Uterine_Neoplasms"}, "text": "uterine tumors", "locations": [{"offset": 33045, "length": 14}]}, {"id": "38463", "infons": {"identifier": "MESH:C537371", "type": "Disease", "valid": true, "normalized": ["C537371"], "database": "ncbi_mesh", "normalized_id": "C537371", "biotype": "disease", "name": "Mullerian aplasia", "accession": "@DISEASE_Mullerian_aplasia"}, "text": "Mullerian sarcoma", "locations": [{"offset": 32704, "length": 17}]}, {"id": "38464", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "woman", "locations": [{"offset": 32669, "length": 5}]}, {"id": "38465", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "BC", "locations": [{"offset": 33103, "length": 2}]}, {"id": "38466", "infons": {"type": "Disease", "valid": false, "normalized_id": null, "biotype": "disease"}, "text": "CC", "locations": [{"offset": 33117, "length": 2}]}], "relations": []}, {"infons": {"section_type": "DISCUSS", "type": "paragraph"}, "offset": 33221, "text": "Recently CHEK2 pathogenic variants have been considered a proven genetic risk factor for male BC. Although many authors have confirmed this association worldwide, the detection of P/LP CHEK2 variants in Italian male BC cases was poor. Despite this data, among our nine mBC cases, one of the three mutated patients, who referred BC and OC among paternal and paternal relatives, carried the c.1367C>T LP variant in CHEK2.", "sentences": [], "annotations": [{"id": "38467", "infons": {"identifier": "11200", "type": "Gene", "ncbi_homologene": "38289", "valid": true, "normalized": [11200], "database": "ncbi_gene", "normalized_id": 11200, "biotype": "gene", "name": "CHEK2", "accession": "@GENE_CHEK2"}, "text": "CHEK2", "locations": [{"offset": 33230, "length": 5}]}, {"id": "38468", "infons": {"identifier": "11200", "type": "Gene", "ncbi_homologene": "38289", "valid": true, "normalized": [11200], "database": "ncbi_gene", "normalized_id": 11200, "biotype": "gene", "name": "CHEK2", "accession": "@GENE_CHEK2"}, "text": "CHEK2", "locations": [{"offset": 33406, "length": 5}]}, {"id": "38469", "infons": {"identifier": "11200", "type": "Gene", "ncbi_homologene": "38289", "valid": true, "normalized": [11200], "database": "ncbi_gene", "normalized_id": 11200, "biotype": "gene", "name": "CHEK2", "accession": "@GENE_CHEK2"}, "text": "CHEK2", "locations": [{"offset": 33634, "length": 5}]}, {"id": "38470", "infons": {"identifier": "5744", "type": "Gene", "ncbi_homologene": "2113", "valid": true, "normalized": [5744], "database": "ncbi_gene", "normalized_id": 5744, "biotype": "gene", "name": "PTHLH", "accession": "@GENE_PTHLH"}, "text": "P/LP", "locations": [{"offset": 33401, "length": 4}]}, {"id": "38471", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "BC", "locations": [{"offset": 33437, "length": 2}]}, {"id": "38472", "infons": {"identifier": "tmVar:c|SUB|C|1367|T;HGVS:c.1367C>T;VariantGroup:110;CorrespondingGene:7486;RS#:1346044;CorrespondingSpecies:9606;CA#:156029", "type": "Variant", "valid": true, "subtype": "DNAMutation", "database": "litvar", "hgvs": "c.1367C>T", "gene_ids": [7486], "gene_id": 7486, "rsids": ["rs1346044"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA156029", "rsid": "rs1346044", "normalized": ["rs1346044##", "#7486#", "CA156029#rs1346044##"], "normalized_id": "rs1346044##", "biotype": "variant", "name": "c.1367C>T", "accession": "@VARIANT_p.C1367R_WRN_human"}, "text": "c.1367C>T", "locations": [{"offset": 33610, "length": 9}]}, {"id": "38473", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "BC", "locations": [{"offset": 33549, "length": 2}]}, {"id": "38474", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "OC", "locations": [{"offset": 33556, "length": 2}]}, {"id": "38475", "infons": {"identifier": "MESH:D018567", "type": "Disease", "valid": true, "normalized": ["D018567"], "database": "ncbi_mesh", "normalized_id": "D018567", "biotype": "disease", "name": "Breast Neoplasms Male", "accession": "@DISEASE_Breast_Neoplasms_Male"}, "text": "mBC", "locations": [{"offset": 33490, "length": 3}]}, {"id": "38476", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 33526, "length": 8}]}, {"id": "38477", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "BC", "locations": [{"offset": 33315, "length": 2}]}], "relations": []}, {"infons": {"section_type": "DISCUSS", "type": "paragraph"}, "offset": 33641, "text": "Finally, the c.470T>C, p.(Ile157Thr) CHEK2 variant, described in BC and many other types of malignancies, was found in a proband with four primary different tumors (BC, OC, CC, and GC), who referred multiple cancers also in her father (RC and PrC). CHEK2 damaging variants have been found in families with multiple primary cancers. However, to our knowledge, a high number of primary tumors has never been described in patients carrying the CHEK2 c.470T>C mutation. Unfortunately, parental segregation studies could not be performed, preventing the investigation of the variant in her affected father.", "sentences": [], "annotations": [{"id": "38478", "infons": {"identifier": "11200", "type": "Gene", "ncbi_homologene": "38289", "valid": true, "normalized": [11200], "database": "ncbi_gene", "normalized_id": 11200, "biotype": "gene", "name": "CHEK2", "accession": "@GENE_CHEK2"}, "text": "CHEK2", "locations": [{"offset": 33678, "length": 5}]}, {"id": "38479", "infons": {"identifier": "11200", "type": "Gene", "ncbi_homologene": "38289", "valid": true, "normalized": [11200], "database": "ncbi_gene", "normalized_id":