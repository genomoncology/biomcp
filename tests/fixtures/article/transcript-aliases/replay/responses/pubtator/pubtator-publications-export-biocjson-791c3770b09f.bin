asms"}, "text": "PrC", "locations": [{"offset": 27502, "length": 3}]}, {"id": "38353", "infons": {"identifier": "MESH:C536108", "type": "Disease", "valid": true, "normalized": ["C536108"], "database": "ncbi_mesh", "normalized_id": "C536108", "biotype": "disease", "name": "N syndrome", "accession": "@DISEASE_N_syndrome"}, "text": "N", "locations": [{"offset": 27711, "length": 1}]}, {"id": "38354", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "LP-fBC", "locations": [{"offset": 27534, "length": 6}]}, {"id": "38355", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "OC", "locations": [{"offset": 27687, "length": 2}]}, {"id": "38356", "infons": {"identifier": "MESH:D065309", "type": "Disease", "valid": true, "normalized": ["D065309"], "database": "ncbi_mesh", "normalized_id": "D065309", "biotype": "disease", "name": "Atypical Squamous Cells of the Cervix", "accession": "@DISEASE_Atypical_Squamous_Cells_of_the_Cervix"}, "text": "VUS", "locations": [{"offset": 27316, "length": 3}]}], "relations": []}, {"infons": {"section_type": "RESULTS", "type": "paragraph"}, "offset": 28119, "text": "Comparison among PC patients could not be performed for the small number of probands with this diagnosis (three cases).", "sentences": [], "annotations": [{"id": "38357", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 28139, "length": 8}]}, {"id": "38358", "infons": {"identifier": "MESH:D010195", "type": "Disease", "valid": true, "normalized": ["D010195"], "database": "ncbi_mesh", "normalized_id": "D010195", "biotype": "disease", "name": "Pancreatitis", "accession": "@DISEASE_Pancreatitis"}, "text": "PC", "locations": [{"offset": 28136, "length": 2}]}], "relations": []}, {"infons": {"section_type": "DISCUSS", "type": "title_1"}, "offset": 28239, "text": "4. Discussion", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "DISCUSS", "type": "paragraph"}, "offset": 28253, "text": "The present study aimed at detecting pathogenic variants related to hereditary cancers by multigene panel testing. In total, 113 consecutive individuals with personal or family history of breast, ovarian, or pancreatic cancer and without P/LP variants in BRCA1 and BRCA2 genes were analyzed. By applying NGS technologies in our cohort, we investigated the frequency of germline deleterious variants in APC, ATM, BARD1, BRIP1, CDH1, CDK4, CDKN2A, CHEK2, EPCAM, MLH1, MRE11, MSH2, MSH6, MUTYH, NBN, PALB2, PMS2, PTEN, RAD50, RAD51C, RAD51D, RECQL1, SMAD4, STK11, and TP53 genes, all involved in DDR system. The choice of including these genes in our panel was based on several considerations.", "sentences": [], "annotations": [{"id": "38359", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 28508, "length": 5}]}, {"id": "38360", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 28518, "length": 5}]}, {"id": "38361", "infons": {"identifier": "324", "type": "Gene", "ncbi_homologene": "30950", "valid": true, "normalized": [324], "database": "ncbi_gene", "normalized_id": 324, "biotype": "gene", "name": "APC", "accession": "@GENE_APC"}, "text": "APC", "locations": [{"offset": 28655, "length": 3}]}, {"id": "38362", "infons": {"identifier": "472", "type": "Gene", "ncbi_homologene": "30952", "valid": true, "normalized": [472], "database": "ncbi_gene", "normalized_id": 472, "biotype": "gene", "name": "ATM", "accession": "@GENE_ATM"}, "text": "ATM", "locations": [{"offset": 28660, "length": 3}]}, {"id": "38363", "infons": {"identifier": "580", "type": "Gene", "ncbi_homologene": "400", "valid": true, "normalized": [580], "database": "ncbi_gene", "normalized_id": 580, "biotype": "gene", "name": "BARD1", "accession": "@GENE_BARD1"}, "text": "BARD1", "locations": [{"offset": 28665, "length": 5}]}, {"id": "38364", "infons": {"identifier": "83990", "type": "Gene", "ncbi_homologene": "32766", "valid": true, "normalized": [83990], "database": "ncbi_gene", "normalized_id": 83990, "biotype": "gene", "name": "BRIP1", "accession": "@GENE_BRIP1"}, "text": "BRIP1", "locations": [{"offset": 28672, "length": 5}]}, {"id": "38365", "infons": {"identifier": "999", "type": "Gene", "ncbi_homologene": "20917", "valid": true, "normalized": [999], "database": "ncbi_gene", "normalized_id": 999, "biotype": "gene", "name": "CDH1", "accession": "@GENE_CDH1"}, "text": "CDH1", "locations": [{"offset": 28679, "length": 4}]}, {"id": "38366", "infons": {"identifier": "1019", "type": "Gene", "ncbi_homologene": "55429", "valid": true, "normalized": [1019], "database": "ncbi_gene", "normalized_id": 1019, "biotype": "gene", "name": "CDK4", "accession": "@GENE_CDK4"}, "text": "CDK4", "locations": [{"offset": 28685, "length": 4}]}, {"id": "38367", "infons": {"identifier": "1029", "type": "Gene", "ncbi_homologene": "55430", "valid": true, "normalized": [1029], "database": "ncbi_gene", "normalized_id": 1029, "biotype": "gene", "name": "CDKN2A", "accession": "@GENE_CDKN2A"}, "text": "CDKN2A", "locations": [{"offset": 28691, "length": 6}]}, {"id