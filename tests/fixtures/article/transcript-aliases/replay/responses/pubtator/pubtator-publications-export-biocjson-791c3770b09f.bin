ons": {"identifier": "5892", "type": "Gene", "ncbi_homologene": "2156", "valid": true, "normalized": [5892], "database": "ncbi_gene", "normalized_id": 5892, "biotype": "gene", "name": "RAD51D", "accession": "@GENE_RAD51D"}, "text": "RAD51D", "locations": [{"offset": 28784, "length": 6}]}, {"id": "38382", "infons": {"identifier": "5965", "type": "Gene", "ncbi_homologene": "56279", "valid": true, "normalized": [5965], "database": "ncbi_gene", "normalized_id": 5965, "biotype": "gene", "name": "RECQL", "accession": "@GENE_RECQL"}, "text": "RECQL1", "locations": [{"offset": 28792, "length": 6}]}, {"id": "38383", "infons": {"identifier": "4089", "type": "Gene", "ncbi_homologene": "31310", "valid": true, "normalized": [4089], "database": "ncbi_gene", "normalized_id": 4089, "biotype": "gene", "name": "SMAD4", "accession": "@GENE_SMAD4"}, "text": "SMAD4", "locations": [{"offset": 28800, "length": 5}]}, {"id": "38384", "infons": {"identifier": "6794", "type": "Gene", "ncbi_homologene": "393", "valid": true, "normalized": [6794], "database": "ncbi_gene", "normalized_id": 6794, "biotype": "gene", "name": "STK11", "accession": "@GENE_STK11"}, "text": "STK11", "locations": [{"offset": 28807, "length": 5}]}, {"id": "38385", "infons": {"identifier": "7157", "type": "Gene", "ncbi_homologene": "460", "valid": true, "normalized": [7157], "database": "ncbi_gene", "normalized_id": 7157, "biotype": "gene", "name": "TP53", "accession": "@GENE_TP53"}, "text": "TP53", "locations": [{"offset": 28818, "length": 4}]}, {"id": "38386", "infons": {"identifier": "5744", "type": "Gene", "ncbi_homologene": "2113", "valid": true, "normalized": [5744], "database": "ncbi_gene", "normalized_id": 5744, "biotype": "gene", "name": "PTHLH", "accession": "@GENE_PTHLH"}, "text": "P/LP", "locations": [{"offset": 28491, "length": 4}]}, {"id": "38387", "infons": {"identifier": "MESH:D009386", "type": "Disease", "valid": true, "normalized": ["D009386"], "database": "ncbi_mesh", "normalized_id": "D009386", "biotype": "disease", "name": "Neoplastic Syndromes Hereditary", "accession": "@DISEASE_Neoplastic_Syndromes_Hereditary"}, "text": "hereditary cancers", "locations": [{"offset": 28321, "length": 18}]}, {"id": "38388", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "breast, ovarian, or pancreatic cancer", "locations": [{"offset": 28441, "length": 37}]}], "relations": []}, {"infons": {"section_type": "DISCUSS", "type": "paragraph"}, "offset": 28944, "text": "The DNA damage response plays a critical role in maintaining genomic stability, and hereditary mutations in DDR genes often confer cancer susceptibility. Bi-allelic mutations in DSBR genes and in other DDR genes are indeed the basis of cancer-prone recessive hereditary syndromes, such as Ataxia-Telangiectasia, Nijmegen Breakage Syndrome, and Fanconi Anemia. Moreover, alterations in the MMR genes result in Lynch Syndrome, leading to an increased incidence of gastrointestinal, endometrial, and ovarian cancers.", "sentences": [], "annotations": [{"id": "38389", "infons": {"identifier": "MESH:D005767", "type": "Disease", "valid": true, "normalized": ["D005767"], "database": "ncbi_mesh", "normalized_id": "D005767", "biotype": "disease", "name": "Gastrointestinal Diseases", "accession": "@DISEASE_Gastrointestinal_Diseases"}, "text": "gastrointestinal, endometrial, and ovarian cancers", "locations": [{"offset": 29406, "length": 50}]}, {"id": "38390", "infons": {"identifier": "MESH:D001260", "type": "Disease", "valid": true, "normalized": ["D001260"], "database": "ncbi_mesh", "normalized_id": "D001260", "biotype": "disease", "name": "Ataxia Telangiectasia", "accession": "@DISEASE_Ataxia_Telangiectasia"}, "text": "Ataxia-Telangiectasia", "locations": [{"offset": 29233, "length": 21}]}, {"id": "38391", "infons": {"identifier": "MESH:D009386", "type": "Disease", "valid": true, "normalized": ["D009386"], "database": "ncbi_mesh", "normalized_id": "D009386", "biotype": "disease", "name": "Neoplastic Syndromes Hereditary", "accession": "@DISEASE_Neoplastic_Syndromes_Hereditary"}, "text": "recessive hereditary syndromes", "locations": [{"offset": 29193, "length": 30}]}, {"id": "38392", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "cancer", "locations": [{"offset": 29180, "length": 6}]}, {"id": "38393", "infons": {"identifier": "MESH:D003123", "type": "Disease", "valid": true, "normalized": ["D003123"], "database": "ncbi_mesh", "normalized_id": "D003123", "biotype": "disease", "name": "Colorectal Neoplasms Hereditary Nonpolyposis", "accession": "@DISEASE_Colorectal_Neoplasms_Hereditary_Nonpolyposis"}, "text": "Lynch Syndrome", "locations": [{"offset": 29353, "length": 14}]}, {"id": "38394", "infons": {"identifier": "MESH:D005199", "type": "Disease", "valid": true, "normalized": ["D005199"], "database": "ncbi_mesh", "normalized_id": "D005199", "biotype": "disease", "name": "Fanconi Anemia", "accession": "@DISEASE_Fanconi_Anemia"}, "text": "Fanconi Anemia", "locations": [{"offset": 29288, "length": 14}]}, {"id": "38395", "infons": {"identifier": "MESH:D049932", "type": "Disease", "valid": true, "normalized": ["D049932"], "database": "ncbi_mesh", "normalized_id": "D049932", "biotype": "disease", "name": "Nijmegen Breakage Syndrome", "accession": "@DISEASE_Nijmegen_Breakage_Syndrome"}, "text": "Nijmegen Breakage Syndrome", "locations": [{"offset": 29256, "length": 26}]}, {"id": "38396", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "cancer", "locations": [{"offset": 29075, "length": 6}]}], "relations": []}, {"infons": {"section_type": "DISCUSS", "type": "paragraph"}, "offset": 29460, "text": "Most chemotherapy agents currently used in cancer therapy cause DNA damage. DDR pathway inhibitors are now used to make cancer cells more sensitive to chemotherapy:an approach called synthetic lethality. In the era of PARP inhibitors, employed in BRCA carriers with OC and metastatic BC, the identification of further potential targets in other HRR (Homologous Recombination Repair) genes could provide new therapeutic opportunities for this and other cancers related to defects in DDR genes.", "sentences": [], "annotations": [{"id": "38397", "infons": {"identifier": "142", "type": "Gene", "ncbi_homologene": "1222", "valid": true, "normalized": [142], "database": "ncbi_gene", "normalized_id": 142, "biotype": "gene", "name": "PARP1", "accession": "@GENE_PARP1"}, "text": "PARP", "locations": [{"offset": 29678, "length": 4}]}, {"id": "38398", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA", "locations": [{"offset": 29707, "length": 4}]}, {"id": "38399", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "cancers", "locations": [{"offset": 29912, "length": 7}]}, {"id": "38400", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "OC", "locations": [{"offset": 29726, "length": 2}]}, {"id": "38401", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "cancer", "locations": [{"offset": 29580, "length": 6}]}, {"id": "38402", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "cancer", "locations": [{"offset": 29503, "length": 6}]}, {"id": "38403", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "BC", "locations": [{"offset": 29744, "length": 2}]}], "relations": []}, {"infons": {"section_type": "DISCUSS", "type": "paragraph"}, "offset": 29955, "text": "Genetic testing for hereditary cancer predisposition has evolved rapidly. Many genes included in multigene panels have inaccurate estimations about the degree of associated cancer risk, and there is no consensus on when to test a particular gene or how to manage an identified P/LP variant. A survey conducted in 61 centers from 20 countries by the clinical group of ENIGMA (Evidence-Based Network for the Interpretation of Germline Mutant Alleles) in 2018 showed that, beyond BRCA1/2, only a small number of genes are currently analyzed worldwide, and management guidelines are limited. On the other hand, the clinical utility of detecting pathogenic germline variants in high and moderate penetrance genes is strong, as recommended by NCCN guidelines for cancer prevention, surveillance, and management.", "sentences": [], "annotations": [{"id": "38404", "infons": {"identifier": "5744", "type": "Gene", "ncbi_homologene": "2113", "valid": true, "normalized": [5744], "database": "ncbi_gene", "normalized_id": 5744, "biotype": "gene", "name": "PTHLH", "accession": "@GENE_PTHLH"}, "text": "P/LP", "locations": [{"offset": 30232, "length": 4}]}, {"id": "38406", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "cancer", "locations": [{"offset": 30712, "length": 6}]}, {"id": "38407", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "cancer", "locations": [{"offset": 30128, "length": 6}]}, {"id": "38408", "infons": {"identifier": "MESH:D009386", "type": "Disease", "valid": true, "normalized": ["D009386"], "database": "ncbi_mesh", "normalized_id": "D009386", "biotype": "disease", "name": "Neoplastic Syndromes Hereditary", "accession": "@DISEASE_Neoplastic_Syndromes_Hereditary"}, "text": "hereditary cancer", "locations": [{"offset": 29975, "length": 17}]}], "relations": []}, {"infons": {"section_type": "DISCUSS", "type": "paragraph"}, "offset": 30761, "text": "In total, 14 different P/LP variants in 6/25 DDR pathway genes were identified in 16 probands. Despite the rarity of each damaging mutation, the overall pathogenic variants rate in these 25 DDR genes was 14% (16/113 unrelated BRCA1/2-negative cases). Moreover, 23 probands carried VUS (20%), whereas 74 (66%) were negative (Figure 1a). In several NGS studies of patients with BC and/or OC, beyond BRCA1 and BRCA2, CHEK2 has been one of the most frequently mutated genes. This data was confirmed in our sample, in which 7.1% (8/113) of analyzed patients were found carriers of deleterious mutations in the CHEK2 gene. RAD51C, with a frequency of 2.6% (3/113), was the other most mutated gene in our patients. These data supported the rationale of including this gene in the NGS panels for the assessment of BC/OC risk.", "sentences": [], "annotations": [{"id": "38409", "infons": {"identifier": "672", "type": "Gene", "ncbi_homologene": "5276", "valid": true, "normalized": [672], "database": "ncbi_gene", "normalized_id": 672, "biotype": "gene", "name": "BRCA1", "accession": "@GENE_BRCA1"}, "text": "BRCA1", "locations": [{"offset": 31158, "length": 5}]}, {"id": "38410", "infons": {"identifier": "675", "type": "Gene", "ncbi_homologene": "41", "valid": true, "normalized": [675], "database": "ncbi_gene", "normalized_id": 675, "biotype": "gene", "name": "BRCA2", "accession": "@GENE_BRCA2"}, "text": "BRCA2", "locations": [{"offset": 31168, "length": 5}]}, {"id": "38411", "infons": {"identifier": "11200", "type": "Gene", "ncbi_homologene": "38289", "valid": true, "normalized": [11200], "database": "ncbi_gene", "normalized_id": 11200, "biotype": "gene", "name": "CHEK2", "accession": "@GENE_CHEK2"}, "text": "CHEK2", "locations": [{"offset": 31175, "length": 5}]}, {"id": "38412", "infons": {"identifier": "11200", "type": "Gene", "ncbi_homologene": "38289", "valid": true, "normalized": [11200], "database": "ncbi_gene", "normalized_id": 11200, "biotype": "gene", "name": "CHEK2", "accession": "@GENE_CHEK2"}, "text": "CHEK2", "locations": [{"offset": 31366, "length": 5}]}, {"id": "38413", "infons": {"identifier": "5889", "type": "Gene", "ncbi_homologene": "14238", "valid": true, "normalized": [5889], "database": "ncbi_gene", "normalized_id": 5889, "biotype": "gene", "name": "RAD51C", "accession": "@GENE_RAD51C"}, "text": "RAD51C", "locations": [{"offset": 31378, "length": 6}]}, {"id": "38414", "infons": {"identifier": "5744", "type": "Gene", "ncbi_homologene": "2113", "valid": true, "normalized": [5744], "database": "ncbi_gene", "normalized_id": 5744, "biotype": "gene", "name": "PTHLH", "accession": "@GENE_PTHLH"}, "text": "P/LP", "locations": [{"offset": 30784, "length": 4}]}, {"id": "38416", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "OC", "locations": [{"offset": 31147, "length": 2}]}, {"id": "38417", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 31123, "length": 8}]}, {"id": "38418", "infons": {"identifier": "MESH:D065309", "type": "Disease", "valid": true, "normalized": ["D065309"], "database": "ncbi_mesh", "normalized_id": "D065309", "biotype": "disease", "name": "Atypical Squamous Cells of the Cervix", "accession": "@DISEASE_Atypical_Squamous_Cells_of_the_Cervix"}, "text": "VUS", "locations": [{"offset": 31042, "length": 3}]}, {"id": "38419", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 31459, "length": 8}]}, {"id": "38420", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 31305, "length": 8}]}, {"id": "38421", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "BC", "locations": [{"offset": 31137, "length": 2}]}, {"id": "38422", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "BC/OC", "locations": [{"offset": 31567, "length": 5}]}], "relations": []}, {"infons": {"section_type": "DISCUSS", "type": "paragraph"}, "offset": 31579, "text": "Germline CHEK2 P/LP variants have been associated with Li-Fraumeni like syndrome, BC, and other cancers, including prostatic, gastrointestinal, and, although still debated, OC. In our study, P/LP variants in CHEK2 were detected in women with monolateral and bilateral BC, who referred at least one or more different types of malignancies, including BC, OC, and gastrointestinal cancers, in their relatives. Moreover, the c.793-1G>A variant was identified in a woman with a family history of osteosarcoma and young-onset BC that suggested a Li-Fraumeni like syndrome. Intriguingly, the proband had papillary thyroid cancer, recently described in CHEK2 patients. Unfortunately, segregation studies could not be performed in the deceased parents, and we could not determine if the variant, detected also in her asymptomatic brother, was inherited from the maternal branch, in which breast, gastrointestinal, and brain cancers occurred, or from the paternal side, where three paternal uncles had PrC.", "sentences": [], "annotations": [{"id": "38423", "infons": {"identifier": "11200", "type": "Gene", "ncbi_homologene": "38289", "valid": true, "normalized": [11200], "database": "ncbi_gene", "normalized_id": 11200, "biotype": "gene", "name": "CHEK2", "accession": "@GENE_CHEK2"}, "text": "CHEK2", "locations": [{"offset": 31588, "length": 5}]}, {"id": "38424", "infons": {"identifier": "11200", "type": "Gene", "ncbi_homologene": "38289", "valid": true, "normalized": [11200], "database": "ncbi_gene", "normalized_id": 11200, "biotype": "gene", "name": "CHEK2", "accession": "@GENE_CHEK2"}, "text": "CHEK2", "locations": [{"offset": 31787, "length": 5}]}, {"id": "38425", "infons": {"identifier": "11200", "type": "Gene", "ncbi_homologene": "38289", "valid": true, "normalized": [11200], "database": "ncbi_gene", "normalized_id": 11200, "biotype": "gene", "name": "CHEK2", "accession": "@GENE_CHEK2"}, "text": "CHEK2", "locations": [{"offset": 32224, "length": 5}]}, {"id": "38426", "infons": {"identifier": "5744", "type": "Gene", "ncbi_homologene": "2113", "valid": true, "normalized": [5744], "database": "ncbi_gene", "normalized_id": 5744, "biotype": "gene", "name": "PTHLH", "accession": "@GENE_PTHLH"}, "text": "P/LP", "locations": [{"offset": 31770, "length": 4}]}, {"id": "38427", "infons": {"identifier": "5744", "type": "Gene", "ncbi_homologene": "2113", "valid": true, "normalized": [5744], "database": "ncbi_gene", "normalized_id": 5744, "biotype": "gene", "name": "PTHLH", "accession": "@GENE_PTHLH"}, "text": "P/LP", "locations": [{"offset": 31594, "length": 4}]}, {"id": "38428", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "women", "locations": [{"offset": 31810, "length": 5}]}, {"id": "38429", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "malignancies", "locations": [{"offset": 31904, "length": 12}]}, {"id": "38430", "infons": {"identifier": "MESH:D011471", "type": "Disease", "valid": true, "normalized": ["D011471"], "database": "ncbi_mesh", "normalized_id": "D011471", "biotype": "disease", "name": "Prostatic Neoplasms", "accession": "@DISEASE_Prostatic_Neoplasms"}, "text": "PrC.", "locations": [{"offset": 32571, "length": 4}]}, {"id": "38431", "infons": {"identifier": "MESH:D005770", "type": "Disease", "valid": true, "normalized": ["D005770"], "database": "ncbi_mesh", "normalized_id": "D005770", "biotype": "disease", "