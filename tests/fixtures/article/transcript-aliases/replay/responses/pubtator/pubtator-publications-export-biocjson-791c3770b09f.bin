": [{"offset": 21547, "length": 9}]}, {"id": "38182", "infons": {"identifier": "MESH:D065309", "type": "Disease", "valid": true, "normalized": ["D065309"], "database": "ncbi_mesh", "normalized_id": "D065309", "biotype": "disease", "name": "Atypical Squamous Cells of the Cervix", "accession": "@DISEASE_Atypical_Squamous_Cells_of_the_Cervix"}, "text": "VUS", "locations": [{"offset": 21965, "length": 3}]}, {"id": "38183", "infons": {"identifier": "MESH:C537419", "type": "Disease", "valid": true, "normalized": ["C537419"], "database": "ncbi_mesh", "normalized_id": "C537419", "biotype": "disease", "name": "Bohring syndrome", "accession": "@DISEASE_Bohring_syndrome"}, "text": "LP", "locations": [{"offset": 22415, "length": 2}]}, {"id": "38184", "infons": {"identifier": "tmVar:p|SUB|S|379|C;HGVS:p.S379C;VariantGroup:2;CorrespondingGene:11200;RS#:267606211;CorrespondingSpecies:9606;CA#:299080", "type": "Variant", "valid": true, "subtype": "ProteinMutation", "database": "litvar", "hgvs": "p.S379C", "gene_ids": [11200], "gene_id": 11200, "rsids": ["rs267606211"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA299080", "rsid": "rs267606211", "normalized": ["rs267606211##", "#11200#", "CA299080#rs267606211##"], "normalized_id": "rs267606211##", "biotype": "variant", "name": "p.S379C", "accession": "@VARIANT_p.C403S_CHEK2_human"}, "text": "p.(Ser379Cys)", "locations": [{"offset": 21558, "length": 13}]}, {"id": "38185", "infons": {"identifier": "MESH:D010195", "type": "Disease", "valid": true, "normalized": ["D010195"], "database": "ncbi_mesh", "normalized_id": "D010195", "biotype": "disease", "name": "Pancreatitis", "accession": "@DISEASE_Pancreatitis"}, "text": "PC", "locations": [{"offset": 21693, "length": 2}]}, {"id": "38186", "infons": {"identifier": "MESH:D008545", "type": "Disease", "valid": true, "normalized": ["D008545"], "database": "ncbi_mesh", "normalized_id": "D008545", "biotype": "disease", "name": "Melanoma", "accession": "@DISEASE_Melanoma"}, "text": "foot melanoma", "locations": [{"offset": 21587, "length": 13}]}, {"id": "38187", "infons": {"identifier": "MESH:D008175", "type": "Disease", "valid": true, "normalized": ["D008175"], "database": "ncbi_mesh", "normalized_id": "D008175", "biotype": "disease", "name": "Lung Neoplasms", "accession": "@DISEASE_Lung_Neoplasms"}, "text": "lung cancer", "locations": [{"offset": 21886, "length": 11}]}, {"id": "38188", "infons": {"identifier": "tmVar:c|SUB|T|1452+7|G;HGVS:c.1452+7T>G;VariantGroup:87;CorrespondingGene:10111;CorrespondingSpecies:9606", "type": "Variant", "valid": true, "subtype": "DNAMutation", "database": "litvar", "hgvs": "c.1452+7T>G", "gene_ids": [10111], "gene_id": 10111, "species_ids": [9606], "species_id": 9606, "rsids": [], "normalized": ["#10111#c.1452+7T>G", "#10111#"], "normalized_id": "#10111#c.1452+7T>G", "biotype": "variant", "name": "c.1452+7T>G", "accession": "@VARIANT_c.1452+7T>G_RAD50_human"}, "text": "c.1452+7T>G", "locations": [{"offset": 21979, "length": 11}]}, {"id": "38189", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patient", "locations": [{"offset": 21520, "length": 7}]}], "relations": []}, {"infons": {"section_type": "RESULTS", "type": "paragraph"}, "offset": 22419, "text": "The c.1169A>C variant was found in a patient (P04) with a Mullerian sarcoma at the age of 47 and BC in her relatives. Her mother, her sister, and a maternal cousin indeed had BC at 47, 57, and 23 years, respectively. Two maternal uncles had also malignancies:one pulmonary and the other colorectal. However, colon cancer familiarity was stronger among paternal relatives, occurring in her father, uncle, and grandfather (Figure S2a). The c.1169A>C change replaces a highly conserved tyrosine with serine at codon 390 of the kinase domain of the protein, p.(Tyr390Ser). In functional studies, p.(Tyr390Ser) CHEK2 protein has not exhibited any kinase activity. This variant has been found in individuals with a personal and/or family history of breast and/or ovarian cancer and, rarely, in the general population (f = 2.4 x 10-5, gnomAD data).", "sentences": [], "annotations": [{"id": "38190", "infons": {"identifier": "11200", "type": "Gene", "ncbi_homologene": "38289", "valid": true, "normalized": [11200], "database": "ncbi_gene", "normalized_id": 11200, "biotype": "gene", "name": "CHEK2", "accession": "@GENE_CHEK2"}, "text": "CHEK2", "locations": [{"offset": 23025, "length": 5}]}, {"id": "38191", "infons": {"identifier": "tmVar:c|SUB|A|1169|C;HGVS:c.1169A>C;VariantGroup:25;CorrespondingGene:11200;RS#:200928781;CorrespondingSpecies:9606;CA#:166521", "type": "Variant", "valid": true, "subtype": "DNAMutation", "database": "litvar", "hgvs": "c.1169A>C", "gene_ids": [11200], "gene_id": 11200, "rsids": ["rs200928781"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA166521", "rsid": "rs200928781", "normalized": ["rs200928781##", "#11200#", "CA166521#rs200928781##"], "normalized_id": "rs200928781##", "biotype": "variant", "name": "c.1169A>C", "accession": "@VARIANT_p.Y390C_CHEK2_human"}, "text": "c.1169A>C", "locations": [{"offset": 22857, "length": 9}]}, {"id": "38192", "infons": {"identifier": "tmVar:c|SUB|A|1169|C;HGVS:c.1169A>C;VariantGroup:25;CorrespondingGene:11200;RS#:200928781;CorrespondingSpecies:9606;CA#:166521", "type": "Variant", "valid": true, "subtype": "DNAMutation", "database": "litvar", "hgvs": "c.1169A>C", "gene_ids": [11200], "gene_id": 11200, "rsids": ["rs200928781"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA166521", "rsid": "rs200928781", "normalized": ["rs200928781##", "#11200#", "CA166521#rs200928781##"], "normalized_id": "rs200928781##", "biotype": "variant", "name": "c.1169A>C", "accession": "@VARIANT_p.Y390C_CHEK2_human"}, "text": "c.1169A>C", "locations": [{"offset": 22423, "length": 9}]}, {"id": "38193", "infons": {"identifier": "MESH:D061325", "type": "Disease", "valid": true, "normalized": ["D061325"], "database": "ncbi_mesh", "normalized_id": "D061325", "biotype": "disease", "name": "Hereditary Breast and Ovarian Cancer Syndrome", "accession": "@DISEASE_Hereditary_Breast_and_Ovarian_Cancer_Syndrome"}, "text": "breast and/or ovarian cancer", "locations": [{"offset": 23162, "length": 28}]}, {"id": "38194", "infons": {"identifier": "MESH:D008171", "type": "Disease", "valid": true, "normalized": ["D008171"], "database": "ncbi_mesh", "normalized_id": "D008171", "biotype": "disease", "name": "Lung Diseases", "accession": "@DISEASE_Lung_Diseases"}, "text": "pulmonary", "locations": [{"offset": 22682, "length": 9}]}, {"id": "38195", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "BC", "locations": [{"offset": 22594, "length": 2}]}, {"id": "38196", "infons": {"identifier": "tmVar:p|SUB|Y|390|S;HGVS:p.Y390S;VariantGroup:25;CorrespondingGene:11200;RS#:200928781;CorrespondingSpecies:9606;CA#:166521", "type": "Variant", "valid": true, "subtype": "ProteinMutation", "database": "litvar", "hgvs": "p.Y390S", "gene_ids": [11200], "gene_id": 11200, "rsids": ["rs200928781"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA166521", "rsid": "rs200928781", "normalized": ["rs200928781##", "#11200#", "CA166521#rs200928781##"], "normalized_id": "rs200928781##", "biotype": "variant", "name": "p.Y390S", "accession": "@VARIANT_p.Y390C_CHEK2_human"}, "text": "p.(Tyr390Ser)", "locations": [{"offset": 22973, "length": 13}]}, {"id": "38197", "infons": {"identifier": "MESH:D015179", "type": "Disease", "valid": true, "normalized": ["D015179"], "database": "ncbi_mesh", "normalized_id": "D015179", "biotype": "disease", "name": "Colorectal Neoplasms", "accession": "@DISEASE_Colorectal_Neoplasms"}, "text": "colon cancer", "locations": [{"offset": 22727, "length": 12}]}, {"id": "38198", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "BC", "locations": [{"offset": 22516, "length": 2}]}, {"id": "38199", "infons": {"identifier": "MESH:C537371", "type": "Disease", "valid": true, "normalized": ["C537371"], "database": "ncbi_mesh", "normalized_id": "C537371", "biotype": "disease", "name": "Mullerian aplasia", "accession": "@DISEASE_Mullerian_aplasia"}, "text": "Mullerian sarcoma", "locations": [{"offset": 22477, "length": 17}]}, {"id": "38200", "infons": {"identifier": "tmVar:p|SUB|Y|390|S;HGVS:p.Y390S;VariantGroup:25;CorrespondingGene:11200;RS#:200928781;CorrespondingSpecies:9606;CA#:166521", "type": "Variant", "valid": true, "subtype": "ProteinMutation", "database": "litvar", "hgvs": "p.Y390S", "gene_ids": [11200], "gene_id": 11200, "rsids": ["rs200928781"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA166521", "rsid": "rs200928781", "normalized": ["rs200928781##", "#11200#", "CA166521#rs200928781##"], "normalized_id": "rs200928781##", "biotype": "variant", "name": "p.Y390S", "accession": "@VARIANT_p.Y390C_CHEK2_human"}, "text": "tyrosine with serine at codon 390", "locations": [{"offset": 22902, "length": 33}]}, {"id": "38201", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "malignancies", "locations": [{"offset": 22665, "length": 12}]}, {"id": "38202", "infons": {"identifier": "MESH:D015179", "type": "Disease", "valid": true, "normalized": ["D015179"], "database": "ncbi_mesh", "normalized_id": "D015179", "biotype": "disease", "name": "Colorectal Neoplasms", "accession": "@DISEASE_Colorectal_Neoplasms"}, "text": "colorectal", "locations": [{"offset": 22706, "length": 10}]}, {"id": "38203", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patient", "locations": [{"offset": 22456, "length": 7}]}, {"id": "38204", "infons": {"identifier": "tmVar:p|SUB|Y|390|S;HGVS:p.Y390S;VariantGroup:25;CorrespondingGene:11200;RS#:200928781;CorrespondingSpecies:9606;CA#:166521", "type": "Variant", "valid": true, "subtype": "ProteinMutation", "database": "litvar", "hgvs": "p.Y390S", "gene_ids": [11200], "gene_id": 11200, "rsids": ["rs200928781"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA166521", "rsid": "rs200928781", "normalized": ["rs200928781##", "#11200#", "CA166521#rs200928781##"], "normalized_id": "rs200928781##", "biotype": "variant", "name": "p.Y390S", "accession": "@VARIANT_p.Y390C_CHEK2_human"}, "text": "p.(Tyr390Ser)", "locations": [{"offset": 23011, "length": 13}]}], "relations": []}, {"infons": {"section_type": "RESULTS", "type": "paragraph"}, "offset": 23267, "text": "The c.1367C>T variant in the CHEK2 gene was detected in a male proband (P60) with an in situ cribriform carcinoma at the age of 71 years and familiarity, both maternal and paternal, for BC and OC (Figure S2f). The c.1367C>T change replaces serine with leucine at codon 456 of the CHEK2 protein, p (Ser456Leu). It is located in exon 13, a region where the 90% of identified variants are pathogenic (Varsome source). Not reported in the gnomAD population database, it is predicted to be deleterious by computer-based algorithms used in Varsome . Despite reported only one time in ClinVar as VUS, it can be classified as LP based on ACMG criteria.", "sentences": [], "annotations": [{"id": "38205", "infons": {"identifier": "11200", "type": "Gene", "ncbi_homologene": "38289", "valid": true, "normalized": [11200], "database": "ncbi_gene", "normalized_id": 11200, "biotype": "gene", "name": "CHEK2", "accession": "@GENE_CHEK2"}, "text": "CHEK2", "locations": [{"offset": 23296, "length": 5}]}, {"id": "38206", "infons": {"identifier": "11200", "type": "Gene", "ncbi_homologene": "38289", "valid": true, "normalized": [11200], "database": "ncbi_gene", "normalized_id": 11200, "biotype": "gene", "name": "CHEK2", "accession": "@GENE_CHEK2"}, "text": "CHEK2", "locations": [{"offset": 23547, "length": 5}]}, {"id": "38207", "infons": {"identifier": "tmVar:p|SUB|S|456|L;HGVS:p.S456L;VariantGroup:13;CorrespondingGene:11200;RS#:876659827;CorrespondingSpecies:9606;CA#:10581037", "type": "Variant", "valid": true, "subtype": "ProteinMutation", "database": "litvar", "hgvs": "p.S456L", "gene_ids": [11200], "gene_id": 11200, "rsids": ["rs876659827"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA10581037", "rsid": "rs876659827", "normalized": ["rs876659827##", "#11200#", "CA10581037#rs876659827##"], "normalized_id": "rs876659827##", "biotype": "variant", "name": "p.S456L", "accession": "@VARIANT_p.S456L_CHEK2_human"}, "text": "Ser456Leu", "locations": [{"offset": 23565, "length": 9}]}, {"id": "38208", "infons": {"identifier": "MESH:D000230", "type": "Disease", "valid": true, "normalized": ["D000230"], "database": "ncbi_mesh", "normalized_id": "D000230", "biotype": "disease", "name": "Adenocarcinoma", "accession": "@DISEASE_Adenocarcinoma"}, "text": "cribriform carcinoma", "locations": [{"offset": 23360, "length": 20}]}, {"id": "38209", "infons": {"identifier": "MESH:C537419", "type": "Disease", "valid": true, "normalized": ["C537419"], "database": "ncbi_mesh", "normalized_id": "C537419", "biotype": "disease", "name": "Bohring syndrome", "accession": "@DISEASE_Bohring_syndrome"}, "text": "LP", "locations": [{"offset": 23885, "length": 2}]}, {"id": "38210", "infons": {"identifier": "tmVar:c|SUB|C|1367|T;HGVS:c.1367C>T;VariantGroup:110;CorrespondingGene:7486;RS#:1346044;CorrespondingSpecies:9606;CA#:156029", "type": "Variant", "valid": true, "subtype": "DNAMutation", "database": "litvar", "hgvs": "c.1367C>T", "gene_ids": [7486], "gene_id": 7486, "rsids": ["rs1346044"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA156029", "rsid": "rs1346044", "normalized": ["rs1346044##", "#7486#", "CA156029#rs1346044##"], "normalized_id": "rs1346044##", "biotype": "variant", "name": "c.1367C>T", "accession": "@VARIANT_p.C1367R_WRN_human"}, "text": "c.1367C>T", "locations": [{"offset": 23271, "length": 9}]}, {"id": "38211", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "OC", "locations": [{"offset": 23460, "length": 2}]}, {"id": "38212", "infons": {"identifier": "MESH:D065309", "type": "Disease", "valid": true, "normalized": ["D065309"], "database": "ncbi_mesh", "normalized_id": "D065309", "biotype": "disease", "name": "Atypical Squamous Cells of the Cervix", "accession": "@DISEASE_Atypical_Squamous_Cells_of_the_Cervix"}, "text": "VUS", "locations": [{"offset": 23856, "length": 3}]}, {"id": "38213", "infons": {"identifier": "tmVar:p|SUB|S|456|L;HGVS:p.S456L;VariantGroup:13;CorrespondingGene:11200;RS#:876659827;CorrespondingSpecies:9606;CA#:10581037", "type": "Variant", "valid": true, "subtype": "ProteinMutation", "database": "litvar", "hgvs": "p.S456L", "gene_ids": [11200], "gene_id": 11200, "rsids": ["rs876659827"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA10581037", "rsid": "rs876659827", "normalized": ["rs876659827##", "#11200#", "CA10581037#rs876659827##"], "normalized_id": "rs876659827##", "biotype": "variant", "name": "p.S456L", "accession": "@VARIANT_p.S456L_CHEK2_human"}, "text": "serine with leucine at codon 456", "locations": [{"offset": 23507, "length": 32}]}, {"id": "38214", "infons": {"identifier": "tmVar:c|SUB|C|1367|T;HGVS:c.1367C>T;VariantGroup:110;CorrespondingGene:7486;RS#:1346044;CorrespondingSpecies:9606;CA#:156029", "type": "Variant", "valid": true, "subtype": "DNAMutation", "database": "litvar", "hgvs": "c.1367C>T", "gene_ids": [7486], "gene_id": 7486, "rsids": ["rs1346044"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA156029", "rsid": "rs1346044", "normalized": ["rs1346044##", "#7486#", "CA156029#rs1346044##"], "normalized_id": "rs1346044##", "biotype": "variant", "name": "c.1367C>T", "accession": "@VARIANT_p.C1367R_WRN_human"}, "text": "c.1367C>T", "locations": [{"offset": 23481, "length": 9}]}, {"id": "38215", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "BC", "locations": [{"offset": 23453, "length": 2}]}], "relations": []}, {"infons": {"section_type": "RESULTS", "type": "title_2"}, "offset": 23914, "text": "3.5. DNA Repair Helicase Gene Variant-Related Phenotypes", "sentences": [], "annotations": [{"id": "38216", "infons": {"identifier": "164045", "type": "Gene", "ncbi_homologene": "87103", "valid": true, "normalized": [164045], "database": "ncbi_gene", "normalized_id": 164045, "biotype": "gene", "name": "HFM1", "accession": "@GENE_HFM1"}, "text": "Helicase", "locations": [{"offset": 23930, "length": 8}]}], "relations": []}, {"infons": {"section_type": "RESULTS", "type": "title_3"}, "offset": 23971, "text": "RECQL ", "sentences": [], "annotations": [{"id": "38217", "infons": {"identifier": "5965", "type": "Gene", "ncbi_homologene": "56279", "valid": true, "normalized": [5965], "database": "ncbi_gene", "normalized_id": 5965, "biotype": "gene", "name": "RECQL", "accession": "@GENE_RECQL"}, "text": "RECQL", "locations": [{"offset": 23971, "length": 5}]}], "relations": []}, {"infons": {"section_type": "RESULTS", "type": "paragraph"}, "offset": 23979, "text": "The new RECQL variant c.363_364del was identified in a 72-year-old male proband (P90) with BC at 59 years and PrC at 70, having a sister deceased at 56 years for pulmonary cancer and BC at 38 years (Figure 2d). This small deletion in RECQL was also excluded in the healthy 49 years old daughter of the proband. This variant is located in the helicase Rec-A like domain A1 (amino acid residues 63-281) of RECQL protein, containing the highly conserved signature helicase motifs of the SF-2 superfamily. This variant is predicted to cause a premature termination codon with consequent production of a truncated protein, p.(Cys122Leufs*43), and loss of the helicase activity. Germline mutations of RECQL were identified in patients with hereditary BC. In independent studies, damaging mutations in RECQL have been related to increased breast cancer risk and to genomic instability.", "sentences": [], "annotations": [{"id": "38219", "infons": {"identifier": "5965", "type": "Gene", "ncbi_homologene": "56279", "valid": true, "normalized": [5965], "database": "ncbi_gene", "normalized_id": 5965, "biotype": "gene", "name": "RECQL", "accession": "@GENE_RECQL"}, "text": "RECQL", "locations": [{"offset": 23987, "length": 5}]}, {"id": "38220", "infons": {"identifier": "5965", "type": "Gene", "ncbi_homologene": "56279", "valid": true, "normalized": [5965], "database": "ncbi_gene", "normalized_id": 5965, "biotype": "gene", "name": "RECQL", "accession": "@GENE_RECQL"}, "text": "RECQL", "locations": [{"offset": 24213, "length": 5}]}, {"id": "38221", "infons": {"identifier": "5965", "type": "Gene", "ncbi_homologene": "56279", "valid": true, "normalized": [5965], "database": "ncbi_gene", "normalized_id": 5965, "biotype": "gene", "name": "RECQL", "accession": "@GENE_RECQL"}, "text": "RECQL", "locations": [{"offset": 24383, "length": 5}]}, {"id": "38222", "infons": {"identifier": "6426", "type": "Gene", "ncbi_homologene": "31411", "valid": true, "normalized": [6426], "database": "ncbi_gene", "normalized_id": 6426, "biotype": "gene", "name": "SRSF1", "accession": "@GENE_SRSF1"}, "text": "SF-2", "locations": [{"offset": 24463, "length": 4}]}, {"id": "38223", "infons": {"identifier": "5965", "type": "Gene", "ncbi_homologene": "56279", "valid": true, "normalized": [5965], "database": "ncbi_gene", "normalized_id": 5965, "biotype": "gene", "name": "RECQL", "accession": "@GENE_RECQL"}, "text": "RECQL", "locations": [{"offset": 24674, "length": 5}]}, {"id": "38224", "infons": {"identifier": "5965", "type": "Gene", "ncbi_homologene": "56279", "valid": true, "normalized": [5965], "database": "ncbi_gene", "normalized_id": 5965, "biotype": "gene", "name": "RECQL", "accession": "@GENE_RECQL"}, "text": "RECQL", "locations": [{"offset": 24774, "length": 5}]}, {"id": "38225", "infons": {"identifier": "164045", "type": "Gene", "ncbi_homologene": "87103", "valid": true, "normalized": [164045], "database": "ncbi_gene", "normalized_id": 164045, "biotype": "gene", "name": "HFM1", "accession": "@GENE_HFM1"}, "text": "helicase", "locations": [{"offset": 24633, "length": 8}]}, {"id": "38226", "infons": {"identifier": "164045", "type": "Gene", "ncbi_homologene": "87103", "valid": true, "normalized": [164045], "database": "ncbi_gene", "normalized_id": 164045, "biotype": "gene", "name": "HFM1", "accession": "@GENE_HFM1"}, "text": "helicase", "locations": [{"offset": 24440, "length": 8}]}, {"id": "38227", "infons": {"identifier": "164045", "type": "Gene", "ncbi_homologene": "87103", "valid": true, "normalized": [164045], "database": "ncbi_gene", "normalized_id": 164045, "biotype": "gene", "name": "HFM1", "accession": "@GENE_HFM1"}, "text": "helicase", "locations": [{"offset": 24321, "length": 8}]}, {"id": "38228", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "BC", "locations": [{"offset": 24070, "length": 2}]}, {"id": "38229", "infons": {"identifier": "MESH:D011471", "type": "Disease", "valid": true, "normalized": ["D011471"], "database": "ncbi_mesh", "normalized_id": "D011471", "biotype": "disease", "name": "Prostatic Neoplasms", "accession": "@DISEASE_Prostatic_Neoplasms"}, "text": "PrC", "locations": [{"offset": 24089, "length": 3}]}, {"id": "38230", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "BC", "locations": [{"offset": 24724, "length": 2}]}, {"id": "38231", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "breast cancer", "locations": [{"offset": 24811, "length": 13}]}, {"id": "38232", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "BC", "locations": [{"offset": 24162, "length": 2}]}, {"id": "38233", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 24699, "length": 8}]}, {"id": "38234", "infons": {"identifier": "MESH:D008175", "type": "Disease", "valid": true, "normalized": ["D008175"], "database": "ncbi_mesh", "normalized_id": "D008175", "biotype": "disease", "name": "Lung Neoplasms", "accession": "@DISEASE_Lung_Neoplasms"}, "text": "pulmonary cancer", "locations": [{"offset": 24141, "length": 16}]}, {"id": "38235", "infons": {"identifier": "tmVar:c|DEL|363_364|;HGVS:c.363_364del;VariantGroup:91;CorrespondingGene:5965;CorrespondingSpecies:9606", "type": "Variant", "valid": true, "subtype": "DNAMutation", "database": "litvar", "hgvs": "c.363_364del", "gene_ids": [5965], "gene_id": 5965, "species_ids": [9606], "species_id": 9606, "rsids": [], "normalized": ["#5965#c.363_364del", "#5965#"], "normalized_id": "#5965#c.363_364del", "biotype": "variant", "name": "c.363_364del", "accession": "@VARIANT_c.363_364del_RECQL_human"}, "text": "c.363_364del", "locations": [{"offset": 24001, "length": 12}]}], "relations": []}, {"infons": {"section_type": "RESULTS", "type": "title_2"}, "offset": 24860, "text": "3.6. VUS Variants", "sentences": [], "annotations": [{"id": "38236", "infons": {"identifier": "MESH:D065309", "type": "Disease", "valid": true, "normalized": ["D065309"], "database": "ncbi_mesh", "normalized_id": "D065309", "biotype": "disease", "name": "Atypical Squamous Cells of the Cervix", "accession": "@DISEASE_Atypical_Squamous_Cells_of_the_Cervix"}, "text": "VUS", "locations": [{"offset": 24865, "length": 3}]}], "relations": []}, {"infons": {"section_type": "RESULTS", "type": "paragraph"}, "offset": 24878, "text": "Twenty-three cases had exclusively VUS. All but one carried a single variant. The P103 patient, carrier of two VUS (c.4703A>G, p.(His1568Arg), in ATM and c.7667C>T, p.(Ser2556Leu), in APC), had a low-grade hormone-responsive BC and a family history for BC and other cancers. In two unrelated women, the same VUS in the PALB2 gene (c.3436C>A) was identified, one with an early onset BC and one with OC. The remaining probands were carriers of single VUS. Four probands were the carrier of VUS in the ATM gene: three women with BC and one with OC. All but the bilateral BC woman had first and/or second-degree relatives with BC (4), PrC (1), PC (1), and other cancers (4). The two cases with VUS in CHEK2 had premenopausal familial BC and early-onset BC (38 years), melanoma, and positive family history for OC and uterine cancer, respectively. BRIP1 was found mutated in two cases: one woman had OC and relatives with BC, while the other one had BC at 42 years of age and positive family history for early-onset BC, PrC, brain, and colorectal cancer. The remaining 11 patients had VUS in 11 different genes. The two women with early onset of BC (at 36 and 38 years, respectively) had variants in CDH1 and PMS2. The patient with multiple cancers (breast and renal) had a VUS in the EPCAM gene. The male case of low-grade hormone-responsive BC, with onset at 43 years, was a MUTYH VUS heterozygous carrier. The other women had BC and a positive family history of many types of cancers. The correlation genotype-phenotype of patients with VUS are summarized in Table S3.", "sentences": [], "annotations": [{"id": "38237", "infons": {"identifier": "472", "type": "Gene", "ncbi_homologene": "30952", "valid": true, "normalized": [472], "database": "ncbi_gene", "normalized_id": 472, "biotype": "gene", "name": "ATM", "accession": "@GENE_ATM"}, "text": "ATM", "locations": [{"offset": 25024, "length": 3}]}, {"id": "38238", "infons": {"identifier": "324", "type": "Gene", "ncbi_homologene": "30950", "valid": true, "normalized": [324], "database": "ncbi_gene", "normalized_id": 324, "biotype": "gene", "name": "APC", "accession": "@GENE_APC"}, "text": "APC", "locations": [{"offset": 25062, "length": 3}]}, {"id": "38239", "infons": {"identifier": "79728", "type": "Gene", "ncbi_homologene": "11652", "valid": true, "normalized": [79728], "database": "ncbi_gene", "normalized_id": 79728, "biotype": "gene", "name": "PALB2", "accession": "@GENE_PALB2"}, "text": "PALB2", "locations": [{"offset": 25197, "length": 5}]}, {"id": "38240", "infons": {"identifier": "472", "type": "Gene", "ncbi_homologene": "30952", "valid": true, "normalized": [472], "database": "ncbi_gene", "normalized_id": 472, "biotype": "gene", "name": "ATM", "accession": "@GENE_ATM"}, "text