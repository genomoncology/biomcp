e, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "malignancies", "locations": [{"offset": 35874, "length": 12}]}, {"id": "38548", "infons": {"identifier": "MESH:D007153", "type": "Disease", "valid": true, "normalized": ["D007153"], "database": "ncbi_mesh", "normalized_id": "D007153", "biotype": "disease", "name": "Immunologic Deficiency Syndromes", "accession": "@DISEASE_Immunologic_Deficiency_Syndromes"}, "text": "immunodeficiency", "locations": [{"offset": 35076, "length": 16}]}, {"id": "38549", "infons": {"identifier": "MESH:D010984", "type": "Chemical", "valid": true, "normalized": ["D010984"], "database": "ncbi_mesh", "normalized_id": "D010984", "biotype": "chemical", "name": "Platinum", "accession": "@CHEMICAL_Platinum"}, "text": "platinum", "locations": [{"offset": 36175, "length": 8}]}, {"id": "38550", "infons": {"identifier": "MESH:D011471", "type": "Disease", "valid": true, "normalized": ["D011471"], "database": "ncbi_mesh", "normalized_id": "D011471", "biotype": "disease", "name": "Prostatic Neoplasms", "accession": "@DISEASE_Prostatic_Neoplasms"}, "text": "breast, pancreatic, prostatic, and other solid cancers", "locations": [{"offset": 35291, "length": 54}]}, {"id": "38551", "infons": {"identifier": "MESH:D008545", "type": "Disease", "valid": true, "normalized": ["D008545"], "database": "ncbi_mesh", "normalized_id": "D008545", "biotype": "disease", "name": "Melanoma", "accession": "@DISEASE_Melanoma"}, "text": "melanoma", "locations": [{"offset": 35477, "length": 8}]}, {"id": "38552", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patient", "locations": [{"offset": 35449, "length": 7}]}, {"id": "38553", "infons": {"identifier": "MESH:D019636", "type": "Disease", "valid": true, "normalized": ["D019636"], "database": "ncbi_mesh", "normalized_id": "D019636", "biotype": "disease", "name": "Neurodegenerative Diseases", "accession": "@DISEASE_Neurodegenerative_Diseases"}, "text": "neurodegenerative progressive disease", "locations": [{"offset": 35023, "length": 37}]}, {"id": "38554", "infons": {"identifier": "MESH:D010195", "type": "Disease", "valid": true, "normalized": ["D010195"], "database": "ncbi_mesh", "normalized_id": "D010195", "biotype": "disease", "name": "Pancreatitis", "accession": "@DISEASE_Pancreatitis"}, "text": "PC", "locations": [{"offset": 35636, "length": 2}]}], "relations": []}, {"infons": {"section_type": "DISCUSS", "type": "paragraph"}, "offset": 36263, "text": "LP variants in the MMR genes MLH1 and MSH2 were found in two women with BC. Although BC is not included in the spectrum of Lynch Syndrome (LS)-related malignancies, an association between LS germline mutations and this cancer has been recently suggested. Many studies indeed have reported a higher risk of BC in patients with LS and a higher frequency of MMR gene variants in BC cases. However, women with pathogenic variants in MMR genes are not usually advised to increase breast cancer screening. Furthermore, immunohistochemistry for MMR proteins is not performed for the identification of deficient breast cancers. Studies able to clarify this association are needed also for therapeutic implications. Checkpoint inhibitors, such as pembrolizumab, are becoming available treatments for all microsatellite instable-high and/or MMR deficient solid tumors (including breast cancer).", "sentences": [], "annotations": [{"id": "38555", "infons": {"identifier": "4292", "type": "Gene", "ncbi_homologene": "208", "valid": true, "normalized": [4292], "database": "ncbi_gene", "normalized_id": 4292, "biotype": "gene", "name": "MLH1", "accession": "@GENE_MLH1"}, "text": "MLH1", "locations": [{"offset": 36292, "length": 4}]}, {"id": "38556", "infons": {"identifier": "4436", "type": "Gene", "ncbi_homologene": "210", "valid": true, "normalized": [4436], "database": "ncbi_gene", "normalized_id": 4436, "biotype": "gene", "name": "MSH2", "accession": "@GENE_MSH2"}, "text": "MSH2", "locations": [{"offset": 36301, "length": 4}]}, {"id": "38557", "infons": {"identifier": "MESH:D003123", "type": "Disease", "valid": true, "normalized": ["D003123"], "database": "ncbi_mesh", "normalized_id": "D003123", "biotype": "disease", "name": "Colorectal Neoplasms Hereditary Nonpolyposis", "accession": "@DISEASE_Colorectal_Neoplasms_Hereditary_Nonpolyposis"}, "text": "Lynch Syndrome (LS)-related malignancies", "locations": [{"offset": 36386, "length": 40}]}, {"id": "38558", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "BC", "locations": [{"offset": 36348, "length": 2}]}, {"id": "38559", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "women", "locations": [{"offset": 36658, "length": 5}]}, {"id": "38560", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "breast cancer", "locations": [{"offset": 36738, "length": 13}]}, {"id": "38561", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "BC", "locations": [{"offset": 36569, "length": 2}]}, {"id": "38562", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "breast cancer", "locations": [{"offset": 37132, "length": 13}]}, {"id": "38563", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 36575, "length": 8}]}, {"id": "38564", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "women", "locations": [{"offset": 36324, "length": 5}]}, {"id": "38565", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "tumors", "locations": [{"offset": 37114, "length": 6}]}, {"id": "38566", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "cancer", "locations": [{"offset": 36482, "length": 6}]}, {"id": "38567", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "breast cancers", "locations": [{"offset": 36867, "length": 14}]}, {"id": "38568", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "BC", "locations": [{"offset": 36335, "length": 2}]}, {"id": "38569", "infons": {"identifier": "MESH:C582435", "type": "Chemical", "valid": true, "normalized": ["C582435"], "database": "ncbi_mesh", "normalized_id": "C582435", "biotype": "chemical", "name": "pembrolizumab", "accession": "@CHEMICAL_pembrolizumab"}, "text": "pembrolizumab", "locations": [{"offset": 37001, "length": 13}]}, {"id": "38570", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "BC", "locations": [{"offset": 36639, "length": 2}]}], "relations": []}, {"infons": {"section_type": "DISCUSS", "type": "paragraph"}, "offset": 37148, "text": "In this study, we described a new frameshift deletion c.363_364del in the RECQL gene in a male with infiltrating ductal breast and prostatic cancer at 59 and 70 years of age, respectively, with a positive family history for breast and lung cancer (Figure 2d). RECQL encodes a protein that is part of a family of five RECQ helicases, including at least three implicated in cancer-prone syndromes, such as Bloom Syndrome, Werner Syndrome, and Rothmund-Thomson Syndrome. These diseases are indeed caused by bi-allelic mutations in the BLM, WRN, and RECQ4 genes, respectively. RECQL is a helicase involved not only in the unwinding of the DNA but also in the promotion of complementary single-strand DNA annealing. Its role in DDR has been clearly proven by many studies that have demonstrated chromosomal instability, stalled and collapsed replication forks, oxidative damage, higher DSBs in cells with a deficit of RECQL. In 2015, two independent research groups associated the damaging variants in RECQL with a higher risk of BC in studies conducted in Polish and Canadian populations. However, this correlation was not confirmed in subsequent studies. More recently, mutations in RECQL emerged as a moderate risk factor for BC in a cohort of African American women, indicating that mutations in the RECQL gene confer a moderate risk of BC. These conflicting correlations could be explained by penetrance variability due to the consequences of the different types of the identified variants on the protein function and to the investigated cohorts belonging to different ethnicities.", "sentences": [], "annotations": [{"id": "38571", "infons": {"identifier": "5965", "type": "Gene", "ncbi_homologene": "56279", "valid": true, "normalized": [5965], "database": "ncbi_gene", "normalized_id": 5965, "biotype": "gene", "name": "RECQL", "accession": "@GENE_RECQL"}, "text": "RECQL", "locations": [{"offset": 37222, "length": 5}]}, {"id": "38572", "infons": {"identifier": "5965", "type": "Gene", "ncbi_homologene": "56279", "valid": true, "normalized": [5965], "database": "ncbi_gene", "normalized_id": 5965, "biotype": "gene", "name": "RECQL", "accession": "@GENE_RECQL"}, "text": "RECQL", "locations": [{"offset": 37408, "length": 5}]}, {"id": "38573", "infons": {"identifier": "641", "type": "Gene", "ncbi_homologene": "47902", "valid": true, "normalized": [641], "database": "ncbi_gene", "normalized_id": 641, "biotype": "gene", "name": "BLM", "accession": "@GENE_BLM"}, "text": "BLM", "locations": [{"offset": 37680, "length": 3}]}, {"id": "38574", "infons": {"identifier": "7486", "type": "Gene", "ncbi_homologene": "6659", "valid": true, "normalized": [7486], "database": "ncbi_gene", "normalized_id": 7486, "biotype": "gene", "name": "WRN", "accession": "@GENE_WRN"}, "text": "WRN", "locations": [{"offset": 37685, "length": 3}]}, {"id": "38575", "infons": {"identifier": "9401", "type": "Gene", "ncbi_homologene": "3144", "valid": true, "normalized": [9401], "database": "ncbi_gene", "normalized_id": 9401, "biotype": "gene", "name": "RECQL4", "accession": "@GENE_RECQL4"}, "text": "RECQ4", "locations": [{"offset": 37694, "length": 5}]}, {"id": "38576", "infons": {"identifier": "5965", "type": "Gene", "ncbi_homologene": "56279", "valid": true, "normalized": [5965], "database": "ncbi_gene", "normalized_id": 5965, "biotype": "gene", "name": "RECQL", "accession": "@GENE_RECQL"}, "text": "RECQL", "locations": [{"offset": 37721, "length": 5}]}, {"id": "38577", "infons": {"identifier": "164045", "type": "Gene", "ncbi_homologene": "87103", "valid": true, "normalized": [164045], "database": "ncbi_gene", "normalized_id": 164045, "biotype": "gene", "name": "HFM1", "accession": "@GENE_HFM1"}, "text": "helicase", "locations": [{"offset": 37732, "length": 8}]}, {"id": "38578", "infons": {"identifier": "5965", "type": "Gene", "ncbi_homologene": "56279", "valid": true, "normalized": [5965], "database": "ncbi_gene", "normalized_id": 5965, "biotype": "gene", "name": "RECQL", "accession": "@GENE_RECQL"}, "text": "RECQL", "locations": [{"offset": 38061, "length": 5}]}, {"id": "38579", "infons": {"identifier": "5965", "type": "Gene", "ncbi_homologene": "56279", "valid": true, "normalized": [5965], "database": "ncbi_gene", "normalized_id": 5965, "biotype": "gene", "name": "RECQL", "accession": "@GENE_RECQL"}, "text": "RECQL", "locations": [{"offset": 38145, "length": 5}]}, {"id": "38580", "infons": {"identifier": "5965", "type": "Gene", "ncbi_homologene": "56279", "valid": true, "normalized": [5965], "database": "ncbi_gene", "normalized_id": 5965, "biotype": "gene", "name": "RECQL", "accession": "@GENE_RECQL"}, "text": "RECQL", "locations": [{"offset": 38328, "length": 5}]}, {"id": "38581", "infons": {"identifier": "5965", "type": "Gene", "ncbi_homologene": "56279", "valid": true, "normalized": [5965], "database": "ncbi_gene", "normalized_id": 5965, "biotype": "gene", "name": "RECQL", "accession": "@GENE_RECQL"}, "text": "RECQL", "locations": [{"offset": 38447, "length": 5}]}, {"id": "38582", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": 