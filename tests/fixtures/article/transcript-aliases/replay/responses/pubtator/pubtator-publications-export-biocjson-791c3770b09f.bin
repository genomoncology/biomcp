", "biotype": "disease", "name": "Prostatic Neoplasms", "accession": "@DISEASE_Prostatic_Neoplasms"}, "text": "PrC", "locations": [{"offset": 33884, "length": 3}]}, {"id": "38492", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "cancers", "locations": [{"offset": 33849, "length": 7}]}, {"id": "38493", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "tumors", "locations": [{"offset": 34025, "length": 6}]}, {"id": "38494", "infons": {"type": "Disease", "valid": false, "normalized_id": null, "biotype": "disease"}, "text": "CC", "locations": [{"offset": 33814, "length": 2}]}, {"id": "38495", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "malignancies", "locations": [{"offset": 33733, "length": 12}]}, {"id": "38496", "infons": {"type": "Disease", "valid": false, "normalized_id": null, "biotype": "disease"}, "text": "RC", "locations": [{"offset": 33877, "length": 2}]}, {"id": "38497", "infons": {"identifier": "tmVar:c|SUB|T|470|C;HGVS:c.470T>C;VariantGroup:24;CorrespondingGene:11200;RS#:17879961;CorrespondingSpecies:9606;CA#:117630", "type": "Variant", "valid": true, "subtype": "DNAMutation", "database": "litvar", "hgvs": "c.470T>C", "gene_ids": [11200], "gene_id": 11200, "rsids": ["rs17879961"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA117630", "rsid": "rs17879961", "normalized": ["rs17879961##", "#11200#", "CA117630#rs17879961##"], "normalized_id": "rs17879961##", "biotype": "variant", "name": "c.470T>C", "accession": "@VARIANT_p.I157T_CHEK2_human"}, "text": "c.470T>C", "locations": [{"offset": 34088, "length": 8}]}, {"id": "38498", "infons": {"identifier": "tmVar:p|SUB|I|157|T;HGVS:p.I157T;VariantGroup:24;CorrespondingGene:11200;RS#:17879961;CorrespondingSpecies:9606;CA#:117630", "type": "Variant", "valid": true, "subtype": "ProteinMutation", "database": "litvar", "hgvs": "p.I157T", "gene_ids": [11200], "gene_id": 11200, "rsids": ["rs17879961"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA117630", "rsid": "rs17879961", "normalized": ["rs17879961##", "#11200#", "CA117630#rs17879961##"], "normalized_id": "rs17879961##", "biotype": "variant", "name": "p.I157T", "accession": "@VARIANT_p.I157T_CHEK2_human"}, "text": "p.(Ile157Thr)", "locations": [{"offset": 33664, "length": 13}]}, {"id": "38499", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "OC", "locations": [{"offset": 33810, "length": 2}]}], "relations": []}, {"infons": {"section_type": "DISCUSS", "type": "paragraph"}, "offset": 34243, "text": "Mutations in the RAD51C gene, encoding a protein involved in HR, were found in 3/113 cases analyzed:two patients with OC and a woman with bilateral BC. Deleterious variants in this gene have been associated with a higher risk of epithelial ovarian carcinoma, especially with early onset. Although a well-defined genetic risk factor for OC, the role of RAD51C in BC, is still debated. The woman carrying the RAD51C missense gene alteration had a bilateral metachronous BC, a lobular carcinoma on the left, and a high-grade triple-negative invasive DC occurred 11 years later on the right. Intriguingly, in patients with BC and damaging mutations in RAD51C, triple-negative cancers recurred many times.", "sentences": [], "annotations": [{"id": "38500", "infons": {"identifier": "5889", "type": "Gene", "ncbi_homologene": "14238", "valid": true, "normalized": [5889], "database": "ncbi_gene", "normalized_id": 5889, "biotype": "gene", "name": "RAD51C", "accession": "@GENE_RAD51C"}, "text": "RAD51C", "locations": [{"offset": 34260, "length": 6}]}, {"id": "38501", "infons": {"identifier": "5889", "type": "Gene", "ncbi_homologene": "14238", "valid": true, "normalized": [5889], "database": "ncbi_gene", "normalized_id": 5889, "biotype": "gene", "name": "RAD51C", "accession": "@GENE_RAD51C"}, "text": "RAD51C", "locations": [{"offset": 34595, "length": 6}]}, {"id": "38502", "infons": {"identifier": "5889", "type": "Gene", "ncbi_homologene": "14238", "valid": true, "normalized": [5889], "database": "ncbi_gene", "normalized_id": 5889, "biotype": "gene", "name": "RAD51C", "accession": "@GENE_RAD51C"}, "text": "RAD51C", "locations": [{"offset": 34650, "length": 6}]}, {"id": "38503", "infons": {"identifier": "5889", "type": "Gene", "ncbi_homologene": "14238", "valid": true, "normalized": [5889], "database": "ncbi_gene", "normalized_id": 5889, "biotype": "gene", "name": "RAD51C", "accession": "@GENE_RAD51C"}, "text": "RAD51C", "locations": [{"offset": 34891, "length": 6}]}, {"id": "38504", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "OC", "locations": [{"offset": 34579, "length": 2}]}, {"id": "38505", "infons": {"identifier": "MESH:D064726", "type": "Disease", "valid": true, "normalized": ["D064726"], "database": "ncbi_mesh", "normalized_id": "D064726", "biotype": "disease", "name": "Triple Negative Breast Neoplasms", "accession": "@DISEASE_Triple_Negative_Breast_Neoplasms"}, "text": "triple-negative cancers", "locations": [{"offset": 34899, "length": 23}]}, {"id": "38506", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "BC", "locations": [{"offset": 34711, "length": 2}]}, {"id": "38507", "infons": {"identifier": "MESH:D044584", "type": "Disease", "valid": true, "normalized": ["D044584"], "database": "ncbi_mesh", "normalized_id": "D044584", "biotype": "disease", "name": "Carcinoma Ductal", "accession": "@DISEASE_Carcinoma_Ductal"}, "text": "invasive DC", "locations": [{"offset": 34781, "length": 11}]}, {"id": "38508", "infons": {"identifier": "MESH:D018275", "type": "Disease", "valid": true, "normalized": ["D018275"], "database": "ncbi_mesh", "normalized_id": "D018275", "biotype": "disease", "name": "Carcinoma Lobular", "accession": "@DISEASE_Carcinoma_Lobular"}, "text": "lobular carcinoma", "locations": [{"offset": 34717, "length": 17}]}, {"id": "38509", "infons": {"identifier": "MESH:D010051", "type": "Disease", "valid": true, "normalized": ["D010051"], "database": "ncbi_mesh", "normalized_id": "D010051", "biotype": "disease", "name": "Ovarian Neoplasms", "accession": "@DISEASE_Ovarian_Neoplasms"}, "text": "OC", "locations": [{"offset": 34361, "length": 2}]}, {"id": "38510", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 34848, "length": 8}]}, {"id": "38511", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "woman", "locations": [{"offset": 34370, "length": 5}]}, {"id": "38512", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "BC", "locations": [{"offset": 34391, "length": 2}]}, {"id": "38513", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 34347, "length": 8}]}, {"id": "38514", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "BC", "locations": [{"offset": 34605, "length": 2}]}, {"id": "38515", "infons": {"identifier": "MESH:D000077216", "type": "Disease", "valid": true, "normalized": ["D000077216"], "database": "ncbi_mesh", "normalized_id": "D000077216", "biotype": "disease", "name": "Carcinoma Ovarian Epithelial", "accession": "@DISEASE_Carcinoma_Ovarian_Epithelial"}, "text": "epithelial ovarian carcinoma", "locations": [{"offset": 34472, "length": 28}]}, {"id": "38516", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "woman", "locations": [{"offset": 34631, "length": 5}]}, {"id": "38517", "infons": {"identifier": "MESH:D001943", "type": "Disease", "valid": true, "normalized": ["D001943"], "database": "ncbi_mesh", "normalized_id": "D001943", "biotype": "disease", "name": "Breast Neoplasms", "accession": "@DISEASE_Breast_Neoplasms"}, "text": "BC", "locations": [{"offset": 34862, "length": 2}]}], "relations": []}, {"infons": {"section_type": "DISCUSS", "type": "paragraph"}, "offset": 34946, "text": "Bi-allelic P/LP variants in the ATM gene cause Ataxia-Telangiectasia (AT), a neurodegenerative progressive disease complicated by immunodeficiency and cancer predisposition. Germline ATM heterozygous carriers are about 0.75-1% of the population. Mono-allelic variants of this gene are proven as moderate risk factors for malignancies, including breast, pancreatic, prostatic, and other solid cancers. In our cohort, ATM pathogenic variants were identified in two probands with multiple cancers. The P29 patient, affected by BC and melanoma, had a paternal family history of different types of malignancies previously described in ATM heterozygous patients; the P89 patient had a metastatic PC and a previous diagnosis of GC. In his family, nine relatives deceased for gastric cancer. Although not frequently, pathogenic variants in ATM have been previously described in patients with GC. PC remains one of the most lethal solid malignancies. The identification of damaging mutations in DDR system genes, including ATM, in 17-25% of this type of cancer and the recent suggestion that PARP inhibitors could have therapeutic potential in cancers with loss or mutation of ATM are opening up the possibility of new therapies, such as platinum and more recently PARP inhibitors, also in ATM-mutated patients with PC.", "sentences": [], "annotations": [{"id": "38518", "infons": {"identifier": "472", "type": "Gene", "ncbi_homologene": "30952", "valid": true, "normalized": [472], "database": "ncbi_gene", "normalized_id": 472, "biotype": "gene", "name": "ATM", "accession": "@GENE_ATM"}, "text": "ATM", "locations": [{"offset": 34978, "length": 3}]}, {"id": "38519", "infons": {"identifier": "472", "type": "Gene", "ncbi_homologene": "30952", "valid": true, "normalized": [472], "database": "ncbi_gene", "normalized_id": 472, "biotype": "gene", "name": "ATM", "accession": "@GENE_ATM"}, "text": "ATM", "locations": [{"offset": 35129, "length": 3}]}, {"id": "38520", "infons": {"identifier": "472", "type": "Gene", "ncbi_homologene": "30952", "valid": true, "normalized": [472], "database": "ncbi_gene", "normalized_id": 472, "biotype": "gene", "name": "ATM", "accession": "@GENE_ATM"}, "text": "ATM", "locations": [{"offset": 35362, "length": 3}]}, {"id": "38521", "infons": {"identifier": "472", "type": "Gene", "ncbi_homologene": "30952", "valid": true, "normalized": [472], "database": "ncbi_gene", "normalized_id": 472, "biotype": "gene", "name": "ATM", "accession": "@GENE_ATM"}, "text": "ATM", "locations": [{"offset": 35576, "length": 3}]}, {"id": "38522", "infons": {"identifier": "472", "type": "Gene", "ncbi_homologene": "30952", "valid": true, "normalized": [472], "database": "ncbi_gene", "normalized_id": 472, "biotype": "gene", "name": "ATM", "accession": "@GENE_ATM"}, "text": "ATM", "locations": [{"offset": 35778, "length": 3}]}, {"id": "38523", "infons": {"identifier": "472", "type": "Gene", "ncbi_homologene": "30952", "valid": true, "normalized": [472], "database": "ncbi_gene", "normalized_id": 472, "biotype": "gene", "name": "ATM", "accession": "@GENE_ATM"}, "text": "ATM", "locations": [{"offset": 35960, "length": 3}]}, {"id": "38524", "infons": {"identifier": "472", "type": "Gene", "ncbi_homologene": "30952", "valid": true, "normalized": [472], "database": "ncbi_gene", "normalized_id": 472, "biotype": "gene", "name": "ATM", "accession": "@GENE_ATM"}, "text": "ATM", "locations": [{"offset": 36114, "length": 3}]}, {"id": "38525", "infons": {"identifier": "472", "type": "Gene", "ncbi_homologene": "30952", "valid": true, "normalized": [472], "database": "ncbi_gene", "normalized_id": 472, "biotype": "gene", "name": "ATM", "accession": "@GENE_ATM"}, "text": "ATM", "locations": [{"offset": 36227, "length": 3}]}, {"id": "38526", "infons": {"identifier": "5744", "type": "Gene", "ncbi_homologene": "2113", "valid": true, "normalized": [5744], "database": "ncbi_gene", "normalized_id": 5744, "biotype": "gene", "name": "PTHLH", "accession": "@GENE_PTHLH"}, "text": "P/LP", "locations": [{"offset": 34957, "length": 4}]}, {"id": "38527", "infons": {"identifier": "142", "type": "Gene", "ncbi_ho