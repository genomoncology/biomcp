"length": 11}]}], "relations": []}, {"infons": {"section_type": "TABLE", "file": "Tab1.xml", "id": "Tab1", "type": "table_foot"}, "offset": 10873, "text": "*P Pathogenic, LP Likely Pathogenic", "sentences": [], "annotations": [{"id": "21807", "infons": {"type": "Disease", "valid": false, "normalized_id": null, "biotype": "disease"}, "text": "LP", "locations": [{"offset": 10888, "length": 2}]}], "relations": []}, {"infons": {"section_type": "TABLE", "file": "Tab1.xml", "id": "Tab1", "type": "table_foot"}, "offset": 10909, "text": "PVS1: nonsense (stop-gain) mutation where loss of function is a known mechanism of disease", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "TABLE", "file": "Tab1.xml", "id": "Tab1", "type": "table_foot"}, "offset": 11000, "text": "PM2: Low allele frequency in genomic databases", "sentences": [], "annotations": [], "relations": []}, {"infons": {"section_type": "TABLE", "file": "Tab1.xml", "id": "Tab1", "type": "table_foot"}, "offset": 11047, "text": "PP5: Reputable source(s) classified variant as pathogenic", "sentences": [], "annotations": [{"id": "21808", "infons": {"identifier": "7980", "type": "Gene", "ncbi_homologene": "38194", "valid": true, "normalized": [7980], "database": "ncbi_gene", "normalized_id": 7980, "biotype": "gene", "name": "TFPI2", "accession": "@GENE_TFPI2"}, "text": "PP5", "locations": [{"offset": 11047, "length": 3}]}], "relations": []}, {"infons": {"section_type": "TABLE", "file": "Tab1.xml", "id": "Tab1", "type": "table_foot"}, "offset": 11105, "text": "PS3: Well-established in vitro or in vivo functional studies supportive of a damaging effect on the gene or gene product", "sentences": [], "annotations": [{"id": "21809", "infons": {"identifier": "448990", "type": "Gene", "valid": true, "normalized": [448990], "database": "ncbi_gene", "normalized_id": 448990, "biotype": "gene", "name": "TAS2R6P", "accession": "@GENE_TAS2R6P"}, "text": "PS3", "locations": [{"offset": 11105, "length"