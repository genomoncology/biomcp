#!/bin/sh
# discard — tear down after a run that did not land.
#
# Environment: QUEUE_ID, QUEUE_OUTCOME; optional QUEUE_REPO.
# Only `blocked` lingers (sdlc ADR 0005):
#   blocked        nothing is touched — the tree AND the branch are what a
#                  human opens
#   failed         the tree goes; the branch is kept, locally and on origin,
#                  for reading
#   ready          retains the old branch tip as attempt/<id>/<n>, then removes
#                  the tree and both claim branches for a clean retry
#   anything else  the tree goes, and so do the local branch and the origin
#                  claim branch
# Exits 0 on a clean teardown.
set -eu

: "${QUEUE_ID:?discard: QUEUE_ID is required}"

case "$QUEUE_ID" in
[0-9][0-9][0-9][0-9]) ;;
*)
	echo "discard: QUEUE_ID must be exactly four digits" >&2
	exit 1
	;;
esac

if [ -n "${QUEUE_REPO-}" ]; then
	REPO=$QUEUE_REPO
else
	REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
fi
NAME=$(basename "$REPO")
BRANCH="ticket/$QUEUE_ID"
WORKTREES=${SDLC_WORKTREES:-$HOME/workspace/worktrees}
OUTCOME=${QUEUE_OUTCOME-}

if [ "$OUTCOME" = "blocked" ]; then
	echo "discard: $QUEUE_ID is blocked — keeping its worktree and $BRANCH for a human" >&2
	exit 0
fi

origin_namespace() {
	origin=$(git -C "$REPO" remote get-url origin 2>/dev/null) || return 1
	namespace=$(printf '%s\n' "$origin" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s/\.git$//; s/:/\//g' | awk -F/ '{ for (i = 1; i <= NF; i++) if ($i != "") part[++n] = $i } END { if (n >= 2) print part[n - 1] "/" part[n] }')
	# The namespace becomes a path below WORKTREES; traversal components are not identities.
	case "$namespace" in ./*|../*|*/.|*/..) return 1 ;; esac
	printf '%s\n' "$namespace"
}

if ! NAMESPACE=$(origin_namespace) || [ -z "$NAMESPACE" ]; then
	echo "discard: cannot derive owner/repository from origin" >&2
	exit 1
fi
if ! common=$(git -C "$REPO" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
	|| ! REPO_COMMON=$(CDPATH= cd -- "$common" && pwd -P); then
	echo "discard: cannot determine Git common directory for $REPO" >&2
	exit 1
fi
TREE="$WORKTREES/$NAMESPACE/$QUEUE_ID"
LEGACY_TREE="$WORKTREES/$NAME/$QUEUE_ID"

# A candidate is ours only if Git identifies that path itself as a worktree
# top-level and both trees share this local repository's common directory.
candidate_owned() {
	candidate=$1
	top=$(git -C "$candidate" rev-parse --show-toplevel 2>/dev/null) || return 1
	candidate_path=$(CDPATH= cd -- "$candidate" && pwd -P) || return 1
	top_path=$(CDPATH= cd -- "$top" && pwd -P) || return 1
	[ "$candidate_path" = "$top_path" ] || return 1
	candidate_common=$(git -C "$candidate" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
	candidate_common=$(CDPATH= cd -- "$candidate_common" && pwd -P) || return 1
	[ "$candidate_common" = "$REPO_COMMON" ]
}

# Git is the normal remover. Recursive removal is only for its known stale
# metadata case, after ownership has been proved again at the point of use.
remove_tree() {
	candidate=$1
	if git -C "$REPO" worktree remove --force "$candidate" >/dev/null 2>&1; then
		return 0
	fi
	[ -e "$candidate" ] || return 0
	if ! candidate_owned "$candidate"; then
		echo "discard: refusing to remove $candidate: it is not a worktree owned by $REPO" >&2
		return 1
	fi
	if ! rm -rf "$candidate"; then
		echo "discard: could not remove worktree $candidate" >&2
		return 1
	fi
}

# Refuse before changing tags, branches, or either tree. This avoids a partial
# teardown when a primary tree is ours but a legacy path belongs to someone else.
for candidate in "$TREE" "$LEGACY_TREE"; do
	[ -e "$candidate" ] || continue
	if ! candidate_owned "$candidate"; then
		echo "discard: refusing to remove $candidate: it is not a worktree owned by $REPO" >&2
		exit 1
	fi
done

prune_worktrees() {
	git -C "$REPO" worktree prune >/dev/null 2>&1
}

remove_local_branch() {
	if git -C "$REPO" show-ref --verify --quiet "refs/heads/$BRANCH"; then
		git -C "$REPO" branch -D "$BRANCH" >/dev/null 2>&1
	else
		status=$?
		[ "$status" -eq 1 ]
	fi
}

remove_origin_branch() {
	attempt_tip=
	failed=0
	round=1
	while [ "$round" -le 3 ]; do
		if observed=$(timeout -k 10 60 git -C "$REPO" ls-remote --exit-code --heads origin "refs/heads/$BRANCH" 2>/dev/null); then
			tip=$(printf '%s\n' "$observed" | awk '{print $1}')
			# This run's remote claim is an ancestor of its local branch. Refuse a
			# replacement claim seen before deletion as well as one moved mid-retry.
			if ! git -C "$REPO" merge-base --is-ancestor "$tip" "refs/heads/$BRANCH" >/dev/null 2>&1; then
				return 1
			fi
			if [ -z "$attempt_tip" ]; then
				attempt_tip=$tip
			elif [ "$attempt_tip" != "$tip" ]; then
				return 1
			fi
			if timeout -k 10 60 git -C "$REPO" push --quiet --force-with-lease="refs/heads/$BRANCH:$attempt_tip" origin --delete "$BRANCH" >/dev/null 2>&1; then
				return "$failed"
			fi
			failed=1
		else
			status=$?
			if [ "$status" -eq 2 ]; then
				return "$failed"
			fi
			failed=1
		fi
		if [ "$round" -lt 3 ]; then
			sleep 1
		fi
		round=$((round + 1))
	done
	return 1
}

preserve_attempt_tip() {
	if git -C "$REPO" show-ref --verify --quiet "refs/heads/$BRANCH"; then
		:
	else
		status=$?
		[ "$status" -eq 1 ] || return "$status"
		return
	fi
	TAGS=$(git -C "$REPO" tag --list "attempt/$QUEUE_ID/*") || return
	N=1
	if [ -n "$TAGS" ]; then
		N=$(printf '%s\n' "$TAGS" | wc -l) || return
		N=$((N + 1))
	fi
	git -C "$REPO" tag "attempt/$QUEUE_ID/$N" "$BRANCH"
}

cleanup_failures=
cleanup() {
	name=$1
	shift
	if "$@"; then
		return
	fi
	cleanup_failures="${cleanup_failures}${cleanup_failures:+, }$name"
}

for candidate in "$TREE" "$LEGACY_TREE"; do
	[ -e "$candidate" ] || continue
	cleanup "worktree removal $candidate" remove_tree "$candidate"
done
cleanup "worktree prune" prune_worktrees

DELETE_BRANCHES=true
if [ "$OUTCOME" = "ready" ] && ! preserve_attempt_tip; then
	cleanup_failures="${cleanup_failures}${cleanup_failures:+, }attempt tag $BRANCH"
	DELETE_BRANCHES=false
fi

if [ "$OUTCOME" = "failed" ]; then
	echo "discard: $QUEUE_ID failed — removed $TREE, keeping $BRANCH for reading" >&2
elif "$DELETE_BRANCHES"; then
	cleanup "origin branch $BRANCH" remove_origin_branch
	cleanup "local branch $BRANCH" remove_local_branch
fi

if [ -n "$cleanup_failures" ]; then
	echo "discard: teardown failed: $cleanup_failures" >&2
	exit 1
fi
