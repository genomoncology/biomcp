#!/bin/sh
# integrate — build, quickfix, and review land sealed candidates here; other flows only tear down.
#
# Environment: QUEUE_ID, QUEUE_FLOW; optional QUEUE_REPO.
set -eu

: "${QUEUE_FLOW:?integrate: QUEUE_FLOW is required}"
case "$QUEUE_FLOW" in
build|quickfix|review) LANDING=true ;;
*) LANDING=false ;;
esac

if [ -z "${QUEUE_ID-}" ]; then
	echo "integrate: QUEUE_ID is required" >&2
	if "$LANDING"; then exit 3; fi
	exit 1
fi
case "$QUEUE_ID" in
[0-9][0-9][0-9][0-9]) ;;
*)
	echo "integrate: QUEUE_ID must be exactly four digits" >&2
	if "$LANDING"; then exit 3; fi
	exit 1
	;;
esac

if [ -n "${QUEUE_REPO-}" ]; then
	REPO=$QUEUE_REPO
else
	REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
fi
NAME=$(basename "$REPO")
BRANCH="ticket/$QUEUE_ID"
WORKTREES=${SDLC_WORKTREES:-$HOME/workspace/worktrees}

origin_namespace() {
	origin=$(git -C "$REPO" remote get-url origin 2>/dev/null) || return 1
	namespace=$(printf '%s\n' "$origin" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s/\.git$//; s/:/\//g' | awk -F/ '{ for (i = 1; i <= NF; i++) if ($i != "") part[++n] = $i } END { if (n >= 2) print part[n - 1] "/" part[n] }')
	# The namespace becomes a path below WORKTREES; traversal components are not identities.
	case "$namespace" in ./*|../*|*/.|*/..) return 1 ;; esac
	printf '%s\n' "$namespace"
}

if ! NAMESPACE=$(origin_namespace) || [ -z "$NAMESPACE" ]; then
	echo "integrate: cannot derive owner/repository from origin" >&2
	if "$LANDING"; then exit 3; fi
	exit 1
fi
if ! common=$(git -C "$REPO" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
	|| ! REPO_COMMON=$(CDPATH= cd -- "$common" && pwd -P); then
	echo "integrate: cannot determine Git common directory for $REPO" >&2
	if "$LANDING"; then exit 3; fi
	exit 1
fi
TREE="$WORKTREES/$NAMESPACE/$QUEUE_ID"
LEGACY_TREE="$WORKTREES/$NAME/$QUEUE_ID"

# A candidate is ours only if Git identifies that path itself as a worktree
# top-level and both trees share this local repository's common directory.
candidate_owned() {
	candidate=$1
	top=$(git -C "$candidate" rev-parse --show-toplevel 2>/dev/null) || return 1
	candidate_path=$(CDPATH= cd -- "$candidate" && pwd -P) || return 1
	top_path=$(CDPATH= cd -- "$top" && pwd -P) || return 1
	[ "$candidate_path" = "$top_path" ] || return 1
	candidate_common=$(git -C "$candidate" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
	candidate_common=$(CDPATH= cd -- "$candidate_common" && pwd -P) || return 1
	[ "$candidate_common" = "$REPO_COMMON" ]
}

# Git is the normal remover. Recursive removal is only for its known stale
# metadata case, after ownership has been proved again at the point of use.
remove_tree() {
	candidate=$1
	if git -C "$REPO" worktree remove --force "$candidate" >/dev/null 2>&1; then
		return 0
	fi
	[ -e "$candidate" ] || return 0
	if ! candidate_owned "$candidate"; then
		echo "integrate: refusing to remove $candidate: it is not a worktree owned by $REPO" >&2
		return 1
	fi
	if ! rm -rf "$candidate"; then
		echo "integrate: could not remove worktree $candidate" >&2
		return 1
	fi
}

# Refuse before changing either tree or branch. This avoids a partial teardown
# when a primary tree is ours but a legacy path belongs to someone else.
for candidate in "$TREE" "$LEGACY_TREE"; do
	[ -e "$candidate" ] || continue
	if ! candidate_owned "$candidate"; then
		echo "integrate: refusing to remove $candidate: it is not a worktree owned by $REPO" >&2
		if "$LANDING"; then exit 3; fi
		exit 1
	fi
done

if "$LANDING"; then
	CANDIDATE=
	for candidate in "$TREE" "$LEGACY_TREE"; do
		[ -e "$candidate" ] || continue
		if [ -n "$CANDIDATE" ]; then
			echo "integrate: ambiguous candidates" >&2
			exit 3
		fi
		CANDIDATE=$candidate
	done
	if [ -z "$CANDIDATE" ]; then
		echo "integrate: candidate is absent" >&2
		exit 3
	fi

	SDLC="$CANDIDATE/sdlc"
	RECORDS="$SDLC/records"
	WITNESS_PATH="$RECORDS/$QUEUE_ID-verified"
	if [ -L "$SDLC" ] || [ ! -d "$SDLC" ] \
		|| [ -L "$RECORDS" ] || [ ! -d "$RECORDS" ] \
		|| [ -L "$WITNESS_PATH" ] || [ ! -f "$WITNESS_PATH" ]; then
		echo "integrate: verified witness must be reached through regular, non-symlink paths" >&2
		exit 3
	fi

	if ! witness_text=$(cat "$WITNESS_PATH"); then
		echo "integrate: could not read verified witness" >&2
		exit 3
	fi
	if ! WITNESS=$(git -C "$CANDIDATE" rev-parse --verify "${witness_text}^{commit}" 2>/dev/null) \
		|| [ "$witness_text" != "$WITNESS" ] \
		|| ! printf '%s\n' "$WITNESS" | cmp -s - "$WITNESS_PATH"; then
		echo "integrate: verified witness must name exactly one full commit" >&2
		exit 3
	fi
	if ! TICKET=$(git -C "$REPO" rev-parse --verify "${BRANCH}^{commit}" 2>/dev/null) \
		|| ! HEAD=$(git -C "$CANDIDATE" rev-parse --verify 'HEAD^{commit}' 2>/dev/null) \
		|| [ "$WITNESS" != "$TICKET" ] || [ "$WITNESS" != "$HEAD" ]; then
		echo "integrate: verified witness does not match the candidate" >&2
		exit 3
	fi
	if ! git -C "$REPO" fetch --quiet origin; then
		echo "integrate: could not refresh origin/main for path policy" >&2
		exit 3
	fi
	# Let Git select forbidden paths so names containing newlines cannot evade policy.
	case "$QUEUE_FLOW" in
	build|quickfix)
		# A ticket may open exact file paths under sdlc/scripts/ or assembly/
		# for its own flight: one frontmatter line, `opens: <path> [<path>...]`.
		# The declaration is read from origin/main — never the candidate — so a
		# flight cannot widen its own authorization.
		opens=
		ticket=
		case "${QUEUE_REF-}" in
		sdlc/tickets/*) ticket=$(git -C "$REPO" show "origin/main:$QUEUE_REF" 2>/dev/null) || ticket= ;;
		esac
		if [ -n "$ticket" ]; then
			declared=$(printf '%s\n' "$ticket" | awk '/^---$/ { fence++; next } fence == 1 && /^opens:/')
			if [ "$(printf '%s\n' "$declared" | grep -c '^opens:')" -gt 1 ]; then
				echo "integrate: the ticket declares opens more than once" >&2
				exit 3
			fi
			if [ -n "$declared" ]; then
				opens=${declared#opens:}
				if [ -z "$(printf '%s' "$opens" | tr -d '[:space:]')" ]; then
					echo "integrate: malformed opens declaration: $declared" >&2
					exit 3
				fi
				for path in $opens; do
					case "$path" in
					*..*|*'*'*|*'?'*|*'['*|*/)
						echo "integrate: opens must name exact file paths: $path" >&2
						exit 3
						;;
					esac
					case "$path" in
					sdlc/scripts/*|assembly/*) ;;
					*)
						echo "integrate: opens may not name $path: only sdlc/scripts/ and assembly/ accept openings" >&2
						exit 3
						;;
					esac
				done
			fi
		fi
		set -- sdlc/tickets sdlc/scripts assembly skills sdlc/records \
			":(exclude,glob)sdlc/records/${QUEUE_ID}-?*.md"
		for path in $opens; do
			set -- "$@" ":(exclude,literal)$path"
		done
		if ! changed=$(git -C "$REPO" diff --no-ext-diff --no-renames --name-only "origin/main...$WITNESS" -- "$@"); then
			echo "integrate: could not inspect the candidate diff for path policy" >&2
			exit 3
		fi
		policy_error="integrate: $QUEUE_FLOW may not land that path"
		;;
	review)
		if ! changed=$(git -C "$REPO" diff --no-ext-diff --no-renames --name-only "origin/main...$WITNESS" -- . \
			':(exclude,glob)sdlc/issues/**' \
			":(exclude,glob)sdlc/records/${QUEUE_ID}-?*.md"); then
			echo "integrate: could not inspect the candidate diff for path policy" >&2
			exit 3
		fi
		policy_error="integrate: review may only land issue descendants and its direct completion record"
		;;
	esac
	if [ -n "$changed" ]; then
		printf '%s\n' "$changed" | sed 's/^/integrate: forbidden candidate path: /' >&2
		echo "$policy_error" >&2
		exit 3
	fi
	if ! git -C "$REPO" push --quiet origin "$WITNESS:main"; then
		echo "integrate: verified candidate could not fast-forward main" >&2
		exit 3
	fi
	printf 'landed %s\n' "$WITNESS"
fi

prune_worktrees() {
	git -C "$REPO" worktree prune >/dev/null 2>&1
}

remove_local_branch() {
	if git -C "$REPO" show-ref --verify --quiet "refs/heads/$BRANCH"; then
		git -C "$REPO" branch -D "$BRANCH" >/dev/null 2>&1
	else
		status=$?
		[ "$status" -eq 1 ]
	fi
}

remove_origin_branch() {
	if git -C "$REPO" ls-remote --exit-code --heads origin "refs/heads/$BRANCH" >/dev/null 2>&1; then
		git -C "$REPO" push --quiet origin --delete "$BRANCH" >/dev/null 2>&1
	else
		status=$?
		[ "$status" -eq 2 ]
	fi
}

cleanup_failures=
cleanup() {
	name=$1
	shift
	if "$@"; then
		return
	fi
	cleanup_failures="${cleanup_failures}${cleanup_failures:+, }$name"
}

for candidate in "$TREE" "$LEGACY_TREE"; do
	[ -e "$candidate" ] || continue
	cleanup "worktree removal $candidate" remove_tree "$candidate"
done
cleanup "worktree prune" prune_worktrees
cleanup "local branch $BRANCH" remove_local_branch
cleanup "origin branch $BRANCH" remove_origin_branch

if [ -n "$cleanup_failures" ]; then
	echo "integrate: teardown failed: $cleanup_failures" >&2
	exit 1
fi
