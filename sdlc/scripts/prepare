#!/bin/sh
# prepare — verify main is green, claim the ticket branch on origin, make a
# worktree, print its absolute path on stdout.
#
# Environment (queue ADR 0009): QUEUE_ID, QUEUE_REF, QUEUE_FLOW, QUEUE_CHANNEL;
# optional QUEUE_REPO.
# Exit vocabulary (queue ADR 0009):
#   0  tree ready, path on stdout
#   3  claimed elsewhere — another machine holds the branch on origin
#   4  environment refuses — main is not green (sdlc ADR 0006)
#   *  fault
# Nothing but the worktree path ever goes to stdout.
set -eu

# stdout is reserved for the one line this script owes its caller. Everything
# else a git or a gate prints is chatter and belongs on stderr.
exec 3>&1 1>&2

: "${QUEUE_ID:?prepare: QUEUE_ID is required}"

case "$QUEUE_ID" in
[0-9][0-9][0-9][0-9]) ;;
*)
	echo "prepare: QUEUE_ID must be exactly four digits" >&2
	exit 1
	;;
esac

if [ -n "${QUEUE_REPO-}" ]; then
	REPO=$QUEUE_REPO
else
	REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
fi
BRANCH="ticket/$QUEUE_ID"
WORKTREES=${SDLC_WORKTREES:-$HOME/workspace/worktrees}

origin_namespace() {
	origin=$(git -C "$REPO" remote get-url origin 2>/dev/null) || return 1
	namespace=$(printf '%s\n' "$origin" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s/\.git$//; s/:/\//g' | awk -F/ '{ for (i = 1; i <= NF; i++) if ($i != "") part[++n] = $i } END { if (n >= 2) print part[n - 1] "/" part[n] }')
	# The namespace becomes a path below WORKTREES; traversal components are not identities.
	case "$namespace" in ./*|../*|*/.|*/..) return 1 ;; esac
	printf '%s\n' "$namespace"
}

if ! NAMESPACE=$(origin_namespace) || [ -z "$NAMESPACE" ]; then
	echo "prepare: cannot derive owner/repository from origin" >&2
	exit 1
fi
if ! common=$(git -C "$REPO" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
	|| ! REPO_COMMON=$(CDPATH= cd -- "$common" && pwd -P); then
	echo "prepare: cannot determine Git common directory for $REPO" >&2
	exit 1
fi
TREE="$WORKTREES/$NAMESPACE/$QUEUE_ID"
HOST=$(hostname 2>/dev/null || uname -n)

# A candidate is ours only if Git identifies that path itself as a worktree
# top-level and both trees share this local repository's common directory.
candidate_owned() {
	candidate=$1
	top=$(git -C "$candidate" rev-parse --show-toplevel 2>/dev/null) || return 1
	candidate_path=$(CDPATH= cd -- "$candidate" && pwd -P) || return 1
	top_path=$(CDPATH= cd -- "$top" && pwd -P) || return 1
	[ "$candidate_path" = "$top_path" ] || return 1
	candidate_common=$(git -C "$candidate" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
	candidate_common=$(CDPATH= cd -- "$candidate_common" && pwd -P) || return 1
	[ "$candidate_common" = "$REPO_COMMON" ]
}

# Git is the normal remover. Recursive removal is only for its known stale
# metadata case, after ownership has been proved again at the point of use.
remove_tree() {
	candidate=$1
	if git -C "$REPO" worktree remove --force "$candidate" >/dev/null 2>&1; then
		return 0
	fi
	[ -e "$candidate" ] || return 0
	if ! candidate_owned "$candidate"; then
		echo "prepare: refusing to remove $candidate: it is not a worktree owned by $REPO" >&2
		return 1
	fi
	if ! rm -rf "$candidate"; then
		echo "prepare: could not remove worktree $candidate" >&2
		return 1
	fi
}

# Remove the tree and the local branch. Called on every refusal, so a refused
# prepare leaves nothing behind on this machine.
undo() {
	if [ -e "$TREE" ]; then
		if ! candidate_owned "$TREE"; then
			echo "prepare: refusing to remove $TREE: it is not a worktree owned by $REPO" >&2
			return 1
		fi
		remove_tree "$TREE" || return 1
	fi
	git -C "$REPO" worktree prune >/dev/null 2>&1 || return 1
	if git -C "$REPO" show-ref --verify --quiet "refs/heads/$BRANCH"; then
		git -C "$REPO" branch -D "$BRANCH" >/dev/null 2>&1 || return 1
	fi
}

# Read one remote claim coherently. An unparseable or moved claim remains a
# collision; only a fetched, exact-tip claim with our hostname is reclaimable.
observe_claim() {
	CLAIM_SHA=
	CLAIM_SUBJECT=
	CLAIM_OWN=0
	if ! claim=$(git -C "$REPO" ls-remote --heads origin "refs/heads/$BRANCH" 2>/dev/null); then
		return 1
	fi
	CLAIM_SHA=$(printf '%s\n' "$claim" | awk 'NR == 1 { print $1 }')
	[ -n "$CLAIM_SHA" ] || return 1
	if ! git -C "$REPO" fetch --quiet origin "refs/heads/$BRANCH"; then
		return 0
	fi
	if ! fetched=$(git -C "$REPO" rev-parse --verify FETCH_HEAD 2>/dev/null); then
		return 0
	fi
	[ "$fetched" = "$CLAIM_SHA" ] || return 0
	if ! CLAIM_SUBJECT=$(git -C "$REPO" log -1 --format=%s FETCH_HEAD 2>/dev/null); then
		return 0
	fi
	if ! claimant=$(printf '%s\n' "$CLAIM_SUBJECT" | sed -n 's/^claim: \([^[:space:]]\{1,\}\) [0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}T[0-9]\{2\}:[0-9]\{2\}:[0-9]\{2\}Z$/\1/p'); then
		return 0
	fi
	[ -n "$claimant" ] && [ "$claimant" = "$HOST" ] && CLAIM_OWN=1
	return 0
}

report_claim() {
	echo "prepare: $BRANCH is claimed on origin (${CLAIM_SUBJECT:-claim unreadable}) — check that machine" >&2
}

stale_claim_fault() {
	echo "prepare: our stale claim $BRANCH cannot be reclaimed: $1" >&2
}

reclaim_own_claim() {
	if [ ! -e "$TREE" ]; then
		stale_claim_fault "worktree is missing"
		return 1
	fi
	if ! candidate_owned "$TREE"; then
		stale_claim_fault "worktree is not owned by $REPO"
		return 1
	fi
	if ! tree_sha=$(git -C "$TREE" rev-parse --verify HEAD 2>/dev/null); then
		stale_claim_fault "worktree HEAD is unreadable"
		return 1
	fi
	if [ "$tree_sha" != "$CLAIM_SHA" ]; then
		stale_claim_fault "worktree HEAD differs from the claim"
		return 1
	fi
	if git -C "$REPO" show-ref --verify --quiet "refs/heads/$BRANCH"; then
		if ! branch_sha=$(git -C "$REPO" rev-parse --verify "refs/heads/$BRANCH"); then
			stale_claim_fault "local branch is unreadable"
			return 1
		fi
		if [ "$branch_sha" != "$CLAIM_SHA" ]; then
			stale_claim_fault "local branch differs from the claim"
			return 1
		fi
	fi
	if ! git -C "$REPO" push --quiet --force-with-lease="refs/heads/$BRANCH:$CLAIM_SHA" origin ":refs/heads/$BRANCH"; then
		stale_claim_fault "origin moved or refused deletion"
		return 1
	fi
	if ! undo; then
		stale_claim_fault "local teardown failed"
		return 1
	fi
}

# Every collision point has the same settlement: foreign claims continue to
# the exit-3 path, while an owned exact-tip claim is reclaimed and retried.
restart_if_own_claim() {
	[ "$CLAIM_OWN" = 1 ] || return 0
	if ! reclaim_own_claim; then
		exit 1
	fi
	exec 1>&3 "$0"
}

# 1. Fetch. Everything below reads origin/main, so it has to be current.
if ! git -C "$REPO" fetch --quiet --prune origin; then
	echo "prepare: git fetch origin failed" >&2
	exit 1
fi

# An existing path may be another clone's live worktree. A claim recorded by
# this host is recoverable only when this checkout owns the exact claimed tip.
if [ -e "$TREE" ]; then
	if observe_claim; then
		restart_if_own_claim
		report_claim
		exit 3
	fi
	echo "prepare: worktree path already exists: $TREE" >&2
	exit 1
fi

# 2. The tree branches from origin/main, NEVER from local main. A local main
# may be stale, may carry uncommitted state, and differs between machines
# (sdlc ADR 0006). This is deliberate — do not simplify it to `main`.
mkdir -p "$WORKTREES/$NAMESPACE"
if ! git -C "$REPO" worktree add --quiet -b "$BRANCH" "$TREE" origin/main; then
	# A competing prepare can claim the ticket between the check above and this
	# add. Preserve the occupied path for a foreign claim, but recover an exact
	# stale claim owned by this checkout.
	if observe_claim; then
		restart_if_own_claim
		report_claim
		exit 3
	fi
	echo "prepare: could not create worktree $TREE on $BRANCH" >&2
	exit 1
fi

# 3. Green check, in that tree, using this project's own gate ladder.
# It runs BEFORE the claim push, deliberately: a red main must not leave an
# orphan claim branch on origin for every ticket that tried and was refused.
gate() {
	script="$TREE/sdlc/scripts/$1"
	if [ ! -x "$script" ]; then
		echo "prepare: $REPO has no executable sdlc/scripts/$1" >&2
		return 2
	fi
	( cd "$TREE" && "$script" ) || return 1
}

# quickfix is exempt: repairing a red main is the whole job (sdlc ADR 0006).
if [ "${QUEUE_FLOW-}" != "quickfix" ]; then
	for g in lint test; do
		status=0
		gate "$g" || status=$?
		if [ "$status" -eq 0 ]; then
			continue
		fi
		if ! undo; then
			echo "prepare: cleanup after failed $g gate failed" >&2
			exit 1
		fi
		if [ "$status" = 2 ]; then
			exit 1 # a missing gate is a fault, not a refusal
		fi
		echo "prepare: origin/main is not green — sdlc/scripts/$g failed" >&2
		exit 4
	done
fi

# 4. Claim. The branch on origin is the lock, and the commit says who holds it
# and since when so the doctor can report staleness (queue ADR 0008).

# Look before pushing. A rejected push is the atomic guard, but it is not
# sufficient on its own: two clones of one repo can build a byte-identical
# empty claim commit in the same second, and git reports pushing an identical
# ref as "up to date" rather than rejecting it. Across machines the hostname
# in the message differs, so the commits differ and the push does reject; on
# one machine the lease is the exclusion that applies (queue ADR 0008's two
# scopes). This check closes the gap in between.
if observe_claim; then
	restart_if_own_claim
	if ! undo; then
		echo "prepare: cleanup after finding a held claim failed" >&2
		exit 1
	fi
	report_claim
	exit 3
fi

NOW=$(date -u +%Y-%m-%dT%H:%M:%SZ)
if ! git -C "$TREE" commit --quiet --allow-empty -m "claim: $HOST $NOW"; then
	if ! undo; then
		echo "prepare: cleanup after a failed claim commit failed" >&2
	fi
	echo "prepare: could not write the claim commit" >&2
	exit 1
fi

if ! git -C "$REPO" push --quiet origin "refs/heads/$BRANCH:refs/heads/$BRANCH"; then
	# Rejected because someone got there first, or because the push broke.
	# Only the first is a claim held elsewhere; the second is a fault.
	if observe_claim; then
		restart_if_own_claim
		if ! undo; then
			echo "prepare: cleanup after finding a held claim failed" >&2
			exit 1
		fi
		report_claim
		exit 3
	fi
	if ! undo; then
		echo "prepare: cleanup after a failed claim push failed" >&2
	fi
	echo "prepare: pushing the claim $BRANCH failed" >&2
	exit 1
fi

# 5. The path, and only the path.
printf '%s\n' "$TREE" >&3
