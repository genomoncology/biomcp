import json
import sys

tests = {}
for line in open(sys.argv[1], errors="replace"):
    try:
        event = json.loads(line)
    except json.JSONDecodeError:
        continue
    if event.get("type") != "test":
        continue
    if event.get("event") not in ("ok", "failed", "timeout", "ignored"):
        continue
    time = event.get("exec_time")
    if time is None:
