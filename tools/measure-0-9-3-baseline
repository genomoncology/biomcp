  if ((!DRY_RUN)); then
    "${TOML_PY[@]}" - "$LOGD/dep-counts.txt" <<'PY'
import sys
import tomllib
from collections import Counter
from pathlib import Path

out = []
manifest = tomllib.loads(Path("Cargo.toml").read_text())
normal = manifest.get("dependencies", {})
optional = sorted(k for k, v in normal.items() if isinstance(v, dict) and v.get("optional"))
dev = manifest.get("dev-dependencies", {})
win = manifest.get("target", {}).get('cfg(windows)', {}).get("dependencies", {})
unix_dev = manifest.get("target", {}).get("cfg(unix)", {}).get("dev-dependencies", {})
out.append(f"RESULT direct_dependencies_normal = {len(normal)} (optional: {len(optional)}: {', '.join(optional)})")
out.append(f"RESULT direct_dependencies_dev = {len(dev)}")
out.append(f"RESULT direct_dependencies_windows_only = {len(win)}")
out.append(f"RESULT direct_dependencies_unix_dev = {len(unix_dev)}")

lock = tomllib.loads(Path("Cargo.lock").read_text())
packages = lock.get("package", [])
names = Counter(p["name"] for p in packages)
dups = sorted(n for n, c in names.items() if c > 1)
out.append(f"RESULT cargo_lock_packages = {len(packages)}")
out.append(f"RESULT cargo_lock_duplicate_names = {len(dups)} (extra copies: {sum(names[n] for n in dups) - len(dups)})")
Path(sys.argv[1]).write_text("\n".join(out) + "\n")
print("\n".join(out))
PY
  fi
  runsh "cargo tree --locked --no-default-features -e normal,build --prefix none > $LOGD/tree-normal-build.txt"
  runsh "cargo tree --locked --no-default-features -e normal,build,dev --prefix none > $LOGD/tree-normal-build-dev.txt"
  show "${TOML_PY[*]} (unique crate name@version pairs in each cargo tree, workspace members excluded)"
  if ((!DRY_RUN)); then
    "${TOML_PY[@]}" - "$LOGD/tree-normal-build.txt" "$LOGD/tree-normal-build-dev.txt" <<'PY'
import sys
from collections import Counter

workspace = {"biomcp-cli", "biomcp-mcp-contract-client"}
for label, path in (("normal_build", sys.argv[1]), ("with_dev", sys.argv[2])):
    pairs = set()
    for line in open(path):
        fields = line.split()
        if len(fields) < 2 or not fields[1].startswith("v"):
            continue
        if fields[0] in workspace:
            continue
        pairs.add((fields[0], fields[1]))
    print(f"RESULT crates_compiled_{label} = {len(pairs)}")
    names = Counter(name for name, _ in pairs)
    dups = sorted(n for n, c in names.items() if c > 1)
    print(f"RESULT duplicate_crate_names_{label} = {len(dups)} ({', '.join(dups) if dups else 'none'})")
