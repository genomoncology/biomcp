    "tools/run-offline -- tools/with-build-identity cargo nextest run --locked --no-default-features --lib -E 'test(gene_markdown)' > $LOGD/edit-test-group.log 2>&1" "$LOGD/edit-test-group.log"
  if ((!DRY_RUN)); then
    result edit_test_group_exit "$(<"$LOGD/edit-test-group.exit")"
    if [[ "$(<"$LOGD/edit-test-group.exit")" != 0 ]] || ! grep -qE 'Summary .* [1-9][0-9]* tests? run:' "$LOGD/edit-test-group.log"; then
      result edit_test_group_collection "incomplete (failed or empty test group; retain log)"
    else
      result edit_test_group_collection complete
    fi
  fi
fi

# ---------------------------------------------------------------- ci history

if want_section ci-history; then
  say ci-history "the last ten green CI runs of ci.yml (wall time and runner-minutes)"
  show "gh api + python3 (per run: updated_at - run_started_at; runner-minutes summed over jobs)"
  if ((!DRY_RUN)); then
    python3 - <<'PY'
import json
import subprocess
from datetime import datetime

def gh(path):
    out = subprocess.run(["gh", "api", path], check=True, capture_output=True, text=True)
    return json.loads(out.stdout)

def parse(iso):
    return datetime.fromisoformat(iso.replace("Z", "+00:00"))

try:
    runs = gh("repos/genomoncology/biomcp/actions/workflows/ci.yml/runs?status=success&per_page=10")
except (subprocess.CalledProcessError, FileNotFoundError) as error:
    print(f"skipped: gh api unavailable or unauthenticated ({error})")
    raise SystemExit(0)
walls = []
runner_totals = []
for run in runs.get("workflow_runs", []):
    start = run.get("run_started_at") or run.get("created_at")
    wall = (parse(run["updated_at"]) - parse(start)).total_seconds() / 60.0
    jobs = gh(f"repos/genomoncology/biomcp/actions/runs/{run['id']}/jobs?per_page=100")
    job_minutes = 0.0
    for job in jobs.get("jobs", []):
        if job.get("completed_at") and job.get("started_at"):
            job_minutes += (parse(job["completed_at"]) - parse(job["started_at"])).total_seconds() / 60.0
    walls.append(wall)
    runner_totals.append(job_minutes)
    print(f"run {run['id']} {run['head_sha'][:9]} {start} wall {wall:.1f}m runner {job_minutes:.1f}m")
walls_sorted = sorted(walls)
print(f"RESULT ci_green_runs = {len(walls)}")
print(f"RESULT ci_wall_minutes_median = {walls_sorted[len(walls_sorted) // 2]:.1f}")
print(f"RESULT ci_wall_minutes_range = {walls_sorted[0]:.1f}-{walls_sorted[-1]:.1f}")
print(f"RESULT ci_runner_minutes_mean = {sum(runner_totals) / len(runner_totals):.1f}")
full = [(w, r) for w, r in zip(walls, runner_totals) if r > 30.0]
full_walls = sorted(w for w, _ in full)
if full:
    print(f"RESULT ci_full_runs = {len(full)} (runner-minutes over 30; docs-only runs excluded)")
    print(f"RESULT ci_full_wall_minutes_median = {full_walls[len(full_walls) // 2]:.1f}")
    print(f"RESULT ci_full_wall_minutes_range = {full_walls[0]:.1f}-{full_walls[-1]:.1f}")
    print(f"RESULT ci_full_runner_minutes_mean = {sum(r for _, r in full) / len(full):.1f}")
PY
  fi
fi

