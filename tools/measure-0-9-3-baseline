#!/usr/bin/env bash
# Measure the 0.9.3 baseline numbers for one BioMCP clone.
#
# Every number prints with the command behind it, in this shape:
#
#   ### <section-id> — <title>
#   $ <command>
#   <command output>
#   RESULT <key> = <value>
#
# so a record can hold the exact evidence and a second run can be compared
# key by key. The script carries no host locks: schedule the measurement
# through the configured build runner and run both comparison arms on
# that one host to keep the comparison like-for-like. The script refuses
# to start while any build, test, or gate process is alive.
#
# Usage:
#   tools/measure-0-9-3-baseline <clone-dir> [options]
#
# Options:
#   --dry-run        print every command without running anything
#   --only a,b,c     run only the named sections
#   --expect-tag T   fail unless the clone's HEAD is exactly at tag T
#   --release-record FILE   reuse a retained release record (no network calls)
#   --target-build-log TARGET=FILE   reuse a complete release build log
#
# The clone must be a clean checkout of the tree to measure (ticket 2069
# measures tag v0.9.2). Timed build numbers assume the host's documented
# cargo config (incremental off, line-tables-only dev debug) and a quiet
# machine; the host section records both.

set -euo pipefail

FAILED=0
DRY_RUN=0
ONLY=""
EXPECT_TAG=""
CLONE=""
RELEASE_RECORD=""
TARGET_BUILD_LOGS=()

usage() {
  cat >&2 <<'USAGEEOF'
usage: measure-0-9-3-baseline <clone-dir> [--dry-run] [--only a,b,c]
                              [--expect-tag vX.Y.Z]
                              [--release-record FILE] [--target-build-log TARGET=FILE]
USAGEEOF
  exit 2
}

while (($#)); do
  case "$1" in
    --dry-run) DRY_RUN=1 ;;
    --only) shift; ONLY="${1:-}" ;;
    --only=*) ONLY="${1#*=}" ;;
    --expect-tag) shift; EXPECT_TAG="${1:-}" ;;
    --expect-tag=*) EXPECT_TAG="${1#*=}" ;;
    --release-record) shift; RELEASE_RECORD="${1:-}" ;;
    --target-build-log) shift; TARGET_BUILD_LOGS+=("${1:-}") ;;
    -h|--help) sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 0 ;;
    -*) echo "unknown option: $1" >&2; usage ;;
    *) if [[ -n "$CLONE" ]]; then echo "one clone directory only" >&2; usage; fi
       CLONE="$1" ;;
  esac
  shift
done

[[ -n "$CLONE" ]] || usage
[[ -d "$CLONE" ]] || { echo "clone directory not found: $CLONE" >&2; exit 2; }
# Resolve retained inputs before changing into the measured checkout.
if [[ -n "$RELEASE_RECORD" ]]; then
  RELEASE_RECORD="$(python3 -c 'import os,sys; print(os.path.abspath(sys.argv[1]))' "$RELEASE_RECORD")"
fi
for i in "${!TARGET_BUILD_LOGS[@]}"; do
  entry="${TARGET_BUILD_LOGS[$i]}"
  [[ "$entry" == *=* ]] || { echo "target build log requires TARGET=FILE" >&2; exit 2; }
  path="$(python3 -c 'import os,sys; print(os.path.abspath(sys.argv[1]))' "${entry#*=}")"
  TARGET_BUILD_LOGS[$i]="${entry%%=*}=$path"
done

export PATH="$HOME/.cargo/bin:$HOME/.local/bin:$PATH"
cd "$CLONE"
CLONE="$(pwd)"
LOGD=".cache/measure"
mkdir -p "$LOGD"
# Keep temporary fixtures inside the checkout, as the routine gates do.
# Store security checks deliberately reject symlink components in paths.
mkdir -p "$LOGD/tmp"
chmod 700 "$LOGD/tmp"
TMPDIR="$(cd "$LOGD/tmp" && pwd -P)"
export TMPDIR

say() { printf '\n### %s — %s\n' "$1" "$2"; }
result() { printf 'RESULT %s = %s\n' "$1" "$2"; }
show() { printf '$ %s\n' "$1"; }

# The manifest and lockfile parsers need tomllib (Python 3.11); the macOS
# gate host's system python3 is older, so they run under the first
# interpreter that has it, syncing the clone's uv venv when needed.
if python3 -c 'import tomllib' >/dev/null 2>&1; then
  TOML_PY=(python3)
elif command -v uv >/dev/null 2>&1; then
  TOML_PY=(uv run python3)
else
  TOML_PY=(python3)
fi

# runsh runs a shell string and prints it first; the record shows the
# command behind every number.
runsh() {
  show "$1"
  if ((DRY_RUN)); then return 0; fi
  bash -c "$1"
}

# timedsh prints the command, runs it, and records its wall time.
# python3's clock gives the same sub-second precision on every gate host;
# GNU date's %s.%N does not exist on the macOS one.
timedsh() {
  local label="$1" command="$2" start end wall status logfile
  shift 2
  show "$command"
  if ((DRY_RUN)); then result "${label}_wall_s" dry-run; return 0; fi
  start=$(python3 -c 'import time; print(time.time())')
  if bash -e -o pipefail -c "$command"; then
    :
  else
    status=$?
    for logfile in "$@"; do cat "$logfile" >&2; done
    return "$status"
  fi
  end=$(python3 -c 'import time; print(time.time())')
  wall=$(awk -v s="$start" -v e="$end" 'BEGIN { printf "%.1f", e - s }')
  result "${label}_wall_s" "$wall"
}

# timedsh_exit prints the command, runs it, records its wall time, and
# writes the command's own exit status to the named file. A coverage suite's
# nonzero exit is data the reports need, so the run continues and the status
# reaches the report step instead of stopping the script.
timedsh_exit() {
  local label="$1" exitfile="$2" command="$3" start end wall status logfile
  shift 3
  show "$command"
  if ((DRY_RUN)); then result "${label}_wall_s" dry-run; return 0; fi
  start=$(python3 -c 'import time; print(time.time())')
  set +e
  bash -e -o pipefail -c "$command"
  status=$?
  set -e
  end=$(python3 -c 'import time; print(time.time())')
  wall=$(awk -v s="$start" -v e="$end" 'BEGIN { printf "%.1f", e - s }')
  if [[ "$status" != 0 ]]; then
    FAILED=1
    for logfile in "$@"; do cat "$logfile" >&2; done
  fi
  printf '%s\n' "$status" >"$exitfile"
  result "${label}_wall_s" "$wall"
}

want_section() {
  [[ -z "$ONLY" ]] && return 0
  [[ ",$ONLY," == *",$1,"* ]]
}

quiet_pids() {
  local name pids
  for name in cargo rustc cargo-nextest clippy-driver pytest mkdocs make uv cargo-deny cargo-llvm-cov; do
    pids=$(pgrep -x "$name" 2>/dev/null || true)
    if [[ -n "$pids" ]]; then
      echo "busy: process(es) named $name are running:" >&2
      ps -o pid=,etime=,args= -p "$(echo "$pids" | tr '\n' ',' | sed 's/,$//')" >&2 || true
      return 1
    fi
  done
  return 0
}

# ---------------------------------------------------------------- host

# du_bytes, file_size and gnu_time answer on every gate host; the
# Linux-specific tools stay first where they exist.
file_size() { stat -c %s "$1" 2>/dev/null || stat -f %z "$1"; }
du_bytes() {
  if du -sb . >/dev/null 2>&1; then du -sb "$1" | awk '{print $1}'
  else du -sk "$1" | awk '{print $1 * 1024}'; fi
}
# gnu_time finds a GNU time on the host (Linux /usr/bin/time, gtime
# elsewhere) or fails so the caller uses native BSD time.
gnu_time() {
  if /usr/bin/time --version >/dev/null 2>&1; then echo /usr/bin/time
  elif command -v gtime >/dev/null 2>&1; then command -v gtime
  else return 1; fi
}

