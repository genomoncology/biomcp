    tests[event.get("name", "?")] = max(tests.get(event.get("name", "?"), 0.0), float(time))
slow = sorted(((t, n) for n, t in tests.items() if t >= 1.0), reverse=True)
print(f"RESULT rust_tests_with_duration = {len(tests)}")
print(f"RESULT tests_over_1s = {len(slow)}")
print(f"RESULT tests_over_1s_sum_s = {sum(t for t, _ in slow):.1f}")
print("slowest tests:")
for t, n in slow[:15]:
    print(f"  {t:8.1f}s  {n}")
