# ---------------------------------------------------------------- coverage

if want_section coverage; then
  say coverage "line coverage of three suites through cargo-llvm-cov (dev build instrumented)"

  # cov_suite_reason[label] names every suite whose run cannot back a
  # coverage number: its exit is nonzero, its summary shows failed tests,
  # or its summary never parsed. A report set fed by any such suite prints
  # incomplete instead of a percentage.
  declare -A cov_suite_reason=()

  # cov_clause prints the count of one "N <clause>" piece of a suite
  # summary (cov_clause <clause> <summary>), or nothing when the piece is
  # absent (nextest omits a zero "failed" clause; pytest omits zero pieces
  # entirely).
  cov_clause() {
    grep -oE "[0-9]+ $1" <<<"$2" | grep -oE '^[0-9]+' || true
  }

  # record_cov_suite prints one RESULT line with a suite's exit status and
  # test counts, and fills cov_suite_reason for a failed or unproven run.
  record_cov_suite() {
    local label="$1" kind="$2" exitfile="$3" logfile="$4"
    local status summary counts reason n_run n_passed n_failed n_errors n_timeout n_skipped pages failed_pages
    status="$(<"$exitfile")"
    counts="summary unparsed"
    n_failed=""
    n_errors=""
    n_timeout=""
    case "$kind" in
      nextest)
        summary="$(grep -E 'Summary \[' "$logfile" | tail -1 || true)"
        if [[ -n "$summary" ]]; then
          # Fail-fast summaries show executed/selected tests. The
          # numerator is the work that actually ran.
          n_run="$(sed -nE 's/.*] +([0-9]+)(\/[0-9]+)? tests? run:.*/\1/p' <<<"$summary")"
          n_passed="$(cov_clause passed "$summary")"
          n_failed="$(cov_clause failed "$summary")"
          n_timeout="$(cov_clause 'timed out' "$summary")"
          n_skipped="$(cov_clause skipped "$summary")"
          if [[ -n "$n_run" ]]; then
            counts="${n_run} run: ${n_passed:-0} passed, ${n_failed:-0} failed, ${n_timeout:-0} timed out, ${n_skipped:-0} skipped"
          fi
        fi
        ;;
      pytest)
        summary="$(grep -E '^=+ .* (passed|failed|error).* =+$' "$logfile" | tail -1 || true)"
        if [[ -n "$summary" ]]; then
          n_passed="$(cov_clause passed "$summary")"
          n_failed="$(cov_clause failed "$summary")"
          n_errors="$(cov_clause errors? "$summary")"
          n_skipped="$(cov_clause skipped "$summary")"
          counts="${n_passed:-0} passed, ${n_failed:-0} failed, ${n_errors:-0} errors, ${n_skipped:-0} skipped"
        fi
        ;;
      spec)
        # Current runners list all selected pages in one header; older
        # runners print one singular header for each page.
        pages="$(awk '
          /^=== spec pages: / {
            sub(/^=== spec pages: /, ""); sub(/ ===$/, "")
            aggregate += NF
          }
          /^=== spec page: / { singular++ }
          END { print aggregate + singular }
        ' "$logfile")"
        failed_pages="$(grep -oE 'spec run failed \([0-9]+\)' "$logfile" | grep -oE '[0-9]+' | tail -1 || true)"
        if [[ -z "$failed_pages" ]]; then
          failed_pages="$(grep -c 'spec page failed: ' "$logfile" || true)"
        fi
        n_failed="$failed_pages"
        if ((pages > 0)); then
          counts="${pages} pages, ${failed_pages:-0} failed"
        fi
        ;;
    esac
    result "coverage_${label}" "exit ${status}; ${counts}"
    reason=""
    if [[ "$counts" == "summary unparsed" ]]; then
      reason="summary unparsed"
    elif [[ -n "$n_failed" && "$n_failed" != "0" ]]; then
      reason="${n_failed} failed"
      if [[ -n "$n_errors" && "$n_errors" != "0" ]]; then
        reason="$reason, ${n_errors} errors"
      fi
    elif [[ -n "$n_errors" && "$n_errors" != "0" ]]; then
      reason="${n_errors} errors"
    elif [[ -n "$n_timeout" && "$n_timeout" != "0" ]]; then
      reason="${n_timeout} timed out"
    elif [[ "$status" != "0" ]]; then
      reason="exit ${status}"
    fi
    if [[ -n "$reason" ]]; then
      cov_suite_reason["$label"]="${label}: ${reason}"
    fi
  }

  COVT="target/llvm-cov-target"
  # cov_build_env_keys names every key the coverage build environment
  # exports, so the lanes that never compile anything can strip exactly
  # those keys again before they run.
  COV_BUILD_ENV_KEYS=()
  declare -A COV_BUILD_ENV_RESTORE=()
  remember_cov_env() {
    local key="$1"
    if [[ ! ${COV_BUILD_ENV_RESTORE[$key]+saved} ]]; then
      COV_BUILD_ENV_RESTORE[$key]="$(declare -p "$key" 2>/dev/null || printf 'unset %q' "$key")"
    fi
  }
  runsh 'cargo llvm-cov clean --workspace'
  show 'eval each line of "cargo llvm-cov show-env" as an export; CARGO_TARGET_DIR=target/llvm-cov-target; LLVM_PROFILE_FILE per suite'
  if ((!DRY_RUN)); then
    while IFS= read -r line; do
      remember_cov_env "${line%%=*}"
      eval "export $line"
      COV_BUILD_ENV_KEYS+=("${line%%=*}")
    done < <(cargo llvm-cov show-env 2>/dev/null | grep -E '^[A-Z_]+=')
    remember_cov_env CARGO_INCREMENTAL
    remember_cov_env CARGO_TARGET_DIR
    export CARGO_INCREMENTAL=0
    export CARGO_TARGET_DIR="$PWD/$COVT"
    COV_BUILD_ENV_KEYS+=(CARGO_INCREMENTAL CARGO_TARGET_DIR)
    mkdir -p "$CARGO_TARGET_DIR"
  fi
  timedsh coverage_build \
    "cargo build --locked --no-default-features --all-targets > $LOGD/cov-build.log 2>&1" "$LOGD/cov-build.log"
  # absolute path: the suites run subprocesses from many working
  # directories, and a relative profile path silently drops their profiles
  export LLVM_PROFILE_FILE="$CARGO_TARGET_DIR/out-%8m.profraw"
  timedsh_exit coverage_integration_tests "$LOGD/cov-integration.exit" \
    "tools/run-offline -- cargo nextest run --locked --no-default-features -E 'kind(test)' > $LOGD/cov-integration.log 2>&1" "$LOGD/cov-integration.log"
  runsh "grep -E 'Summary \\[|tests? run:' $LOGD/cov-integration.log | tail -1 || true"
  if ((!DRY_RUN)); then
    record_cov_suite integration_tests nextest "$LOGD/cov-integration.exit" "$LOGD/cov-integration.log"
  fi
  export LLVM_PROFILE_FILE="$CARGO_TARGET_DIR/unit-%8m.profraw"
  timedsh_exit coverage_unit_tests "$LOGD/cov-unit.exit" \
    "tools/run-offline -- cargo nextest run --locked --no-default-features -E 'kind(lib) | kind(bin)' > $LOGD/cov-unit.log 2>&1" "$LOGD/cov-unit.log"
  runsh "grep -E 'Summary \\[|tests? run:' $LOGD/cov-unit.log | tail -1 || true"
  if ((!DRY_RUN)); then
    record_cov_suite unit_tests nextest "$LOGD/cov-unit.exit" "$LOGD/cov-unit.log"
  fi
  # Driver suites consume prepared instrumented binaries, while nested
  # Cargo checks need the caller's ordinary compiler/cache/linker settings.
  # Restore each previous value, or unset keys introduced by show-env.
  show "restore ${COV_BUILD_ENV_KEYS[*]:-<every show-env key, CARGO_INCREMENTAL, CARGO_TARGET_DIR>}"
  if ((!DRY_RUN)); then
    for key in "${!COV_BUILD_ENV_RESTORE[@]}"; do
      eval "${COV_BUILD_ENV_RESTORE[$key]}"
    done
  fi
  export LLVM_PROFILE_FILE="$PWD/$COVT/out-%8m.profraw"
  timedsh_exit coverage_python_lane "$LOGD/cov-pytest.exit" \
    "tools/run-offline -- env BIOMCP_ROUTINE_TEST_LANE=1 BIOMCP_BIN=\$PWD/$COVT/debug/biomcp uv run --no-sync pytest tests/ -n 4 --dist loadfile --basetemp $LOGD/pytest-basetemp > $LOGD/cov-pytest.log 2>&1" "$LOGD/cov-pytest.log"
  runsh "grep -E '^=+ .* (passed|failed|error).* =+$' $LOGD/cov-pytest.log | tail -2 || true"
  if ((!DRY_RUN)); then
    record_cov_suite python_lane pytest "$LOGD/cov-pytest.exit" "$LOGD/cov-pytest.log"
  fi
  say coverage "spec lane against the instrumented dev binary (hand-written artifacts env)"
  runsh "cat > .cache/spec-artifacts.env <<'ENVEOF'
export BIOMCP_SPEC_ARTIFACT_MODE=spec
export BIOMCP_SPEC_FEATURE_OFF_BIN=$PWD/$COVT/debug/biomcp
export BIOMCP_SPEC_MCP_EXAMPLE_BIN=$PWD/$COVT/debug/examples/rmcp_streamable_http_contract
export BIOMCP_SPEC_CARGO_TREE=$PWD/.cache/spec-artifacts/cargo-tree-no-default-features.txt
export BIOMCP_SPEC_CARGO_METADATA=$PWD/.cache/spec-artifacts/cargo-metadata.json
export BIOMCP_BIN=$PWD/$COVT/debug/biomcp
ENVEOF
cat .cache/spec-artifacts.env"
  timedsh_exit coverage_spec_lane "$LOGD/cov-spec.exit" \
    "PATH=\"$PWD/$COVT/debug:\$PATH\" BIOMCP_SPEC_ARTIFACTS_PREPARED=1 ROUTINE_CARGO_FEATURES=--no-default-features SPEC_PROFILE=dev tools/run-offline -- bash scripts/run-specs.sh spec > $LOGD/cov-spec.log 2>&1" "$LOGD/cov-spec.log"
  runsh "tail -4 $LOGD/cov-spec.log || true"
  if ((!DRY_RUN)); then
    record_cov_suite spec_lane spec "$LOGD/cov-spec.exit" "$LOGD/cov-spec.log"
  fi
  # Reports: report merges every profraw under target/llvm-cov-target, so
  # the set not being reported moves aside first. Test code leaves the
  # report by path; inline #[cfg(test)] modules stay in, so these are the
  # llvm-cov view, not the span-reduced view of the iteration-speed study.
  # Field 10 of the TOTAL row is the Lines cover percentage.
  COV_REGEX='(^|/)(tests?|examples?|benches)/|(^|/)(tests?\.rs|_tests?\.rs|tests?_[^/]*\.rs)$|test_support|(^|/)generated/'
  echo "denominator, one rule for all three reports: product code only — removed by --ignore-filename-regex: files under a tests/, test/, examples/, example/, benches/ or bench/ directory; files named tests.rs, test.rs, _tests.rs, _test.rs, tests_*.rs or test_*.rs; any path containing test_support; files under a generated/ directory — inline #[cfg(test)] modules stay counted"
  COV_HOLD="$LOGD/cov-hold"
  mkdir -p "$COV_HOLD"
  for report_set in outside-in unit combined; do
    say coverage "report: $report_set"
    case "$report_set" in
      outside-in) aside="unit"; feeds="integration_tests python_lane spec_lane" ;;
      unit) aside="out"; feeds="unit_tests" ;;
      combined) aside=""; feeds="integration_tests python_lane spec_lane unit_tests" ;;
    esac
    if ((!DRY_RUN)); then
      if [[ -n "$aside" ]]; then
        show "mv $COVT/$aside-*.profraw $COV_HOLD/ (report the other set)"
        mv "$COVT"/$aside-*.profraw "$COV_HOLD"/ 2>/dev/null || true
      else
        show "mv $COV_HOLD/*.profraw $COVT/ (report everything)"
        mv "$COV_HOLD"/*.profraw "$COVT"/ 2>/dev/null || true
      fi
    fi
    # report discovers profraws and objects under target/llvm-cov-target on
    # its own, but only while no show-env export pins its search: the eval'd
    # CARGO_LLVM_COV_TARGET_DIR (printed before CARGO_TARGET_DIR was set, so
    # it names the plain target directory, which holds no profraws at its
    # top level) pins it. Driver suites already restored the caller's
    # environment; these report-only removals prevent any caller pins
    # from redirecting profile discovery.
    runsh "env -u CARGO_TARGET_DIR -u CARGO_LLVM_COV -u CARGO_LLVM_COV_SHOW_ENV -u CARGO_LLVM_COV_TARGET_DIR cargo llvm-cov report --ignore-filename-regex '$COV_REGEX' > $LOGD/cov-report-${report_set//-/_}.txt 2>&1 || { status=\$?; cat $LOGD/cov-report-${report_set//-/_}.txt >&2; exit \$status; }; tail -4 $LOGD/cov-report-${report_set//-/_}.txt"
    if ((!DRY_RUN)); then
      incomplete=""
      for feed in $feeds; do
        if [[ -n "${cov_suite_reason[$feed]:-}" ]]; then
          incomplete="${incomplete:+$incomplete, }${cov_suite_reason[$feed]}"
        fi
      done
      if [[ -n "$incomplete" ]]; then
        # a set fed by a failed or unproven suite never prints a number
        result "coverage_${report_set//-/_}_lines_pct" "incomplete ($incomplete)"
      else
        pct=$(awk '/^TOTAL/ {print $10}' "$LOGD/cov-report-${report_set//-/_}.txt" | tr -d '%')
        result "coverage_${report_set//-/_}_lines_pct" "${pct:-parse-failed}"
      fi
      if [[ -n "$aside" ]]; then
        show "mv $COV_HOLD/*.profraw $COVT/ (restore)"
        mv "$COV_HOLD"/*.profraw "$COVT"/ 2>/dev/null || true
      fi
    fi
  done
fi

# ---------------------------------------------------------------- run time (amendment)

if want_section runtime; then
  say runtime "run-time measurements with the release binary (thin LTO, one codegen unit)"
  # The host's real cache root follows the platform default: ~/.cache on
  # Linux, ~/Library/Caches on macOS.
  runsh 'HOST_CACHE=$(python3 -c "import sys; print(sys.argv[1] if sys.platform != \"darwin\" else sys.argv[2])" "$HOME/.cache/biomcp" "$HOME/Library/Caches/biomcp"); { find "$HOST_CACHE/http" -type f 2>/dev/null || true; } | wc -l; du -sh "$HOST_CACHE" 2>/dev/null || echo "no host cache"'
  show "python3 (five warm/cache-off pairs; ten drug-card pairs; raw samples, median and spread in seconds)"
  if ((!DRY_RUN)); then
    if RUN_SCRATCH="$PWD/$LOGD/runtime" python3 - <<'PY'
import hashlib
import json
import os
import statistics
import subprocess
import sys
import time
from pathlib import Path

bin_path = os.path.abspath("target/release/biomcp")
scratch = Path(os.environ["RUN_SCRATCH"])
scratch.mkdir(parents=True, exist_ok=True)
commands = {
    "get_gene_BRAF": ["get", "gene", "BRAF"],
    "get_variant_BRAF_V600E": ["get", "variant", "BRAF V600E"],
    "get_drug_imatinib": ["get", "drug", "imatinib"],
    "search_article_BRAF": ["search", "article", "-g", "BRAF", "--limit", "10"],
    "search_all_BRAF_melanoma": ["--json", "search", "all", "--gene", "BRAF", "--disease", "melanoma", "--counts-only"],
}
samples = []
summary = {}


def run_once(case, argv, cache, mode, phase):
    env = dict(os.environ)
    env["BIOMCP_CACHE_DIR"] = str(cache)
    if mode == "default":
        env.pop("BIOMCP_CACHE_MODE", None)
    else:
        env["BIOMCP_CACHE_MODE"] = mode
    cache.mkdir(parents=True, exist_ok=True)
    start = time.perf_counter()
    timed_out = False
    try:
        proc = subprocess.run([bin_path, *argv], capture_output=True, env=env, timeout=180)
        output, errors, code = proc.stdout, proc.stderr, proc.returncode
    except subprocess.TimeoutExpired as error:
        output, errors, code = error.stdout or b"", error.stderr or b"", None
        timed_out = True
    elapsed = time.perf_counter() - start
    stem = f"{len(samples):04d}-{case}-{phase}-{mode}"
    stdout_file, stderr_file = stem + ".stdout", stem + ".stderr"
    (scratch / stdout_file).write_bytes(output)
    (scratch / stderr_file).write_bytes(errors)
    gwas_errors = []
    try:
        payload = json.loads(output)
        gwas_errors = [section.get("error") for section in payload.get("sections", [])
                       if section.get("entity") == "gwas"]
    except (ValueError, AttributeError, TypeError):
        pass
    sample = dict(case=case, argv=argv, phase=phase, mode=mode,
                  cache_dir=os.path.relpath(cache, scratch), elapsed_s=elapsed,
                  exit_code=code, timed_out=timed_out, gwas_errors=gwas_errors,
                  stdout_file=stdout_file, stderr_file=stderr_file,
                  stdout_bytes=len(output), stdout_sha256=hashlib.sha256(output).hexdigest())
    samples.append(sample)
    (scratch / "samples.json").write_text(json.dumps(samples, indent=2) + "\n")
    if code != 0 or timed_out:
        print("failed command: " + " ".join([bin_path, *argv]), file=sys.stderr)
        print(output.decode(errors="replace"), file=sys.stderr, end="")
        print(errors.decode(errors="replace"), file=sys.stderr, end="")
    print(f"sample {stem}: {elapsed:.6f}s exit {code} timeout {timed_out} gwas {gwas_errors}", flush=True)
    return sample


def report(label, values):
    times = [sample["elapsed_s"] for sample in values]
    median = statistics.median(times)
    spread = max(times) - min(times)
    summary[label] = dict(median_s=median, spread_s=spread,
                          exit_codes=[sample["exit_code"] for sample in values],
                          timeouts=sum(sample["timed_out"] for sample in values))
    print(f"RESULT runtime_{label}_median_s = {median:.6f}")
    print(f"RESULT runtime_{label}_spread_s = {spread:.6f}")
    (scratch / "summary.json").write_text(json.dumps(summary, indent=2) + "\n")


large = Path.home() / ("Library/Caches/biomcp" if sys.platform == "darwin" else ".cache/biomcp")
for label, cache in (("empty_cache", scratch / "empty-cache"), ("large_cache", large)):
    values = [run_once("version", ["--version"], cache, "default", "measure") for _ in range(5)]
    report("version_" + label, values)

for case, argv in commands.items():
    warm = scratch / "warm-cache" / case
    run_once(case, argv, warm, "default", "prefetch")
    pairs = {"infinite": [], "off": []}
    for index in range(10 if case == "get_drug_imatinib" else 5):
        pairs["infinite"].append(run_once(case, argv, warm, "infinite", "measure"))
        # Each bypass gets its own root. It cannot migrate, clean or erase warm data.
        off = scratch / "off-cache" / case / str(index)
        pairs["off"].append(run_once(case, argv, off, "off", "measure"))
    for mode, label in (("infinite", "warm"), ("off", "nocache")):
        report(label + "_" + case, pairs[mode])

# Default mode observes the day-cache rule, separately from infinite mode.
# Drug cards include openFDA labels/counts plus uncached providers: live timing
# alone does not prove absence of provider requests.
for case, argv in {
    "day_gwas_BRAF": ["--json", "search", "gwas", "-g", "BRAF"],
    "day_openfda_drug_imatinib": ["get", "drug", "imatinib"],
}.items():
    warm = scratch / "day-cache" / case
    run_once(case, argv, warm, "default", "prefetch")
    values = [run_once(case, argv, warm, "default", "measure") for _ in range(5)]
    report(case, values)

raise SystemExit(1 if any(s["exit_code"] != 0 or s["timed_out"] for s in samples) else 0)
PY
    then
      :
    else
      FAILED=1
    fi
  fi
fi

