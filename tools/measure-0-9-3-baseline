  # The host's real cache root follows the platform default: ~/.cache on
  # Linux, ~/Library/Caches on macOS.
  runsh 'HOST_CACHE=$(python3 -c "import sys; print(sys.argv[1] if sys.platform != \"darwin\" else sys.argv[2])" "$HOME/.cache/biomcp" "$HOME/Library/Caches/biomcp"); { find "$HOST_CACHE/http" -type f 2>/dev/null || true; } | wc -l; du -sh "$HOST_CACHE" 2>/dev/null || echo "no host cache"'
  show "python3 (five timed runs per case; median, min, max in seconds)"
  if ((!DRY_RUN)); then
    RUN_SCRATCH="$PWD/$LOGD/runtime" python3 - <<'PY'
import os
import statistics
import subprocess
import time

bin_path = os.path.abspath("target/release/biomcp")
scratch = os.environ["RUN_SCRATCH"]
os.makedirs(scratch, exist_ok=True)
commands = {
    "get_gene_BRAF": ["get", "gene", "BRAF"],
    "get_variant_BRAF_V600E": ["get", "variant", "BRAF V600E"],
    "get_drug_imatinib": ["get", "drug", "imatinib"],
    "search_article_BRAF": ["search", "article", "-g", "BRAF", "--limit", "10"],
    "search_all_BRAF_melanoma": ["search", "all", "--gene", "BRAF", "--disease", "melanoma", "--counts-only"],
}

def run_once(argv, cache_dir, mode):
    env = dict(os.environ)
    env["BIOMCP_CACHE_DIR"] = cache_dir
    if mode:
        env["BIOMCP_CACHE_MODE"] = mode
    else:
        env.pop("BIOMCP_CACHE_MODE", None)
    start = time.perf_counter()
    proc = subprocess.run([bin_path, *argv], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=env)
    elapsed = time.perf_counter() - start
    return elapsed, proc.returncode

def measure(label, argv, cache_dir, mode, runs=5):
    values = []
    codes = set()
    for _ in range(runs):
        elapsed, code = run_once(argv, cache_dir, mode)
        values.append(elapsed)
        codes.add(code)
    values_s = " ".join(f"{v:.4f}" if argv == ["--version"] else f"{v:.2f}" for v in values)
    fmt = ".4f" if argv == ["--version"] else ".2f"
    median = statistics.median(values)
    spread = max(values) - min(values)
    print(f"{label}: runs {values_s} median {median:{fmt}}s spread {spread:{fmt}}s exit {sorted(codes)}")
    print(f"RESULT runtime_{label}_median_s = {median:{fmt}}")
    print(f"RESULT runtime_{label}_spread_s = {spread:{fmt}}")

empty = os.path.join(scratch, "empty-cache")
os.makedirs(empty, exist_ok=True)
large = os.path.expanduser("~/.cache/biomcp" if sys.platform != "darwin" else "~/Library/Caches/biomcp")
warm = os.path.join(scratch, "warm-cache")
os.makedirs(warm, exist_ok=True)

print("== biomcp --version start-up, empty cache dir ==")
measure("version_empty_cache", ["--version"], empty, None)
print("== biomcp --version start-up, the host's large cache ==")
measure("version_large_cache", ["--version"], large, None)

print("== prefetch (one network run per command into the warm cache dir) ==")
for name, argv in commands.items():
    elapsed, code = run_once(argv, warm, None)
    print(f"prefetch {name}: {elapsed:.2f}s exit {code}")
    print(f"RESULT runtime_prefetch_{name}_s = {elapsed:.2f}")

print("== output size of each command from the warm cache (one run, bytes) ==")
for name, argv in commands.items():
    env = dict(os.environ)
    env["BIOMCP_CACHE_DIR"] = warm
    env["BIOMCP_CACHE_MODE"] = "infinite"
    proc = subprocess.run([bin_path, *argv], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, env=env)
    print(f"RESULT runtime_output_bytes_{name} = {len(proc.stdout)} exit {proc.returncode}")

print("== warm cache (BIOMCP_CACHE_MODE=infinite), five runs each ==")
for name, argv in commands.items():
    measure(f"warm_{name}", argv, warm, "infinite")

print("== cache off (BIOMCP_CACHE_MODE=off, network), five runs each ==")
for name, argv in commands.items():
    measure(f"nocache_{name}", argv, warm, "off")
PY
  fi
fi

