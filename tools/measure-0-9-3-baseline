  runsh 'df -h . | tail -1'
  runsh 'rustc --version; cargo --version; cargo nextest --version; cargo-deny --version; cargo llvm-cov --version; cargo llvm-lines --version; ruff --version; python3 --version; uv --version; node --version 2>/dev/null || true; mustmatch --version 2>/dev/null || true'
  runsh 'cat ~/.cargo/config.toml 2>/dev/null || echo "no ~/.cargo/config.toml"'
