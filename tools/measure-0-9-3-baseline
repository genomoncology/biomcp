  show "python3 (unique Compiling name/version pairs, including the product; cached crates absent from logs stay uncounted)"
  if ((!DRY_RUN)); then
    python3 - ${TARGET_BUILD_LOGS[@]+"${TARGET_BUILD_LOGS[@]}"} <<'PY'
import re
import sys
from pathlib import Path

logs = dict(entry.split("=", 1) for entry in sys.argv[1:])
targets = {"linux": "x86_64-unknown-linux-gnu",
           "linux_arm64": "aarch64-unknown-linux-gnu",
           "windows": "x86_64-pc-windows-msvc"}
for label, target in targets.items():
    path = logs.get(target)
    key = f"crates_compiled_{label}_release"
    if not path or not Path(path).is_file():
        print(f"RESULT {key} = unavailable (no retained {target} build log)")
        continue
    text = Path(path).read_text(errors="replace")
    # gh preserves Windows color either as ANSI escapes or printable ^[ codes.
    text = re.sub(r"(?:\x1b|\^\[)\[[0-?]*[ -/]*[@-~]", "", text)
    print(f"retained input {target}: {path}")
    pairs = set(re.findall(r"\bCompiling ([\w-]+) v([^\s]+)", text))
    if not re.search(r"Finished [`\"]release['`\"] profile", text):
        print(f"RESULT {key} = unavailable (retained log lacks successful release completion)")
        continue
    print(f"RESULT {key} = {len(pairs)}")
    print(f"METHOD {key}: observed unique Compiling pairs only; cache state and command must be retained with the input; not a resolved graph or total compiler units")
PY
  fi
fi

if want_section python-test-functions; then
  say python-test-functions "AST test function definitions, separate from parametrized collected cases"
  show "python3 (test_ functions and methods of Test classes; file-level tooling references; retained TSV inventory)"
  if ((!DRY_RUN)); then
    python3 - "$LOGD/python-test-functions.tsv" <<'PY'
import ast
import sys
from pathlib import Path

ignored = {"tools/run-offline", "tools/with-build-identity"}
rows = []
for path in sorted(Path("tests").rglob("*.py")):
    if not (path.name.startswith("test_") or path.name.endswith("_test.py")):
        continue
    tree = ast.parse(path.read_text(), filename=str(path))
    definitions = [node for node in tree.body
                   if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))]
    for node in tree.body:
        if isinstance(node, ast.ClassDef) and (node.name.startswith("Test") or any(
            isinstance(base, ast.Name) and base.id == "TestCase" or
            isinstance(base, ast.Attribute) and base.attr == "TestCase"
            for base in node.bases
        )):
            definitions.extend(n for n in node.body
                               if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef)))
    count = sum(node.name.startswith("test_") for node in definitions)
    if not count:
        continue
    references = set()
    for node in ast.walk(tree):
        value = ""
        if isinstance(node, ast.Constant) and isinstance(node.value, str):
            value = node.value
        elif isinstance(node, ast.BinOp) and isinstance(node.op, ast.Div):
            parts = []
            cursor = node
            while isinstance(cursor, ast.BinOp) and isinstance(cursor.op, ast.Div):
                if isinstance(cursor.right, ast.Constant) and isinstance(cursor.right.value, str):
                    parts.insert(0, cursor.right.value)
                cursor = cursor.left
            if isinstance(cursor, ast.Constant) and isinstance(cursor.value, str):
                parts.insert(0, cursor.value)
            value = "/".join(parts)
        if (value.startswith(("tools/", "scripts/", ".github/workflows/")) or value == "Makefile") and "\n" not in value:
            if value not in ignored and not value.startswith(("scripts/fixtures/", "spec/fixtures/")):
                references.add(value)
    rows.append((str(path), "tooling" if references else "other", count, ",".join(sorted(references))))
total = sum(row[2] for row in rows)
tooling = sum(row[2] for row in rows if row[1] == "tooling")
Path(sys.argv[1]).write_text("path\tclassification\tfunctions\treferences\n" + "".join(
    f"{path}\t{kind}\t{count}\t{refs}\n" for path, kind, count, refs in rows))
print(f"RESULT python_test_functions = {total}")
print(f"RESULT python_tooling_test_functions = {tooling}")
print(f"RESULT python_tooling_test_share_pct = {100 * tooling / total:.2f}" if total else
      "RESULT python_tooling_test_share_pct = unavailable (no test functions)")
print("METHOD: file-level convention: tooling path references, excluding generic offline/identity wrappers; mixed files count wholly as tooling. This is a reviewable classification, not semantic proof for every function. AST definitions exclude parametrization expansion and dynamically generated tests.")
PY
  fi
fi

