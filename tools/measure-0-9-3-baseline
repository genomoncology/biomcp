# ---------------------------------------------------------------- coverage

if want_section coverage; then
  say coverage "line coverage of three suites through cargo-llvm-cov (dev build instrumented)"

  # cov_suite_reason[label] names every suite whose run cannot back a
  # coverage number: its exit is nonzero, its summary shows failed tests,
  # or its summary never parsed. A report set fed by any such suite prints
  # incomplete instead of a percentage.
  declare -A cov_suite_reason=()

  # cov_clause prints the count of one "N <clause>" piece of a suite
  # summary (cov_clause <clause> <summary>), or nothing when the piece is
  # absent (nextest omits a zero "failed" clause; pytest omits zero pieces
  # entirely).
  cov_clause() {
    grep -oE "[0-9]+ $1" <<<"$2" | grep -oE '^[0-9]+' || true
  }

  # record_cov_suite prints one RESULT line with a suite's exit status and
  # test counts, and fills cov_suite_reason for a failed or unproven run.
  record_cov_suite() {
    local label="$1" kind="$2" exitfile="$3" logfile="$4"
    local status summary counts reason n_run n_passed n_failed n_errors n_timeout n_skipped pages failed_pages
    status="$(<"$exitfile")"
    counts="summary unparsed"
    n_failed=""
    n_errors=""
    n_timeout=""
    case "$kind" in
      nextest)
        summary="$(grep -E 'Summary \[' "$logfile" | tail -1 || true)"
        if [[ -n "$summary" ]]; then
          # Fail-fast summaries show executed/selected tests. The
          # numerator is the work that actually ran.
          n_run="$(sed -nE 's/.*] +([0-9]+)(\/[0-9]+)? tests? run:.*/\1/p' <<<"$summary")"
          n_passed="$(cov_clause passed "$summary")"
          n_failed="$(cov_clause failed "$summary")"
          n_timeout="$(cov_clause 'timed out' "$summary")"
          n_skipped="$(cov_clause skipped "$summary")"
          if [[ -n "$n_run" ]]; then
            counts="${n_run} run: ${n_passed:-0} passed, ${n_failed:-0} failed, ${n_timeout:-0} timed out, ${n_skipped:-0} skipped"
          fi
        fi
        ;;
      pytest)
        summary="$(grep -E '^=+ .* (passed|failed|error).* =+$' "$logfile" | tail -1 || true)"
        if [[ -n "$summary" ]]; then
          n_passed="$(cov_clause passed "$summary")"
          n_failed="$(cov_clause failed "$summary")"
          n_errors="$(cov_clause errors? "$summary")"
          n_skipped="$(cov_clause skipped "$summary")"
          counts="${n_passed:-0} passed, ${n_failed:-0} failed, ${n_errors:-0} errors, ${n_skipped:-0} skipped"
        fi
        ;;
      spec)
        # Current runners list all selected pages in one header; older
        # runners print one singular header for each page.
        pages="$(awk '
          /^=== spec pages: / {
            sub(/^=== spec pages: /, ""); sub(/ ===$/, "")
            aggregate += NF
          }
          /^=== spec page: / { singular++ }
          END { print aggregate + singular }
        ' "$logfile")"
        failed_pages="$(grep -oE 'spec run failed \([0-9]+\)' "$logfile" | grep -oE '[0-9]+' | tail -1 || true)"
        if [[ -z "$failed_pages" ]]; then
          failed_pages="$(grep -c 'spec page failed: ' "$logfile" || true)"
        fi
        n_failed="$failed_pages"
        if ((pages > 0)); then
          counts="${pages} pages, ${failed_pages:-0} failed"
        fi
        ;;
    esac
    result "coverage_${label}" "exit ${status}; ${counts}"
    reason=""
    if [[ "$counts" == "summary unparsed" ]]; then
      reason="summary unparsed"
    elif [[ -n "$n_failed" && "$n_failed" != "0" ]]; then
      reason="${n_failed} failed"
      if [[ -n "$n_errors" && "$n_errors" != "0" ]]; then
        reason="$reason, ${n_errors} errors"
      fi
    elif [[ -n "$n_errors" && "$n_errors" != "0" ]]; then
      reason="${n_errors} errors"
    elif [[ -n "$n_timeout" && "$n_timeout" != "0" ]]; then
      reason="${n_timeout} timed out"
    elif [[ "$status" != "0" ]]; then
      reason="exit ${status}"
    fi
    if [[ -n "$reason" ]]; then
      cov_suite_reason["$label"]="${label}: ${reason}"
    fi
  }

  COVT="target/llvm-cov-target"
  runsh 'cargo llvm-cov clean --workspace'
  show 'eval each line of "cargo llvm-cov show-env" as an export; CARGO_TARGET_DIR=target/llvm-cov-target; LLVM_PROFILE_FILE per suite'
  if ((!DRY_RUN)); then
    while IFS= read -r line; do
      eval "export $line"
    done < <(cargo llvm-cov show-env 2>/dev/null | grep -E '^[A-Z_]+=')
    export CARGO_INCREMENTAL=0
    export CARGO_TARGET_DIR="$PWD/$COVT"
    mkdir -p "$CARGO_TARGET_DIR"
  fi
  timedsh coverage_build \
    "cargo build --locked --no-default-features --all-targets > $LOGD/cov-build.log 2>&1"
  # absolute path: the suites run subprocesses from many working
  # directories, and a relative profile path silently drops their profiles
  export LLVM_PROFILE_FILE="$CARGO_TARGET_DIR/out-%8m.profraw"
  timedsh_exit coverage_integration_tests "$LOGD/cov-integration.exit" \
    "tools/run-offline -- cargo nextest run --locked --no-default-features -E 'kind(test)' > $LOGD/cov-integration.log 2>&1"
  runsh "grep -E 'Summary \\[|tests? run:' $LOGD/cov-integration.log | tail -1 || true"
  if ((!DRY_RUN)); then
    record_cov_suite integration_tests nextest "$LOGD/cov-integration.exit" "$LOGD/cov-integration.log"
  fi
  timedsh_exit coverage_python_lane "$LOGD/cov-pytest.exit" \
    "tools/run-offline -- env BIOMCP_ROUTINE_TEST_LANE=1 BIOMCP_BIN=\$PWD/$COVT/debug/biomcp TMPDIR=\$PWD/$LOGD/tmp uv run --no-sync pytest tests/ -n 4 --dist loadfile --basetemp $LOGD/pytest-basetemp > $LOGD/cov-pytest.log 2>&1"
  runsh "grep -E '^=+ .* (passed|failed|error).* =+$' $LOGD/cov-pytest.log | tail -2 || true"
  if ((!DRY_RUN)); then
    record_cov_suite python_lane pytest "$LOGD/cov-pytest.exit" "$LOGD/cov-pytest.log"
  fi
  say coverage "spec lane against the instrumented dev binary (hand-written artifacts env)"
  runsh "cat > .cache/spec-artifacts.env <<'ENVEOF'
export BIOMCP_SPEC_ARTIFACT_MODE=spec
export BIOMCP_SPEC_FEATURE_OFF_BIN=$PWD/$COVT/debug/biomcp
export BIOMCP_SPEC_MCP_EXAMPLE_BIN=$PWD/$COVT/debug/examples/rmcp_streamable_http_contract
export BIOMCP_SPEC_CARGO_TREE=$PWD/.cache/spec-artifacts/cargo-tree-no-default-features.txt
export BIOMCP_SPEC_CARGO_METADATA=$PWD/.cache/spec-artifacts/cargo-metadata.json
export BIOMCP_BIN=$PWD/$COVT/debug/biomcp
ENVEOF
cat .cache/spec-artifacts.env"
  timedsh_exit coverage_spec_lane "$LOGD/cov-spec.exit" \
    "PATH=\"$PWD/$COVT/debug:\$PATH\" BIOMCP_SPEC_ARTIFACTS_PREPARED=1 ROUTINE_CARGO_FEATURES=--no-default-features SPEC_PROFILE=dev tools/run-offline -- bash scripts/run-specs.sh spec > $LOGD/cov-spec.log 2>&1"
  runsh "tail -4 $LOGD/cov-spec.log || true"
  if ((!DRY_RUN)); then
    record_cov_suite spec_lane spec "$LOGD/cov-spec.exit" "$LOGD/cov-spec.log"
  fi
  export LLVM_PROFILE_FILE="$CARGO_TARGET_DIR/unit-%8m.profraw"
  timedsh_exit coverage_unit_tests "$LOGD/cov-unit.exit" \
    "tools/run-offline -- cargo nextest run --locked --no-default-features -E 'kind(lib) | kind(bin)' > $LOGD/cov-unit.log 2>&1"
  runsh "grep -E 'Summary \\[|tests? run:' $LOGD/cov-unit.log | tail -1 || true"
  if ((!DRY_RUN)); then
    record_cov_suite unit_tests nextest "$LOGD/cov-unit.exit" "$LOGD/cov-unit.log"
  fi
  # Reports: report merges every profraw under target/llvm-cov-target, so
  # the set not being reported moves aside first. Test code leaves the
  # report by path; inline #[cfg(test)] modules stay in, so these are the
  # llvm-cov view, not the span-reduced view of the iteration-speed study.
  # Field 10 of the TOTAL row is the Lines cover percentage.
  COV_REGEX='(^|/)(tests?|examples?|benches)/|(^|/)(tests?\.rs|_tests?\.rs|tests?_[^/]*\.rs)$|test_support|(^|/)generated/'
  echo "denominator, one rule for all three reports: product code only — removed by --ignore-filename-regex: files under a tests/, test/, examples/, example/, benches/ or bench/ directory; files named tests.rs, test.rs, _tests.rs, _test.rs, tests_*.rs or test_*.rs; any path containing test_support; files under a generated/ directory — inline #[cfg(test)] modules stay counted"
  COV_HOLD="$LOGD/cov-hold"
  mkdir -p "$COV_HOLD"
  for report_set in outside-in unit combined; do
    say coverage "report: $report_set"
    case "$report_set" in
      outside-in) aside="unit"; feeds="integration_tests python_lane spec_lane" ;;
      unit) aside="out"; feeds="unit_tests" ;;
      combined) aside=""; feeds="integration_tests python_lane spec_lane unit_tests" ;;
    esac
    if ((!DRY_RUN)); then
      if [[ -n "$aside" ]]; then
        show "mv $COVT/$aside-*.profraw $COV_HOLD/ (report the other set)"
        mv "$COVT"/$aside-*.profraw "$COV_HOLD"/ 2>/dev/null || true
      else
        show "mv $COV_HOLD/*.profraw $COVT/ (report everything)"
        mv "$COV_HOLD"/*.profraw "$COVT"/ 2>/dev/null || true
      fi
    fi
    # report discovers profraws and objects under target/llvm-cov-target on
    # its own, but only while no show-env export pins its search: the eval'd
    # CARGO_LLVM_COV_TARGET_DIR (printed before CARGO_TARGET_DIR was set, so
    # it names the plain target directory, which holds no profraws at its
    # top level) pins it, so all four are unset for the report only.
    runsh "env -u CARGO_TARGET_DIR -u CARGO_LLVM_COV -u CARGO_LLVM_COV_SHOW_ENV -u CARGO_LLVM_COV_TARGET_DIR cargo llvm-cov report --ignore-filename-regex '$COV_REGEX' > $LOGD/cov-report-${report_set//-/_}.txt 2>&1; tail -4 $LOGD/cov-report-${report_set//-/_}.txt"
    if ((!DRY_RUN)); then
      incomplete=""
      for feed in $feeds; do
        if [[ -n "${cov_suite_reason[$feed]:-}" ]]; then
          incomplete="${incomplete:+$incomplete, }${cov_suite_reason[$feed]}"
        fi
      done
      if [[ -n "$incomplete" ]]; then
        # a set fed by a failed or unproven suite never prints a number
        result "coverage_${report_set//-/_}_lines_pct" "incomplete ($incomplete)"
      else
        pct=$(awk '/^TOTAL/ {print $10}' "$LOGD/cov-report-${report_set//-/_}.txt" | tr -d '%')
        result "coverage_${report_set//-/_}_lines_pct" "${pct:-parse-failed}"
      fi
      if [[ -n "$aside" ]]; then
        show "mv $COV_HOLD/*.profraw $COVT/ (restore)"
        mv "$COV_HOLD"/*.profraw "$COVT"/ 2>/dev/null || true
      fi
    fi
  done
fi

