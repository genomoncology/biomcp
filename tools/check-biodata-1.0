#!/usr/bin/env python3
"""Run the reviewed BioData migration tests inside BioData's isolation."""

from __future__ import annotations

import os
from pathlib import Path
import subprocess
import sys

from biodata_focused_selection import (
    SelectionError,
    load_selection,
    nextest_filter,
    nextest_names,
    validate_rust_discovery,
)


ROOT = Path(__file__).resolve().parents[1]
MANIFEST = ROOT / "tools/biodata-1.0-focused.toml"


def _worktree_binary() -> Path:
    binary = Path(os.environ.get("BIOMCP_BIN", ROOT / "target/debug/biomcp"))
    if not binary.is_absolute():
        binary = Path.cwd() / binary
    binary = binary.resolve()
    try:
        binary.relative_to(ROOT)
    except ValueError as error:
        raise SelectionError(
            "focused BioData verification requires a worktree-local BioMCP binary"
        ) from error
    if not binary.is_file() or not os.access(binary, os.X_OK):
        raise SelectionError(
            f"focused BioData verification requires an already-built BioMCP binary: {binary}"
        )
    return binary


def _run(arguments: list[str], environment: dict[str, str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        arguments,
        cwd=ROOT,
        env=environment,
        check=True,
        text=True,
        capture_output=arguments[:3] == ["cargo", "nextest", "list"],
    )


def execute(environment: dict[str, str]) -> None:
    selection = load_selection(MANIFEST)
    binary = _worktree_binary()
    clean_environment = environment.copy()
    clean_environment.pop("NCI_API_KEY", None)
    _run([str(ROOT / "tools/check-offline-network"), "true"], clean_environment)
    _run(
        ["python3", str(ROOT / "tools/check-biodata-boundary.py"), "--root", str(ROOT)],
        clean_environment,
    )
    _run(
        [
            "python3",
            str(ROOT / "tools/check-source-capture-receipts.py"),
            "--root",
            str(ROOT / "testdata/sources"),
        ],
        clean_environment,
    )
    discovery = _run(
        [
            "cargo",
            "nextest",
            "list",
            "--locked",
            "--offline",
            "--no-default-features",
            "--lib",
            "--message-format",
            "json",
        ],
        clean_environment,
    )
    validate_rust_discovery(selection, nextest_names(discovery.stdout))
    _run(
        [
            "cargo",
            "nextest",
            "run",
            "--locked",
            "--offline",
            "--no-default-features",
            "--lib",
            "--filterset",
            nextest_filter(selection),
        ],
        clean_environment,
    )
    pytest_environment = clean_environment | {
        "BIOMCP_BIN": str(binary),
        "BIOMCP_FOCUSED_MANIFEST": str(MANIFEST),
        "PYTHONPATH": os.pathsep.join(
            filter(None, (str(ROOT / "tools"), clean_environment.get("PYTHONPATH")))
        ),
    }
    _run(
        [
            "uv",
            "run",
            "--no-sync",
            "pytest",
            "--basetemp",
            "/tmp/pytest",
            "-p",
            "biodata_focused_pytest",
            *selection.python,
        ],
        pytest_environment,
    )


def main() -> int:
    if sys.argv[1:] != ["--already-isolated"] or os.environ.get("BIOMCP_OFFLINE_NETWORK") != "1":
        print(
            "usage: run this checker through BioData's isolation launcher with --already-isolated",
            file=sys.stderr,
        )
        return 2
    try:
        execute(os.environ.copy())
    except (OSError, SelectionError, subprocess.CalledProcessError) as error:
        print(f"focused BioData verification failed: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
