{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BioMCP Trial",
  "type": "object",
  "required": ["nct_id", "title", "interventions"],
  "$defs": {
    "extensibleCode": {
      "type": "object",
      "required": ["authority", "code", "display", "vocabulary_version", "recognized_meaning"],
      "properties": {
        "authority": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "display": { "type": ["string", "null"], "minLength": 1 },
        "vocabulary_version": { "type": ["string", "null"], "minLength": 1 },
        "recognized_meaning": { "type": ["string", "null"], "minLength": 1 }
      },
      "additionalProperties": false
    },
    "intervention": {
      "type": "object",
      "required": ["id", "name", "type", "description", "other_names"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": { "oneOf": [{ "$ref": "#/$defs/extensibleCode" }, { "type": "null" }] },
        "description": { "type": ["string", "null"] },
        "other_names": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "arm": {
      "type": "object",
      "required": ["id", "name", "type", "description"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": { "oneOf": [{ "$ref": "#/$defs/extensibleCode" }, { "type": "null" }] },
        "description": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "assignment": {
      "type": "object",
      "required": ["arm_id", "intervention_id"],
      "properties": {
        "arm_id": { "type": "integer", "minimum": 1 },
        "intervention_id": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "nct_id": { "type": "string" },
    "source": { "type": ["string", "null"] },
    "title": { "type": "string" },
    "status": { "type": ["string", "null"] },
    "phase": { "type": ["string", "null"] },
    "study_type": { "type": ["string", "null"] },
    "age_range": { "type": ["string", "null"] },
    "conditions": {
      "type": ["array", "null"],
      "items": { "type": "string" }
    },
    "interventions": {
      "type": "array",
      "items": { "$ref": "#/$defs/intervention" }
    },
    "arms": {
      "type": "array",
      "items": { "$ref": "#/$defs/arm" }
    },
    "arm_intervention_assignments": {
      "type": "array",
      "items": { "$ref": "#/$defs/assignment" }
    },
    "sponsor": { "type": ["string", "null"] },
    "enrollment": { "type": ["integer", "number", "null"] },
    "summary": { "type": ["string", "null"] },
    "start_date": { "type": ["string", "null"] },
    "completion_date": { "type": ["string", "null"] },
    "eligibility_text": { "type": ["string", "null"] },
    "_meta": {
      "type": ["object", "null"],
      "properties": {
        "evidence_urls": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "url": { "type": "string" }
            },
            "required": ["label", "url"],
            "additionalProperties": true
          }
        },
        "next_commands": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        },
        "workflow": { "type": ["string", "null"] },
        "workflow_rationale": { "type": ["string", "null"] },
        "workflow_playbook": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  },
  "dependentRequired": {
    "arms": ["arm_intervention_assignments"],
    "arm_intervention_assignments": ["arms"]
  },
  "additionalProperties": true
}
